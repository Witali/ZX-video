                 	
                 	; Standalone AY50 player: all R0..R10 records are loaded before playback.
                 	; Python supplies constants, screen pixels and register data, never opcodes.
                 	; Bank 5: display/BASIC/TR-DOS. Bank 2: code, screen image, stack and IM2.
                 	; Six other banks: whole 11-byte records. Interrupts preserve all registers.
                 	
8000              	total_ticks: EQU 1556
8000              	loop_playback: EQU 1
8000              	disk_0: EQU 780
8000              	sectors_0: EQU 64
8000              	disk_1: EQU 1804
8000              	sectors_1: EQU 3
8000              	disk_2: EQU 0
8000              	sectors_2: EQU 0
8000              	disk_3: EQU 0
8000              	sectors_3: EQU 0
8000              	disk_4: EQU 0
8000              	sectors_4: EQU 0
8000              	disk_5: EQU 0
8000              	sectors_5: EQU 0
8000              	        INCLUDE "config.inc"
8000              	        ORG 0x8000
8000              	LOAD_BANK: MACRO
8000              	        IF \2 > 0
8000              	        LD A,16+\0
8000              	        LD BC,0x7FFD
8000              	        OUT (C),A
8000              	        LD DE,\1
8000              	        LD (disk_position),DE
8000              	        LD HL,0xC000
8000              	        LD B,\2
8000              	        CALL read_n
8000              	        ENDIF
8000              	        ENDM
8000 F3           	start:  DI
8001 31 00 B8     	        LD SP,0xB800
8004 FD 21 3A 5C  	        LD IY,0x5C3A
8008 ED 56        	        IM 1
800A AF           	        XOR A
800B D3 FE        	        OUT (0xFE),A
800D 21 00 90     	        LD HL,screen_data
8010 11 00 40     	        LD DE,0x4000
8013 01 00 1B     	        LD BC,6912
8016 ED B0        	        LDIR
8018 FB           	        EI
8019              		IF sectors_0 > 0
8019 3E 10        		LD A,16+0
801B 01 FD 7F     		LD BC,0x7FFD
801E ED 79        		OUT (C),A
8020 11 0C 03     		LD DE,disk_0
8023 ED 53 24 81  		LD (disk_position),DE
8027 21 00 C0     		LD HL,0xC000
802A 06 40        		LD B,sectors_0
802C CD 00 81     		CALL read_n
802F              		ENDIF
802F              	        LOAD_BANK 0,disk_0,sectors_0
802F              		IF sectors_1 > 0
802F 3E 14        		LD A,16+4
8031 01 FD 7F     		LD BC,0x7FFD
8034 ED 79        		OUT (C),A
8036 11 0C 07     		LD DE,disk_1
8039 ED 53 24 81  		LD (disk_position),DE
803D 21 00 C0     		LD HL,0xC000
8040 06 03        		LD B,sectors_1
8042 CD 00 81     		CALL read_n
8045              		ENDIF
8045              	        LOAD_BANK 4,disk_1,sectors_1
8045              		IF sectors_2 > 0
8045              		LD A,16+6
8045              		LD BC,0x7FFD
8045              		OUT (C),A
8045              		LD DE,disk_2
8045              		LD (disk_position),DE
8045              		LD HL,0xC000
8045              		LD B,sectors_2
8045              		CALL read_n
8045              		ENDIF
8045              	        LOAD_BANK 6,disk_2,sectors_2
8045              		IF sectors_3 > 0
8045              		LD A,16+1
8045              		LD BC,0x7FFD
8045              		OUT (C),A
8045              		LD DE,disk_3
8045              		LD (disk_position),DE
8045              		LD HL,0xC000
8045              		LD B,sectors_3
8045              		CALL read_n
8045              		ENDIF
8045              	        LOAD_BANK 1,disk_3,sectors_3
8045              		IF sectors_4 > 0
8045              		LD A,16+3
8045              		LD BC,0x7FFD
8045              		OUT (C),A
8045              		LD DE,disk_4
8045              		LD (disk_position),DE
8045              		LD HL,0xC000
8045              		LD B,sectors_4
8045              		CALL read_n
8045              		ENDIF
8045              	        LOAD_BANK 3,disk_4,sectors_4
8045              		IF sectors_5 > 0
8045              		LD A,16+7
8045              		LD BC,0x7FFD
8045              		OUT (C),A
8045              		LD DE,disk_5
8045              		LD (disk_position),DE
8045              		LD HL,0xC000
8045              		LD B,sectors_5
8045              		CALL read_n
8045              		ENDIF
8045              	        LOAD_BANK 7,disk_5,sectors_5
8045 F3           	        DI
                 	        ; Erase the first three character rows containing the loading message.
                 	        ; Spectrum bitmap scanlines are interleaved in eight 256-byte planes.
                 	        ; This runs once after loading and costs nothing during playback.
8046 21 00 40     	        LD HL,0x4000
8049 06 08        	        LD B,8
                 	clear_loading:
804B C5           	        PUSH BC
804C E5           	        PUSH HL
804D 54           	        LD D,H
804E 5D           	        LD E,L
804F 13           	        INC DE
8050 01 5F 00     	        LD BC,95
8053 36 00        	        LD (HL),0
8055 ED B0        	        LDIR
8057 E1           	        POP HL
8058 24           	        INC H
8059 C1           	        POP BC
805A 10 EF        	        DJNZ clear_loading
                 	        ; Clear the chip, including its envelope, after loading from disk.
805C 16 00        	        LD D,0
805E 1E 00        	        LD E,0
8060 0E FD        	        LD C,0xFD
                 	clear_ay:
8062 06 FF        	        LD B,0xFF
8064 ED 51        	        OUT (C),D
8066 06 BF        	        LD B,0xBF
8068 ED 59        	        OUT (C),E
806A 14           	        INC D
806B 7A           	        LD A,D
806C FE 0E        	        CP 14
806E 20 F2        	        JR NZ,clear_ay
8070 21 00 BE     	        LD HL,0xBE00
8073 11 01 BE     	        LD DE,0xBE01
8076 01 00 01     	        LD BC,256
8079 36 BD        	        LD (HL),0xBD
807B ED B0        	        LDIR
807D 3E C3        	        LD A,0xC3
807F 32 BD BD     	        LD (0xBDBD),A
8082 21 FD 80     	        LD HL,irq
8085 22 BE BD     	        LD (0xBDBE),HL
8088 3E BE        	        LD A,0xBE
808A ED 47        	        LD I,A
808C ED 5E        	        IM 2
808E 3E 10        	        LD A,16
8090 01 FD 7F     	        LD BC,0x7FFD
8093 ED 79        	        OUT (C),A
8095 21 00 C0     	        LD HL,0xC000
8098 FB           	ready:  EI
                 	wait_field:
8099 76           	        HALT
                 	field_start:
                 	        ; 38 T. Each tick remains tied to its original interrupt field.
809A ED 5B 22 81  	        LD DE,(remaining)
809E 7A           	        LD A,D
809F B3           	        OR E
80A0 CA E0 80     	        JP Z,finished
                 	tick_start:
80A3 16 00        	        LD D,0
80A5 0E FD        	        LD C,0xFD
                 	write_register:
                 	        ; 78 T continuing, 73 T final; setup + eleven writes = 867 T.
80A7 5E           	        LD E,(HL)
80A8 23           	        INC HL
80A9 06 FF        	        LD B,0xFF
80AB ED 51        	        OUT (C),D
80AD 06 BF        	        LD B,0xBF
80AF ED 59        	ay_out: OUT (C),E
80B1 14           	        INC D
80B2 7A           	        LD A,D
80B3 FE 0B        	        CP 11
80B5 20 F0        	        JR NZ,write_register
                 	tick_end:
80B7 ED 5B 22 81  	        LD DE,(remaining)
80BB 1B           	        DEC DE
80BC ED 53 22 81  	        LD (remaining),DE
80C0 7C           	        LD A,H
80C1 FE FF        	        CP 0xFF
80C3 20 D4        	        JR NZ,wait_field
80C5 7D           	        LD A,L
80C6 FE FB        	        CP 0xFB
80C8 20 CF        	        JR NZ,wait_field
                 	        ; Never read past the bank table on an exact-boundary EOF.
80CA 7A           	        LD A,D
80CB B3           	        OR E
80CC 28 CB        	        JR Z,wait_field
80CE 2A 26 81     	        LD HL,(bank_pointer)
80D1 23           	        INC HL
80D2 22 26 81     	        LD (bank_pointer),HL
80D5 7E           	        LD A,(HL)
80D6 01 FD 7F     	        LD BC,0x7FFD
80D9 ED 79        	        OUT (C),A
80DB 21 00 C0     	        LD HL,0xC000
80DE 18 B9        	        JR wait_field
                 	finished:
80E0              	        IF loop_playback
                 	        ; 105 T beyond the normal field check, once per repeat.
                 	        ; Reset then publish tick zero in THIS field: no empty extra field.
80E0 11 14 06     	        LD DE,total_ticks
80E3 ED 53 22 81  	        LD (remaining),DE
80E7 21 28 81     	        LD HL,bank_table
80EA 22 26 81     	        LD (bank_pointer),HL
80ED 3E 10        	        LD A,16
80EF 01 FD 7F     	        LD BC,0x7FFD
80F2 ED 79        	        OUT (C),A
80F4 21 00 C0     	        LD HL,0xC000
80F7 C3 A3 80     	        JP tick_start
80FA              	        ELSE
80FA              	        LD E,0
80FA              	        LD C,0xFD
80FA              	        LD D,8
80FA              	        LD B,0xFF
80FA              	        OUT (C),D
80FA              	        LD B,0xBF
80FA              	        OUT (C),E
80FA              	        LD D,9
80FA              	        LD B,0xFF
80FA              	        OUT (C),D
80FA              	        LD B,0xBF
80FA              	        OUT (C),E
80FA              	        LD D,10
80FA              	        LD B,0xFF
80FA              	        OUT (C),D
80FA              	        LD B,0xBF
80FA              	        OUT (C),E
80FA              	        ENDIF
                 	finished_wait:
80FA 76           	        HALT
80FB 18 FD        	        JR finished_wait
80FD FB           	irq:    EI
80FE ED 4D        	        RETI
8100 C5           	read_n: PUSH BC
8101 E5           	        PUSH HL
8102 ED 5B 24 81  	        LD DE,(disk_position)
8106 01 05 01     	        LD BC,0x0105
                 	disk_call:
8109 CD 13 3D     	        CALL 0x3D13
810C E1           	        POP HL
810D C1           	        POP BC
810E 24           	        INC H
810F ED 5B 24 81  	        LD DE,(disk_position)
8113 1C           	        INC E
8114 CB 63        	        BIT 4,E
8116 28 03        	        JR Z,sector_ok
8118 1E 00        	        LD E,0
811A 14           	        INC D
                 	sector_ok:
811B ED 53 24 81  	        LD (disk_position),DE
811F 10 DF        	        DJNZ read_n
8121 C9           	        RET
8122 14 06        	remaining: DEFW total_ticks
8124 00 00        	disk_position: DEFW 0
8126 28 81        	bank_pointer: DEFW bank_table
8128 17           	bank_table: DEFB 16,20,22,17,19,23
                 	code_end:
812E              	        ASSERT $ <= 0x9000
812E              	        DS 0x9000-$
                 	screen_data:
