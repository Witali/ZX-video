                 	
                 	; Standalone AY50 player: all R0..R10 records are loaded before playback.
                 	; Python supplies constants, screen pixels and register data, never opcodes.
                 	; Bank 5: display/BASIC/TR-DOS. Bank 2: code, screen image, stack and IM2.
                 	; Six other banks: whole 11- or 14-byte records. IRQ preserves all registers.
                 	; Extended records carry R11/R12 and an R13 action: FF means omit the write.
                 	; Never rewrite a held shape every field: R13 writes restart envelope phase.
                 	
8000              	total_ticks: EQU 1500
8000              	loop_playback: EQU 0
8000              	record_bytes: EQU 14
8000              	bank_end_low: EQU 252
8000              	disk_0: EQU 780
8000              	sectors_0: EQU 64
8000              	disk_1: EQU 1804
8000              	sectors_1: EQU 19
8000              	disk_2: EQU 0
8000              	sectors_2: EQU 0
8000              	disk_3: EQU 0
8000              	sectors_3: EQU 0
8000              	disk_4: EQU 0
8000              	sectors_4: EQU 0
8000              	disk_5: EQU 0
8000              	sectors_5: EQU 0
8000              	        INCLUDE "config.inc"
8000              	        ORG 0x8000
8000              	LOAD_BANK: MACRO
8000              	        IF \2 > 0
8000              	        LD A,16+\0
8000              	        LD BC,0x7FFD
8000              	        OUT (C),A
8000              	        LD DE,\1
8000              	        LD (disk_position),DE
8000              	        LD HL,0xC000
8000              	        LD B,\2
8000              	        CALL read_n
8000              	        ENDIF
8000              	        ENDM
8000 F3           	start:  DI
8001 31 00 B8     	        LD SP,0xB800
8004 FD 21 3A 5C  	        LD IY,0x5C3A
8008 ED 56        	        IM 1
800A AF           	        XOR A
800B D3 FE        	        OUT (0xFE),A
800D 21 00 90     	        LD HL,screen_data
8010 11 00 40     	        LD DE,0x4000
8013 01 00 1B     	        LD BC,6912
8016 ED B0        	        LDIR
8018 FB           	        EI
8019              		IF sectors_0 > 0
8019 3E 10        		LD A,16+0
801B 01 FD 7F     		LD BC,0x7FFD
801E ED 79        		OUT (C),A
8020 11 0C 03     		LD DE,disk_0
8023 ED 53 3D 81  		LD (disk_position),DE
8027 21 00 C0     		LD HL,0xC000
802A 06 40        		LD B,sectors_0
802C CD 19 81     		CALL read_n
802F              		ENDIF
802F              	        LOAD_BANK 0,disk_0,sectors_0
802F              		IF sectors_1 > 0
802F 3E 14        		LD A,16+4
8031 01 FD 7F     		LD BC,0x7FFD
8034 ED 79        		OUT (C),A
8036 11 0C 07     		LD DE,disk_1
8039 ED 53 3D 81  		LD (disk_position),DE
803D 21 00 C0     		LD HL,0xC000
8040 06 13        		LD B,sectors_1
8042 CD 19 81     		CALL read_n
8045              		ENDIF
8045              	        LOAD_BANK 4,disk_1,sectors_1
8045              		IF sectors_2 > 0
8045              		LD A,16+6
8045              		LD BC,0x7FFD
8045              		OUT (C),A
8045              		LD DE,disk_2
8045              		LD (disk_position),DE
8045              		LD HL,0xC000
8045              		LD B,sectors_2
8045              		CALL read_n
8045              		ENDIF
8045              	        LOAD_BANK 6,disk_2,sectors_2
8045              		IF sectors_3 > 0
8045              		LD A,16+1
8045              		LD BC,0x7FFD
8045              		OUT (C),A
8045              		LD DE,disk_3
8045              		LD (disk_position),DE
8045              		LD HL,0xC000
8045              		LD B,sectors_3
8045              		CALL read_n
8045              		ENDIF
8045              	        LOAD_BANK 1,disk_3,sectors_3
8045              		IF sectors_4 > 0
8045              		LD A,16+3
8045              		LD BC,0x7FFD
8045              		OUT (C),A
8045              		LD DE,disk_4
8045              		LD (disk_position),DE
8045              		LD HL,0xC000
8045              		LD B,sectors_4
8045              		CALL read_n
8045              		ENDIF
8045              	        LOAD_BANK 3,disk_4,sectors_4
8045              		IF sectors_5 > 0
8045              		LD A,16+7
8045              		LD BC,0x7FFD
8045              		OUT (C),A
8045              		LD DE,disk_5
8045              		LD (disk_position),DE
8045              		LD HL,0xC000
8045              		LD B,sectors_5
8045              		CALL read_n
8045              		ENDIF
8045              	        LOAD_BANK 7,disk_5,sectors_5
8045 F3           	        DI
                 	        ; Erase the first three character rows containing the loading message.
                 	        ; Spectrum bitmap scanlines are interleaved in eight 256-byte planes.
                 	        ; This runs once after loading and costs nothing during playback.
8046 21 00 40     	        LD HL,0x4000
8049 06 08        	        LD B,8
                 	clear_loading:
804B C5           	        PUSH BC
804C E5           	        PUSH HL
804D 54           	        LD D,H
804E 5D           	        LD E,L
804F 13           	        INC DE
8050 01 5F 00     	        LD BC,95
8053 36 00        	        LD (HL),0
8055 ED B0        	        LDIR
8057 E1           	        POP HL
8058 24           	        INC H
8059 C1           	        POP BC
805A 10 EF        	        DJNZ clear_loading
                 	        ; Clear the chip, including its envelope, after loading from disk.
805C 16 00        	        LD D,0
805E 1E 00        	        LD E,0
8060 0E FD        	        LD C,0xFD
                 	clear_ay:
8062 06 FF        	        LD B,0xFF
8064 ED 51        	        OUT (C),D
8066 06 BF        	        LD B,0xBF
8068 ED 59        	        OUT (C),E
806A 14           	        INC D
806B 7A           	        LD A,D
806C FE 0E        	        CP 14
806E 20 F2        	        JR NZ,clear_ay
8070 21 00 BE     	        LD HL,0xBE00
8073 11 01 BE     	        LD DE,0xBE01
8076 01 00 01     	        LD BC,256
8079 36 BD        	        LD (HL),0xBD
807B ED B0        	        LDIR
807D 3E C3        	        LD A,0xC3
807F 32 BD BD     	        LD (0xBDBD),A
8082 21 16 81     	        LD HL,irq
8085 22 BE BD     	        LD (0xBDBE),HL
8088 3E BE        	        LD A,0xBE
808A ED 47        	        LD I,A
808C ED 5E        	        IM 2
808E 3E 10        	        LD A,16
8090 01 FD 7F     	        LD BC,0x7FFD
8093 ED 79        	        OUT (C),A
8095 21 00 C0     	        LD HL,0xC000
8098 FB           	ready:  EI
                 	wait_field:
8099 76           	        HALT
                 	field_start:
                 	        ; 38 T. Each tick remains tied to its original interrupt field.
809A ED 5B 3B 81  	        LD DE,(remaining)
809E 7A           	        LD A,D
809F B3           	        OR E
80A0 CA F1 80     	        JP Z,finished
                 	tick_start:
80A3 16 00        	        LD D,0
80A5 0E FD        	        LD C,0xFD
                 	write_register:
                 	        ; 78 T continuing, 73 T final; setup + eleven writes = 867 T.
80A7 5E           	        LD E,(HL)
80A8 23           	        INC HL
80A9 06 FF        	        LD B,0xFF
80AB ED 51        	        OUT (C),D
80AD 06 BF        	        LD B,0xBF
80AF ED 59        	ay_out: OUT (C),E
80B1 14           	        INC D
80B2 7A           	        LD A,D
80B3              	        IF record_bytes == 14
80B3 FE 0D        	        CP 13
80B5              	        ELSE
80B5              	        CP 11
80B5              	        ENDIF
80B5 20 F0        	        JR NZ,write_register
80B7              	        IF record_bytes == 14
                 	        ; Thirteen ordinary writes cost 1023 T. The R13 action consumes one
                 	        ; byte even when skipped. Tail is 36 T without restart, 76 T with it:
                 	        ; total tick work 1059/1099 T vs 867 T, delta +192/+232 T.
                 	        ; Input HL=R13 action, D=13, C=FD. Clobbers A/B/E and advances HL.
80B7 5E           	        LD E,(HL)
80B8 23           	        INC HL
80B9 7B           	        LD A,E
80BA FE FF        	        CP 255
80BC 28 0A        	        JR Z,tick_end
80BE 16 0D        	        LD D,13
80C0 06 FF        	        LD B,0xFF
80C2 ED 51        	        OUT (C),D
80C4 06 BF        	        LD B,0xBF
                 	ay_env_out:
80C6 ED 59        	        OUT (C),E
80C8              	        ENDIF
                 	tick_end:
80C8 ED 5B 3B 81  	        LD DE,(remaining)
80CC 1B           	        DEC DE
80CD ED 53 3B 81  	        LD (remaining),DE
80D1 7C           	        LD A,H
80D2 FE FF        	        CP 0xFF
80D4 20 C3        	        JR NZ,wait_field
80D6 7D           	        LD A,L
80D7 FE FC        	        CP bank_end_low
80D9 20 BE        	        JR NZ,wait_field
                 	        ; Never read past the bank table on an exact-boundary EOF.
80DB 7A           	        LD A,D
80DC B3           	        OR E
80DD 28 BA        	        JR Z,wait_field
80DF 2A 3F 81     	        LD HL,(bank_pointer)
80E2 23           	        INC HL
80E3 22 3F 81     	        LD (bank_pointer),HL
80E6 7E           	        LD A,(HL)
80E7 01 FD 7F     	        LD BC,0x7FFD
80EA ED 79        	        OUT (C),A
80EC 21 00 C0     	        LD HL,0xC000
80EF 18 A8        	        JR wait_field
                 	finished:
80F1              	        IF loop_playback
                 	        ; 105 T beyond the normal field check, once per repeat.
                 	        ; Reset then publish tick zero in THIS field: no empty extra field.
80F1              	        LD DE,total_ticks
80F1              	        LD (remaining),DE
80F1              	        LD HL,bank_table
80F1              	        LD (bank_pointer),HL
80F1              	        LD A,16
80F1              	        LD BC,0x7FFD
80F1              	        OUT (C),A
80F1              	        LD HL,0xC000
80F1              	        JP tick_start
80F1              	        ELSE
80F1 1E 00        	        LD E,0
80F3 0E FD        	        LD C,0xFD
80F5 16 08        	        LD D,8
80F7 06 FF        	        LD B,0xFF
80F9 ED 51        	        OUT (C),D
80FB 06 BF        	        LD B,0xBF
80FD ED 59        	        OUT (C),E
80FF 16 09        	        LD D,9
8101 06 FF        	        LD B,0xFF
8103 ED 51        	        OUT (C),D
8105 06 BF        	        LD B,0xBF
8107 ED 59        	        OUT (C),E
8109 16 0A        	        LD D,10
810B 06 FF        	        LD B,0xFF
810D ED 51        	        OUT (C),D
810F 06 BF        	        LD B,0xBF
8111 ED 59        	        OUT (C),E
8113              	        ENDIF
                 	finished_wait:
8113 76           	        HALT
8114 18 FD        	        JR finished_wait
8116 FB           	irq:    EI
8117 ED 4D        	        RETI
8119 C5           	read_n: PUSH BC
811A E5           	        PUSH HL
811B ED 5B 3D 81  	        LD DE,(disk_position)
811F 01 05 01     	        LD BC,0x0105
                 	disk_call:
8122 CD 13 3D     	        CALL 0x3D13
8125 E1           	        POP HL
8126 C1           	        POP BC
8127 24           	        INC H
8128 ED 5B 3D 81  	        LD DE,(disk_position)
812C 1C           	        INC E
812D CB 63        	        BIT 4,E
812F 28 03        	        JR Z,sector_ok
8131 1E 00        	        LD E,0
8133 14           	        INC D
                 	sector_ok:
8134 ED 53 3D 81  	        LD (disk_position),DE
8138 10 DF        	        DJNZ read_n
813A C9           	        RET
813B DC 05        	remaining: DEFW total_ticks
813D 00 00        	disk_position: DEFW 0
813F 41 81        	bank_pointer: DEFW bank_table
8141 17           	bank_table: DEFB 16,20,22,17,19,23
                 	code_end:
8147              	        ASSERT $ <= 0x9000
8147              	        DS 0x9000-$
                 	screen_data:
9000 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 04 08 11 32 09 24 90 E0 4C 82 41 24 08 20 89 82 09 80 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 03 10 43 06 41 1E 21 E0 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 08 22 02 22 3E 1E 21 E0 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 04 08 11 F2 09 26 90 20 7C 82 41 24 08 20 8F 82 0F 80 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 02 88 83 06 41 23 22 10 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 04 08 12 12 09 22 98 20 84 82 41 24 08 20 90 82 10 80 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 02 8C 83 8E 41 21 24 18 00 00 00 00 00 