                 	
                 	; Standalone AY50 player: all R0..R10 records are loaded before playback.
                 	; Python supplies constants, screen pixels and register data, never opcodes.
                 	; Bank 5: display/BASIC/TR-DOS. Bank 2: code, screen image, stack and IM2.
                 	; Six other banks: whole 11-byte records. Interrupts preserve all registers.
                 	
8000              	total_ticks: EQU 1200
8000              	loop_playback: EQU 1
8000              	disk_0: EQU 780
8000              	sectors_0: EQU 52
8000              	disk_1: EQU 0
8000              	sectors_1: EQU 0
8000              	disk_2: EQU 0
8000              	sectors_2: EQU 0
8000              	disk_3: EQU 0
8000              	sectors_3: EQU 0
8000              	disk_4: EQU 0
8000              	sectors_4: EQU 0
8000              	disk_5: EQU 0
8000              	sectors_5: EQU 0
8000              	        INCLUDE "config.inc"
8000              	        ORG 0x8000
8000              	LOAD_BANK: MACRO
8000              	        IF \2 > 0
8000              	        LD A,16+\0
8000              	        LD BC,0x7FFD
8000              	        OUT (C),A
8000              	        LD DE,\1
8000              	        LD (disk_position),DE
8000              	        LD HL,0xC000
8000              	        LD B,\2
8000              	        CALL read_n
8000              	        ENDIF
8000              	        ENDM
8000 F3           	start:  DI
8001 31 00 B8     	        LD SP,0xB800
8004 FD 21 3A 5C  	        LD IY,0x5C3A
8008 ED 56        	        IM 1
800A AF           	        XOR A
800B D3 FE        	        OUT (0xFE),A
800D 21 00 90     	        LD HL,screen_data
8010 11 00 40     	        LD DE,0x4000
8013 01 00 1B     	        LD BC,6912
8016 ED B0        	        LDIR
8018 FB           	        EI
8019              		IF sectors_0 > 0
8019 3E 10        		LD A,16+0
801B 01 FD 7F     		LD BC,0x7FFD
801E ED 79        		OUT (C),A
8020 11 0C 03     		LD DE,disk_0
8023 ED 53 0E 81  		LD (disk_position),DE
8027 21 00 C0     		LD HL,0xC000
802A 06 34        		LD B,sectors_0
802C CD EA 80     		CALL read_n
802F              		ENDIF
802F              	        LOAD_BANK 0,disk_0,sectors_0
802F              		IF sectors_1 > 0
802F              		LD A,16+4
802F              		LD BC,0x7FFD
802F              		OUT (C),A
802F              		LD DE,disk_1
802F              		LD (disk_position),DE
802F              		LD HL,0xC000
802F              		LD B,sectors_1
802F              		CALL read_n
802F              		ENDIF
802F              	        LOAD_BANK 4,disk_1,sectors_1
802F              		IF sectors_2 > 0
802F              		LD A,16+6
802F              		LD BC,0x7FFD
802F              		OUT (C),A
802F              		LD DE,disk_2
802F              		LD (disk_position),DE
802F              		LD HL,0xC000
802F              		LD B,sectors_2
802F              		CALL read_n
802F              		ENDIF
802F              	        LOAD_BANK 6,disk_2,sectors_2
802F              		IF sectors_3 > 0
802F              		LD A,16+1
802F              		LD BC,0x7FFD
802F              		OUT (C),A
802F              		LD DE,disk_3
802F              		LD (disk_position),DE
802F              		LD HL,0xC000
802F              		LD B,sectors_3
802F              		CALL read_n
802F              		ENDIF
802F              	        LOAD_BANK 1,disk_3,sectors_3
802F              		IF sectors_4 > 0
802F              		LD A,16+3
802F              		LD BC,0x7FFD
802F              		OUT (C),A
802F              		LD DE,disk_4
802F              		LD (disk_position),DE
802F              		LD HL,0xC000
802F              		LD B,sectors_4
802F              		CALL read_n
802F              		ENDIF
802F              	        LOAD_BANK 3,disk_4,sectors_4
802F              		IF sectors_5 > 0
802F              		LD A,16+7
802F              		LD BC,0x7FFD
802F              		OUT (C),A
802F              		LD DE,disk_5
802F              		LD (disk_position),DE
802F              		LD HL,0xC000
802F              		LD B,sectors_5
802F              		CALL read_n
802F              		ENDIF
802F              	        LOAD_BANK 7,disk_5,sectors_5
802F F3           	        DI
                 	        ; Erase the first three character rows containing the loading message.
                 	        ; Spectrum bitmap scanlines are interleaved in eight 256-byte planes.
                 	        ; This runs once after loading and costs nothing during playback.
8030 21 00 40     	        LD HL,0x4000
8033 06 08        	        LD B,8
                 	clear_loading:
8035 C5           	        PUSH BC
8036 E5           	        PUSH HL
8037 54           	        LD D,H
8038 5D           	        LD E,L
8039 13           	        INC DE
803A 01 5F 00     	        LD BC,95
803D 36 00        	        LD (HL),0
803F ED B0        	        LDIR
8041 E1           	        POP HL
8042 24           	        INC H
8043 C1           	        POP BC
8044 10 EF        	        DJNZ clear_loading
                 	        ; Clear the chip, including its envelope, after loading from disk.
8046 16 00        	        LD D,0
8048 1E 00        	        LD E,0
804A 0E FD        	        LD C,0xFD
                 	clear_ay:
804C 06 FF        	        LD B,0xFF
804E ED 51        	        OUT (C),D
8050 06 BF        	        LD B,0xBF
8052 ED 59        	        OUT (C),E
8054 14           	        INC D
8055 7A           	        LD A,D
8056 FE 0E        	        CP 14
8058 20 F2        	        JR NZ,clear_ay
805A 21 00 BE     	        LD HL,0xBE00
805D 11 01 BE     	        LD DE,0xBE01
8060 01 00 01     	        LD BC,256
8063 36 BD        	        LD (HL),0xBD
8065 ED B0        	        LDIR
8067 3E C3        	        LD A,0xC3
8069 32 BD BD     	        LD (0xBDBD),A
806C 21 E7 80     	        LD HL,irq
806F 22 BE BD     	        LD (0xBDBE),HL
8072 3E BE        	        LD A,0xBE
8074 ED 47        	        LD I,A
8076 ED 5E        	        IM 2
8078 3E 10        	        LD A,16
807A 01 FD 7F     	        LD BC,0x7FFD
807D ED 79        	        OUT (C),A
807F 21 00 C0     	        LD HL,0xC000
8082 FB           	ready:  EI
                 	wait_field:
8083 76           	        HALT
                 	field_start:
                 	        ; 38 T. Each tick remains tied to its original interrupt field.
8084 ED 5B 0C 81  	        LD DE,(remaining)
8088 7A           	        LD A,D
8089 B3           	        OR E
808A CA CA 80     	        JP Z,finished
                 	tick_start:
808D 16 00        	        LD D,0
808F 0E FD        	        LD C,0xFD
                 	write_register:
                 	        ; 78 T continuing, 73 T final; setup + eleven writes = 867 T.
8091 5E           	        LD E,(HL)
8092 23           	        INC HL
8093 06 FF        	        LD B,0xFF
8095 ED 51        	        OUT (C),D
8097 06 BF        	        LD B,0xBF
8099 ED 59        	ay_out: OUT (C),E
809B 14           	        INC D
809C 7A           	        LD A,D
809D FE 0B        	        CP 11
809F 20 F0        	        JR NZ,write_register
                 	tick_end:
80A1 ED 5B 0C 81  	        LD DE,(remaining)
80A5 1B           	        DEC DE
80A6 ED 53 0C 81  	        LD (remaining),DE
80AA 7C           	        LD A,H
80AB FE FF        	        CP 0xFF
80AD 20 D4        	        JR NZ,wait_field
80AF 7D           	        LD A,L
80B0 FE FB        	        CP 0xFB
80B2 20 CF        	        JR NZ,wait_field
                 	        ; Never read past the bank table on an exact-boundary EOF.
80B4 7A           	        LD A,D
80B5 B3           	        OR E
80B6 28 CB        	        JR Z,wait_field
80B8 2A 10 81     	        LD HL,(bank_pointer)
80BB 23           	        INC HL
80BC 22 10 81     	        LD (bank_pointer),HL
80BF 7E           	        LD A,(HL)
80C0 01 FD 7F     	        LD BC,0x7FFD
80C3 ED 79        	        OUT (C),A
80C5 21 00 C0     	        LD HL,0xC000
80C8 18 B9        	        JR wait_field
                 	finished:
80CA              	        IF loop_playback
                 	        ; 105 T beyond the normal field check, once per repeat.
                 	        ; Reset then publish tick zero in THIS field: no empty extra field.
80CA 11 B0 04     	        LD DE,total_ticks
80CD ED 53 0C 81  	        LD (remaining),DE
80D1 21 12 81     	        LD HL,bank_table
80D4 22 10 81     	        LD (bank_pointer),HL
80D7 3E 10        	        LD A,16
80D9 01 FD 7F     	        LD BC,0x7FFD
80DC ED 79        	        OUT (C),A
80DE 21 00 C0     	        LD HL,0xC000
80E1 C3 8D 80     	        JP tick_start
80E4              	        ELSE
80E4              	        LD E,0
80E4              	        LD C,0xFD
80E4              	        LD D,8
80E4              	        LD B,0xFF
80E4              	        OUT (C),D
80E4              	        LD B,0xBF
80E4              	        OUT (C),E
80E4              	        LD D,9
80E4              	        LD B,0xFF
80E4              	        OUT (C),D
80E4              	        LD B,0xBF
80E4              	        OUT (C),E
80E4              	        LD D,10
80E4              	        LD B,0xFF
80E4              	        OUT (C),D
80E4              	        LD B,0xBF
80E4              	        OUT (C),E
80E4              	        ENDIF
                 	finished_wait:
80E4 76           	        HALT
80E5 18 FD        	        JR finished_wait
80E7 FB           	irq:    EI
80E8 ED 4D        	        RETI
80EA C5           	read_n: PUSH BC
80EB E5           	        PUSH HL
80EC ED 5B 0E 81  	        LD DE,(disk_position)
80F0 01 05 01     	        LD BC,0x0105
                 	disk_call:
80F3 CD 13 3D     	        CALL 0x3D13
80F6 E1           	        POP HL
80F7 C1           	        POP BC
80F8 24           	        INC H
80F9 ED 5B 0E 81  	        LD DE,(disk_position)
80FD 1C           	        INC E
80FE CB 63        	        BIT 4,E
8100 28 03        	        JR Z,sector_ok
8102 1E 00        	        LD E,0
8104 14           	        INC D
                 	sector_ok:
8105 ED 53 0E 81  	        LD (disk_position),DE
8109 10 DF        	        DJNZ read_n
810B C9           	        RET
810C B0 04        	remaining: DEFW total_ticks
810E 00 00        	disk_position: DEFW 0
8110 12 81        	bank_pointer: DEFW bank_table
8112 17           	bank_table: DEFB 16,20,22,17,19,23
                 	code_end:
8118              	        ASSERT $ <= 0x9000
8118              	        DS 0x9000-$
                 	screen_data:
9000 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 04 08 11 32 09 24 90 E0 4C 82 41 24 08 20 89 82 09 80 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 03 10 43 06 41 1E 21 E0 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 08 22 02 22 3E 1E 21 E0 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 04 08 11 F2 09 26 90 20 7C 82 41 24 08 20 8F 82 0F 80 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 02 88 83 06 41 23 22 10 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 04 08 12 12 09 22 98 20 84 82 41 24 08 20 90 82 10 80 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 02 8C 83 8E 41 21 24 18 00 00 00 00 00 