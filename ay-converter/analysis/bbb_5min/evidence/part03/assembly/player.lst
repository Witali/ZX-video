                 	
                 	; Standalone AY50 player: all R0..R10 records are loaded before playback.
                 	; Python supplies constants, screen pixels and register data, never opcodes.
                 	; Bank 5: display/BASIC/TR-DOS. Bank 2: code, screen image, stack and IM2.
                 	; Six other banks: whole 11- or 14-byte records. IRQ preserves all registers.
                 	; Extended records carry R11/R12 and an R13 action: FF means omit the write.
                 	; Never rewrite a held shape every field: R13 writes restart envelope phase.
                 	
8000              	total_ticks: EQU 5000
8000              	loop_playback: EQU 0
8000              	record_bytes: EQU 14
8000              	bank_end_low: EQU 252
8000              	disk_0: EQU 780
8000              	sectors_0: EQU 64
8000              	disk_1: EQU 1804
8000              	sectors_1: EQU 64
8000              	disk_2: EQU 2828
8000              	sectors_2: EQU 64
8000              	disk_3: EQU 3852
8000              	sectors_3: EQU 64
8000              	disk_4: EQU 4876
8000              	sectors_4: EQU 18
8000              	disk_5: EQU 0
8000              	sectors_5: EQU 0
8000              	        INCLUDE "config.inc"
8000              	        ORG 0x8000
8000              	LOAD_BANK: MACRO
8000              	        IF \2 > 0
8000              	        LD A,16+\0
8000              	        LD BC,0x7FFD
8000              	        OUT (C),A
8000              	        LD DE,\1
8000              	        LD (disk_position),DE
8000              	        LD HL,0xC000
8000              	        LD B,\2
8000              	        CALL read_n
8000              	        ENDIF
8000              	        ENDM
8000 F3           	start:  DI
8001 31 00 B8     	        LD SP,0xB800
8004 FD 21 3A 5C  	        LD IY,0x5C3A
8008 ED 56        	        IM 1
800A AF           	        XOR A
800B D3 FE        	        OUT (0xFE),A
800D 21 00 90     	        LD HL,screen_data
8010 11 00 40     	        LD DE,0x4000
8013 01 00 1B     	        LD BC,6912
8016 ED B0        	        LDIR
8018 FB           	        EI
8019              		IF sectors_0 > 0
8019 3E 10        		LD A,16+0
801B 01 FD 7F     		LD BC,0x7FFD
801E ED 79        		OUT (C),A
8020 11 0C 03     		LD DE,disk_0
8023 ED 53 7F 81  		LD (disk_position),DE
8027 21 00 C0     		LD HL,0xC000
802A 06 40        		LD B,sectors_0
802C CD 5B 81     		CALL read_n
802F              		ENDIF
802F              	        LOAD_BANK 0,disk_0,sectors_0
802F              		IF sectors_1 > 0
802F 3E 14        		LD A,16+4
8031 01 FD 7F     		LD BC,0x7FFD
8034 ED 79        		OUT (C),A
8036 11 0C 07     		LD DE,disk_1
8039 ED 53 7F 81  		LD (disk_position),DE
803D 21 00 C0     		LD HL,0xC000
8040 06 40        		LD B,sectors_1
8042 CD 5B 81     		CALL read_n
8045              		ENDIF
8045              	        LOAD_BANK 4,disk_1,sectors_1
8045              		IF sectors_2 > 0
8045 3E 16        		LD A,16+6
8047 01 FD 7F     		LD BC,0x7FFD
804A ED 79        		OUT (C),A
804C 11 0C 0B     		LD DE,disk_2
804F ED 53 7F 81  		LD (disk_position),DE
8053 21 00 C0     		LD HL,0xC000
8056 06 40        		LD B,sectors_2
8058 CD 5B 81     		CALL read_n
805B              		ENDIF
805B              	        LOAD_BANK 6,disk_2,sectors_2
805B              		IF sectors_3 > 0
805B 3E 11        		LD A,16+1
805D 01 FD 7F     		LD BC,0x7FFD
8060 ED 79        		OUT (C),A
8062 11 0C 0F     		LD DE,disk_3
8065 ED 53 7F 81  		LD (disk_position),DE
8069 21 00 C0     		LD HL,0xC000
806C 06 40        		LD B,sectors_3
806E CD 5B 81     		CALL read_n
8071              		ENDIF
8071              	        LOAD_BANK 1,disk_3,sectors_3
8071              		IF sectors_4 > 0
8071 3E 13        		LD A,16+3
8073 01 FD 7F     		LD BC,0x7FFD
8076 ED 79        		OUT (C),A
8078 11 0C 13     		LD DE,disk_4
807B ED 53 7F 81  		LD (disk_position),DE
807F 21 00 C0     		LD HL,0xC000
8082 06 12        		LD B,sectors_4
8084 CD 5B 81     		CALL read_n
8087              		ENDIF
8087              	        LOAD_BANK 3,disk_4,sectors_4
8087              		IF sectors_5 > 0
8087              		LD A,16+7
8087              		LD BC,0x7FFD
8087              		OUT (C),A
8087              		LD DE,disk_5
8087              		LD (disk_position),DE
8087              		LD HL,0xC000
8087              		LD B,sectors_5
8087              		CALL read_n
8087              		ENDIF
8087              	        LOAD_BANK 7,disk_5,sectors_5
8087 F3           	        DI
                 	        ; Erase the first three character rows containing the loading message.
                 	        ; Spectrum bitmap scanlines are interleaved in eight 256-byte planes.
                 	        ; This runs once after loading and costs nothing during playback.
8088 21 00 40     	        LD HL,0x4000
808B 06 08        	        LD B,8
                 	clear_loading:
808D C5           	        PUSH BC
808E E5           	        PUSH HL
808F 54           	        LD D,H
8090 5D           	        LD E,L
8091 13           	        INC DE
8092 01 5F 00     	        LD BC,95
8095 36 00        	        LD (HL),0
8097 ED B0        	        LDIR
8099 E1           	        POP HL
809A 24           	        INC H
809B C1           	        POP BC
809C 10 EF        	        DJNZ clear_loading
                 	        ; Clear the chip, including its envelope, after loading from disk.
809E 16 00        	        LD D,0
80A0 1E 00        	        LD E,0
80A2 0E FD        	        LD C,0xFD
                 	clear_ay:
80A4 06 FF        	        LD B,0xFF
80A6 ED 51        	        OUT (C),D
80A8 06 BF        	        LD B,0xBF
80AA ED 59        	        OUT (C),E
80AC 14           	        INC D
80AD 7A           	        LD A,D
80AE FE 0E        	        CP 14
80B0 20 F2        	        JR NZ,clear_ay
80B2 21 00 BE     	        LD HL,0xBE00
80B5 11 01 BE     	        LD DE,0xBE01
80B8 01 00 01     	        LD BC,256
80BB 36 BD        	        LD (HL),0xBD
80BD ED B0        	        LDIR
80BF 3E C3        	        LD A,0xC3
80C1 32 BD BD     	        LD (0xBDBD),A
80C4 21 58 81     	        LD HL,irq
80C7 22 BE BD     	        LD (0xBDBE),HL
80CA 3E BE        	        LD A,0xBE
80CC ED 47        	        LD I,A
80CE ED 5E        	        IM 2
80D0 3E 10        	        LD A,16
80D2 01 FD 7F     	        LD BC,0x7FFD
80D5 ED 79        	        OUT (C),A
80D7 21 00 C0     	        LD HL,0xC000
80DA FB           	ready:  EI
                 	wait_field:
80DB 76           	        HALT
                 	field_start:
                 	        ; 38 T. Each tick remains tied to its original interrupt field.
80DC ED 5B 7D 81  	        LD DE,(remaining)
80E0 7A           	        LD A,D
80E1 B3           	        OR E
80E2 CA 33 81     	        JP Z,finished
                 	tick_start:
80E5 16 00        	        LD D,0
80E7 0E FD        	        LD C,0xFD
                 	write_register:
                 	        ; 78 T continuing, 73 T final; setup + eleven writes = 867 T.
80E9 5E           	        LD E,(HL)
80EA 23           	        INC HL
80EB 06 FF        	        LD B,0xFF
80ED ED 51        	        OUT (C),D
80EF 06 BF        	        LD B,0xBF
80F1 ED 59        	ay_out: OUT (C),E
80F3 14           	        INC D
80F4 7A           	        LD A,D
80F5              	        IF record_bytes == 14
80F5 FE 0D        	        CP 13
80F7              	        ELSE
80F7              	        CP 11
80F7              	        ENDIF
80F7 20 F0        	        JR NZ,write_register
80F9              	        IF record_bytes == 14
                 	        ; Thirteen ordinary writes cost 1023 T. The R13 action consumes one
                 	        ; byte even when skipped. Tail is 36 T without restart, 76 T with it:
                 	        ; total tick work 1059/1099 T vs 867 T, delta +192/+232 T.
                 	        ; Input HL=R13 action, D=13, C=FD. Clobbers A/B/E and advances HL.
80F9 5E           	        LD E,(HL)
80FA 23           	        INC HL
80FB 7B           	        LD A,E
80FC FE FF        	        CP 255
80FE 28 0A        	        JR Z,tick_end
8100 16 0D        	        LD D,13
8102 06 FF        	        LD B,0xFF
8104 ED 51        	        OUT (C),D
8106 06 BF        	        LD B,0xBF
                 	ay_env_out:
8108 ED 59        	        OUT (C),E
810A              	        ENDIF
                 	tick_end:
810A ED 5B 7D 81  	        LD DE,(remaining)
810E 1B           	        DEC DE
810F ED 53 7D 81  	        LD (remaining),DE
8113 7C           	        LD A,H
8114 FE FF        	        CP 0xFF
8116 20 C3        	        JR NZ,wait_field
8118 7D           	        LD A,L
8119 FE FC        	        CP bank_end_low
811B 20 BE        	        JR NZ,wait_field
                 	        ; Never read past the bank table on an exact-boundary EOF.
811D 7A           	        LD A,D
811E B3           	        OR E
811F 28 BA        	        JR Z,wait_field
8121 2A 81 81     	        LD HL,(bank_pointer)
8124 23           	        INC HL
8125 22 81 81     	        LD (bank_pointer),HL
8128 7E           	        LD A,(HL)
8129 01 FD 7F     	        LD BC,0x7FFD
812C ED 79        	        OUT (C),A
812E 21 00 C0     	        LD HL,0xC000
8131 18 A8        	        JR wait_field
                 	finished:
8133              	        IF loop_playback
                 	        ; 105 T beyond the normal field check, once per repeat.
                 	        ; Reset then publish tick zero in THIS field: no empty extra field.
8133              	        LD DE,total_ticks
8133              	        LD (remaining),DE
8133              	        LD HL,bank_table
8133              	        LD (bank_pointer),HL
8133              	        LD A,16
8133              	        LD BC,0x7FFD
8133              	        OUT (C),A
8133              	        LD HL,0xC000
8133              	        JP tick_start
8133              	        ELSE
8133 1E 00        	        LD E,0
8135 0E FD        	        LD C,0xFD
8137 16 08        	        LD D,8
8139 06 FF        	        LD B,0xFF
813B ED 51        	        OUT (C),D
813D 06 BF        	        LD B,0xBF
813F ED 59        	        OUT (C),E
8141 16 09        	        LD D,9
8143 06 FF        	        LD B,0xFF
8145 ED 51        	        OUT (C),D
8147 06 BF        	        LD B,0xBF
8149 ED 59        	        OUT (C),E
814B 16 0A        	        LD D,10
814D 06 FF        	        LD B,0xFF
814F ED 51        	        OUT (C),D
8151 06 BF        	        LD B,0xBF
8153 ED 59        	        OUT (C),E
8155              	        ENDIF
                 	finished_wait:
8155 76           	        HALT
8156 18 FD        	        JR finished_wait
8158 FB           	irq:    EI
8159 ED 4D        	        RETI
815B C5           	read_n: PUSH BC
815C E5           	        PUSH HL
815D ED 5B 7F 81  	        LD DE,(disk_position)
8161 01 05 01     	        LD BC,0x0105
                 	disk_call:
8164 CD 13 3D     	        CALL 0x3D13
8167 E1           	        POP HL
8168 C1           	        POP BC
8169 24           	        INC H
816A ED 5B 7F 81  	        LD DE,(disk_position)
816E 1C           	        INC E
816F CB 63        	        BIT 4,E
8171 28 03        	        JR Z,sector_ok
8173 1E 00        	        LD E,0
8175 14           	        INC D
                 	sector_ok:
8176 ED 53 7F 81  	        LD (disk_position),DE
817A 10 DF        	        DJNZ read_n
817C C9           	        RET
817D 88 13        	remaining: DEFW total_ticks
817F 00 00        	disk_position: DEFW 0
8181 83 81        	bank_pointer: DEFW bank_table
8183 17           	bank_table: DEFB 16,20,22,17,19,23
                 	code_end:
8189              	        ASSERT $ <= 0x9000
8189              	        DS 0x9000-$
                 	screen_data:
9000 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 04 08 11 32 09 24 90 E0 4C 82 41 24 08 20 89 82 09 80 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 03 10 43 06 41 1E 21 E0 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 08 22 02 22 3E 1E 21 E0 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 04 08 11 F2 09 26 90 20 7C 82 41 24 08 20 8F 82 0F 80 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 02 88 83 06 41 23 22 10 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 04 08 12 12 09 22 98 20 84 82 41 24 08 20 90 82 10 80 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 02 8C 83 8E 41 21 24 18 00 00 00 00 00 