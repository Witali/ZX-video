80E4 01 FD FF     		LD BC,0xFFFD
80E7 3E 0A        		LD A,10
80E9 ED 79        		OUT (C),A
80EB 01 FD BF     		LD BC,0xBFFD
80EE AF           		XOR A
80EF ED 79        		OUT (C),A
80F1              	        SILENCE_AY 10
80F1 01 FD 7F     	        LD BC,0x7FFD
80F4 3E 10        	        LD A,16
80F6 ED 79        	        OUT (C),A
80F8 FB           	        EI
80F9 76           	        HALT                    ; one startup IRQ, then no IRQ/disk activity
80FA F3           	        DI
80FB 21 00 C0     	ready:  LD HL,address_0
80FE D9           	        EXX
80FF 21 00 86     	        LD HL,tables+64*initial_index
8102 D9           	        EXX
8103 DD 21 00 80  	        LD IX,initial_predictor+32768
8107 FD 21 7F 82  	        LD IY,bank_tail_0
                 	
                 	; Prime sample zero before the first output, using the same IMA recurrence.
810B 7E           	        LD A,(HL)
810C D9           	        EXX
810D E6 0F        	        AND 15
810F 07           	        RLCA
8110 07           	        RLCA
8111 B5           	        OR L
8112 6F           	        LD L,A
8113 F9           	        LD SP,HL
8114 C1           	        POP BC
8115 E1           	        POP HL
8116 CB 45        	        BIT 0,L
8118 DD 09        	        ADD IX,BC
811A C2 27 81     	        JP NZ,prime_negative
811D D2 2E 81     	        JP NC,prime_done
8120 DD 21 FF FF  	        LD IX,65535
8124 C3 2E 81     	        JP prime_done
                 	prime_negative:
8127 DA 2E 81     	        JP C,prime_done
812A DD 21 00 00  	        LD IX,0
                 	prime_done:
812E CB 85        	        RES 0,L
8130 D9           	        EXX
8131 DD 7C        	        LD A,IXH
8133 01 FE 10     	        LD BC,0x10FE
8136 57           	        LD D,A
8137 1E 00        	        LD E,0
8139 08           	        EX AF,AF'
813A 3E 80        	        LD A,128
813C 08           	        EX AF,AF'
813D C3 CE 81     	        JP high
                 	
                 	; First four slots shared in structure, but distinct labels permit exact
                 	; instruction-boundary capture. Each PULSE preserves all decoder flags.
8140              	DECODE_HEAD: MACRO
8140              	        PULSE \0_out0
8140              	        LD A,(HL)               ; 7+15+4+4+4 = 34 T, including EXX pair
8140              	        IF \1 == 0
8140              	        AND 15
8140              	        RLCA
8140              	        RLCA
8140              	        ELSE
8140              	        RRCA
8140              	        RRCA
8140              	        AND 60
8140              	        ENDIF
8140              	        EXX
8140              	        OR L
8140              	        EXX
8140              	        PULSE \0_out1
8140              	        EXX                     ; 4+4+6+10+4+4 = 32 T
8140              	        LD L,A
8140              	        LD SP,HL
8140              	        POP BC                  ; first half of table entry
8140              	        EXX
8140              	        NOP
8140              	        PULSE \0_out2
8140              	        EXX                     ; 4+10+8+8+4 = 34 T
8140              	        POP HL                  ; next row and sign
8140              	\0_state: BIT 0,L
8140              	        RES 0,L                 ; clear tag now, preserving BIT's Z
8140              	        EXX
8140              	        PULSE \0_out3
8140              	        EXX                     ; 4+15+4+10 = 33 T
8140              	        ADD IX,BC
8140              	        EXX
8140              	        JP NZ,\0_negative
8140              	        ENDM
                 	
                 	; Low nibble holds [74,72,74,73,72,74] = 439 T.
8140              		ASSERT low_out0 >= 0
8140 08           		EX AF,AF'
8141 82           		ADD A,D
8142 CB 1B        		RR E
8144 CB 9B        		RES 3,E
8146 ED 59        	low_out0:	OUT (C),E
8148 08           		EX AF,AF'
