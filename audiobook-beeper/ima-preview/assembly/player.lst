827F              	bank_tail_\0: ASSERT \0 >= 0
827F              	        PULSE bank_\0_out6
827F              	        LD A,IXH                ; 8+13+4+10+4 = 39 T
827F              	        LD (bank_candidate),A
827F              	        EXX
827F              	        LD BC,0x7FFD             ; keep canonical paging port in scratch bank
827F              	        EXX
827F              	        PULSE bank_\0_out7
827F              	        EXX                     ; 4+7+12+4 = 27 T, leaving room for I/O delays
827F              	        LD A,\1+16
827F              	page_\0: OUT (C),A
827F              	        EXX
827F              	        PULSE bank_\0_out8
827F              	        LD H,\2 >> 8            ; 7+14+12 = 33 T; L remains zero
827F              	        LD IY,bank_tail_\3
827F              	        JR bank_next_\0
827F              	bank_next_\0: PULSE bank_\0_out9
827F              	        IF \0 == 7
827F              	        EXX                     ; 4+10+4+14 = 32 T; reset decoder only
827F              	        LD HL,tables+64*initial_index
827F              	        EXX
827F              	        LD IX,initial_predictor+32768
827F              	        ELSE
