80C1 21 00 E0     		LD HL,address_7
80C4 06 20        		LD B,sectors_7
80C6 CD 06 85     		CALL read_n
80C9              	        LOAD_BANK 5, disk_7, address_7, sectors_7
80C9 F3           	        DI
80CA 01 FD FF     		LD BC,0xFFFD
80CD 3E 08        		LD A,8
80CF ED 79        		OUT (C),A
80D1 01 FD BF     		LD BC,0xBFFD
80D4 AF           		XOR A
80D5 ED 79        		OUT (C),A
80D7              	        SILENCE_AY 8
80D7 01 FD FF     		LD BC,0xFFFD
80DA 3E 09        		LD A,9
80DC ED 79        		OUT (C),A
80DE 01 FD BF     		LD BC,0xBFFD
80E1 AF           		XOR A
