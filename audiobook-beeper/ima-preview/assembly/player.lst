8016 ED B0        	        LDIR
8018 FB           	        EI
8019 01 FD 7F     		LD BC,0x7FFD
801C 3E 10        		LD A,0+16
801E ED 79        		OUT (C),A
8020 11 09 04     		LD DE,disk_0
8023 ED 53 28 85  		LD (disk_position),DE
8027 21 00 C0     		LD HL,address_0
802A 06 40        		LD B,sectors_0
802C CD 06 85     		CALL read_n
802F              	        LOAD_BANK 0, disk_0, address_0, sectors_0
802F 01 FD 7F     		LD BC,0x7FFD
8032 3E 14        		LD A,4+16
8034 ED 79        		OUT (C),A
8036 11 09 08     		LD DE,disk_1
8039 ED 53 28 85  		LD (disk_position),DE
803D 21 00 C0     		LD HL,address_1
8040 06 40        		LD B,sectors_1
8042 CD 06 85     		CALL read_n
8045              	        LOAD_BANK 4, disk_1, address_1, sectors_1
8045 01 FD 7F     		LD BC,0x7FFD
8048 3E 16        		LD A,6+16
804A ED 79        		OUT (C),A
804C 11 09 0C     		LD DE,disk_2
804F ED 53 28 85  		LD (disk_position),DE
8053 21 00 C0     		LD HL,address_2
8056 06 40        		LD B,sectors_2
8058 CD 06 85     		CALL read_n
