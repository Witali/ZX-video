                 	
                 	; LPS1 -> PCM8 -> ordinary low-nibble-first IMA, entirely on the Z80.
                 	; This program runs before sound starts. No PDM deadline applies here.
                 	; Fixed bank2: code/state below 9C00, final compressed tail at A000..B7FF.
                 	; Bank5: visible screen/workspace below6000, temporary product tables6000..77FF.
                 	; LPC input initially occupies banks3/7. Those bytes are consumed before reuse.
                 	
8000              	lpc_disk: EQU 3343
8000              	player_disk: EQU 1032
8000              	lpc_bytes: EQU 32736
8000              	lpc_first_sectors: EQU 64
8000              	lpc_second_sectors: EQU 64
8000              	frame_count: EQU 1168
8000              	last_frame_samples: EQU 32
8000              	trampoline_size: EQU 44
8000              	        INCLUDE "lpc-config.inc"
8000              	        ORG 0x8000
8000 F3           	start:  DI
8001 31 00 60     	        LD SP,0x6000
8004 FD 21 3A 5C  	        LD IY,0x5C3A
8008 ED 56        	        IM 1
800A AF           	        XOR A
800B D3 FE        	        OUT (0xFE),A
800D 21 00 9C     	        LD HL,screen_data
8010 11 00 40     	        LD DE,0x4000
8013 01 00 1B     	        LD BC,6912
8016 ED B0        	        LDIR
8018 3E 03        	        LD A,3
801A CD 54 81     	        CALL page
801D 11 0F 0D     	        LD DE,lpc_disk
8020 ED 53 67 84  	        LD (disk_position),DE
8024 21 00 C0     	        LD HL,0xC000
8027 06 40        	        LD B,lpc_first_sectors
8029 CD DD 80     	        CALL read_n
802C              	        IF lpc_second_sectors > 0
802C 3E 07        	        LD A,7
802E CD 54 81     	        CALL page
8031 21 00 C0     	        LD HL,0xC000
8034 06 40        	        LD B,lpc_second_sectors
8036 CD DD 80     	        CALL read_n
8039              	        ENDIF
8039 F3           	        DI
                 	load_complete:
803A 3E 20        	        LD A,32
803C 32 6C 84     	        LD (load_progress),A
803F 21 40 59     	        LD HL,0x5940
8042 06 20        	        LD B,32
                 	load_full:
8044 36 64        	        LD (HL),0x64
8046 23           	        INC HL
8047 10 FB        	        DJNZ load_full
8049 21 20 C0     	        LD HL,0xC020
804C 22 6E 84     	        LD (input_cursor),HL
804F 21 C0 7F     	        LD HL,lpc_bytes-32
8052 22 70 84     	        LD (input_left),HL
8055 3E 03        	        LD A,3
8057 32 72 84     	        LD (input_bank),A
805A 21 D9 84     	        LD HL,section_data
805D 22 77 84     	        LD (section_cursor),HL
8060 CD 9C 81     	        CALL select_output
8063 21 CD 6C     	        LD HL,27853           ; de-emphasis coefficient round(.85*32768)
8066 EB           	        EX DE,HL
8067 3E 76        	        LD A,0x76
8069 CD D7 81     	        CALL build_table
806C 21 90 04     	        LD HL,frame_count
806F 22 79 84     	        LD (frames_left),HL
                 	frame_loop:
8072 CD 5C 81     	        CALL read_frame
8075 DD 21 A3 84  	        LD IX,frame_buffer
8079 06 0A        	        LD B,10
807B 0E 60        	        LD C,0x60
                 	coefficient_loop:
807D DD 5E 00     	        LD E,(IX+0)
8080 DD 56 01     	        LD D,(IX+1)
8083 79           	        LD A,C
8084 C5           	        PUSH BC
8085 CD D7 81     	        CALL build_table
8088 C1           	        POP BC
8089 DD 23        	        INC IX
808B DD 23        	        INC IX
808D 0C           	        INC C
808E 0C           	        INC C
808F 10 EC        	        DJNZ coefficient_loop
8091 ED 5B BD 84  	        LD DE,(frame_buffer+26)
8095 3E 74        	        LD A,0x74
8097 CD D7 81     	        CALL build_table       ; noise amplitude * signed8 /128
809A 2A 79 84     	        LD HL,(frames_left)
809D 2B           	        DEC HL
809E 22 79 84     	        LD (frames_left),HL
80A1 7C           	        LD A,H
80A2 B5           	        OR L
80A3 3E A0        	        LD A,160
80A5 20 02        	        JR NZ,frame_length_ready
80A7 3E 20        	        LD A,last_frame_samples
                 	frame_length_ready:
80A9 32 7B 84     	        LD (samples_left),A
                 	sample_loop:
80AC CD 47 82     	        CALL synth_sample
                 	pcm_ready:
80AF CD 3E 83     	        CALL emit_pcm
80B2 3A 7B 84     	        LD A,(samples_left)
80B5 3D           	        DEC A
80B6 32 7B 84     	        LD (samples_left),A
80B9 C2 AC 80     	        JP NZ,sample_loop
80BC 2A 79 84     	        LD HL,(frames_left)
80BF 7C           	        LD A,H
80C0 B5           	        OR L
80C1 C2 72 80     	        JP NZ,frame_loop
80C4 06 80        	        LD B,128              ; independent silent guard settles IMA to0/0
                 	guard_loop:
80C6 C5           	        PUSH BC
80C7 3E 80        	        LD A,128
                 	guard_pcm_ready:
80C9 CD 3E 83     	        CALL emit_pcm
80CC C1           	        POP BC
80CD 10 F7        	        DJNZ guard_loop
                 	unpack_complete:
80CF 21 6E 85     	        LD HL,trampoline_data
80D2 11 00 60     	        LD DE,0x6000
80D5 01 2C 00     	        LD BC,trampoline_size
80D8 ED B0        	        LDIR
80DA C3 00 60     	        JP 0x6000             ; replace this program with the resident player
                 	
                 	; BC and IY may be destroyed by TR-DOS; caller loop/cursor are preserved.
80DD 22 69 84     	read_n: LD (disk_destination),HL
                 	read_sector:
80E0 C5           	        PUSH BC
80E1 2A 69 84     	        LD HL,(disk_destination)
80E4 ED 5B 67 84  	        LD DE,(disk_position)
80E8 01 05 01     	        LD BC,0x0105
80EB FB           	        EI
                 	disk_call:
80EC CD 13 3D     	        CALL 0x3D13
80EF F3           	        DI
80F0 2A 69 84     	        LD HL,(disk_destination)
80F3 24           	        INC H
80F4 22 69 84     	        LD (disk_destination),HL
80F7 ED 5B 67 84  	        LD DE,(disk_position)
80FB 1C           	        INC E
80FC CB 63        	        BIT 4,E
80FE 28 03        	        JR Z,sector_ok
8100 1E 00        	        LD E,0
8102 14           	        INC D
                 	sector_ok:
8103 ED 53 67 84  	        LD (disk_position),DE
8107 3A 6B 84     	        LD A,(sectors_read)
810A 3C           	        INC A
810B 32 6B 84     	        LD (sectors_read),A
810E 21 EE 84     	        LD HL,load_thresholds
8111 5F           	        LD E,A
8112 3A 6C 84     	        LD A,(load_progress)
8115 FE 20        	        CP 32
8117 28 37        	        JR Z,load_no_update
8119 4F           	        LD C,A
811A 06 00        	        LD B,0
811C 09           	        ADD HL,BC
811D 7B           	        LD A,E
811E BE           	        CP (HL)
811F 38 2F        	        JR C,load_no_update
8121 21 40 59     	        LD HL,0x5940
8124 09           	        ADD HL,BC
8125 36 64        	        LD (HL),0x64
8127 79           	        LD A,C
8128 3C           	        INC A
8129 32 6C 84     	        LD (load_progress),A
                 	load_progress_event:
812C 00           	        NOP
812D 3A 6B 84     	        LD A,(sectors_read)
8130 5F           	        LD E,A
8131 21 EE 84     	        LD HL,load_thresholds
8134 3A 6C 84     	        LD A,(load_progress)
8137 FE 20        	        CP 32
8139 28 15        	        JR Z,load_no_update
813B 4F           	        LD C,A
813C 06 00        	        LD B,0
813E 09           	        ADD HL,BC
813F 7B           	        LD A,E
8140 BE           	        CP (HL)
8141 38 0D        	        JR C,load_no_update
8143 21 40 59     	        LD HL,0x5940
8146 09           	        ADD HL,BC
8147 36 64        	        LD (HL),0x64
8149 79           	        LD A,C
814A 3C           	        INC A
814B 32 6C 84     	        LD (load_progress),A
814E 18 DC        	        JR load_progress_event
                 	load_no_update:
8150 C1           	        POP BC
8151 10 8D        	        DJNZ read_sector
8153 C9           	        RET
                 	
8154 01 FD 7F     	page:   LD BC,0x7FFD
8157 F6 10        	        OR 16                 ; ROM1, visible bank5, paging stays enabled
8159 ED 79        	        OUT (C),A
815B C9           	        RET
                 	
                 	read_frame:
815C 3A 73 84     	        LD A,(input_fixed)
815F B7           	        OR A
8160 20 06        	        JR NZ,input_selected
8162 3A 72 84     	        LD A,(input_bank)
8165 CD 54 81     	        CALL page
                 	input_selected:
8168 2A 6E 84     	        LD HL,(input_cursor)
816B 11 A3 84     	        LD DE,frame_buffer
816E 06 1C        	        LD B,28
                 	read_frame_byte:
8170 7E           	        LD A,(HL)
8171 12           	        LD (DE),A
8172 13           	        INC DE
8173 23           	        INC HL
8174 7C           	        LD A,H
8175 B5           	        OR L
8176 20 0D        	        JR NZ,read_frame_continue
8178 C5           	        PUSH BC
8179 3E 07        	        LD A,7
817B 32 72 84     	        LD (input_bank),A
817E CD 54 81     	        CALL page
8181 C1           	        POP BC
8182 21 00 C0     	        LD HL,0xC000
                 	read_frame_continue:
8185 10 E9        	        DJNZ read_frame_byte
8187 22 6E 84     	        LD (input_cursor),HL
818A 2A 70 84     	        LD HL,(input_left)
818D 11 1C 00     	        LD DE,28
8190 B7           	        OR A
8191 ED 52        	        SBC HL,DE
8193 22 70 84     	        LD (input_left),HL
8196 3A 74 84     	        LD A,(output_bank)
8199 C3 54 81     	        JP page
                 	
                 	select_output:
819C 2A 77 84     	        LD HL,(section_cursor)
819F 7E           	        LD A,(HL)
81A0 32 74 84     	        LD (output_bank),A
81A3 23           	        INC HL
81A4 5E           	        LD E,(HL)
81A5 23           	        INC HL
81A6 56           	        LD D,(HL)
81A7 23           	        INC HL
81A8 22 77 84     	        LD (section_cursor),HL
81AB ED 53 75 84  	        LD (output_cursor),DE
81AF FE 07        	        CP 7
81B1 20 1E        	        JR NZ,output_selected
81B3 CD 54 81     	        CALL page
81B6 2A 6E 84     	        LD HL,(input_cursor)
81B9 11 00 A0     	        LD DE,0xA000
81BC ED 4B 70 84  	        LD BC,(input_left)
81C0 78           	        LD A,B
81C1 B1           	        OR C
81C2 28 02        	        JR Z,tail_copied
81C4 ED B0        	        LDIR                  ; <=6144 bytes, before bank7 overwrites input
                 	tail_copied:
81C6 21 00 A0     	        LD HL,0xA000
81C9 22 6E 84     	        LD (input_cursor),HL
81CC 3E 01        	        LD A,1
81CE 32 73 84     	        LD (input_fixed),A
                 	output_selected:
81D1 3A 74 84     	        LD A,(output_bank)
81D4 C3 54 81     	        JP page
                 	
                 	; Build two 256-byte pages t[x] = floor(k * signed8(x) /128).
                 	; DE=k, A=low-byte page. Incremental quotient/remainder is exact for negatives.
                 	; Each table consumes512 temporary bytes, reused for every frame.
                 	build_table:
81D7 32 7C 84     	        LD (table_page),A
81DA 7B           	        LD A,E
81DB E6 7F        	        AND 127
81DD 32 7D 84     	        LD (table_remainder_step),A
81E0 D5           	        PUSH DE
81E1 EB           	        EX DE,HL
81E2 CD 2C 82     	        CALL sar7
81E5 22 7E 84     	        LD (table_step),HL
81E8 D1           	        POP DE
81E9 21 00 00     	        LD HL,0
81EC B7           	        OR A
81ED ED 52        	        SBC HL,DE             ; quotient at signed input-128 equals-k
81EF EB           	        EX DE,HL
81F0 3A 7C 84     	        LD A,(table_page)
81F3 67           	        LD H,A
81F4 2E 80        	        LD L,128
81F6 3A 7D 84     	        LD A,(table_remainder_step)
81F9 4F           	        LD C,A
81FA 06 00        	        LD B,0                ; 256 entries, signed index128..255,0..127
81FC AF           	        XOR A
                 	table_loop:
81FD 73           	        LD (HL),E
81FE 24           	        INC H
81FF 72           	        LD (HL),D
8200 25           	        DEC H
8201 E5           	        PUSH HL
8202 2A 7E 84     	        LD HL,(table_step)
8205 19           	        ADD HL,DE
8206 EB           	        EX DE,HL
8207 E1           	        POP HL
8208 81           	        ADD A,C
8209 F2 0F 82     	        JP P,table_no_carry
820C E6 7F        	        AND 127
820E 13           	        INC DE
                 	table_no_carry:
820F 2C           	        INC L
8210 10 EB        	        DJNZ table_loop
8212 C9           	        RET
                 	
                 	; HL signed input, A=table low page -> HL approximate Q15 product.
                 	; Preserves BC; destroys DE/AF. Error from split-byte flooring is <2 units.
                 	mul_table:
8213 C5           	        PUSH BC
8214 47           	        LD B,A
8215 4D           	        LD C,L
8216 6C           	        LD L,H
8217 60           	        LD H,B
8218 5E           	        LD E,(HL)
8219 24           	        INC H
821A 56           	        LD D,(HL)
821B D5           	        PUSH DE
821C 79           	        LD A,C
821D CB 3F        	        SRL A
821F 6F           	        LD L,A
8220 60           	        LD H,B
8221 5E           	        LD E,(HL)
8222 24           	        INC H
8223 56           	        LD D,(HL)
8224 EB           	        EX DE,HL
8225 CD 2C 82     	        CALL sar7
8228 D1           	        POP DE
8229 19           	        ADD HL,DE
822A C1           	        POP BC
822B C9           	        RET
822C CB 25        	sar7:   SLA L
822E CB 14        	        RL H
8230 6C           	        LD L,H
8231 9F           	        SBC A,A
8232 67           	        LD H,A
8233 C9           	        RET
                 	clip_hl:
8234 7C           	        LD A,H
8235 CB 7F        	        BIT 7,A
8237 20 07        	        JR NZ,clip_negative
8239 FE 40        	        CP 0x40
823B D8           	        RET C
823C 21 FF 3F     	        LD HL,0x3FFF
823F C9           	        RET
                 	clip_negative:
8240 FE C0        	        CP 0xC0
8242 D0           	        RET NC
8243 21 00 C0     	        LD HL,0xC000
8246 C9           	        RET
                 	
                 	synth_sample:
8247 2A 80 84     	        LD HL,(noise_seed)
824A CB 3C        	        SRL H
824C CB 1D        	        RR L
824E 30 04        	        JR NC,noise_shifted
8250 7C           	        LD A,H
8251 EE B4        	        XOR 0xB4
8253 67           	        LD H,A
                 	noise_shifted:
8254 22 80 84     	        LD (noise_seed),HL
8257 7C           	        LD A,H
8258 EE 80        	        XOR 128
825A 6F           	        LD L,A
825B 26 74        	        LD H,0x74
825D 5E           	        LD E,(HL)
825E 24           	        INC H
825F 56           	        LD D,(HL)
8260 ED 53 85 84  	        LD (forward),DE
8264 2A 82 84     	        LD HL,(pitch_phase)
8267 11 00 01     	        LD DE,256
826A B7           	        OR A
826B ED 52        	        SBC HL,DE
826D 30 09        	        JR NC,pitch_ready
826F ED 5B B7 84  	        LD DE,(frame_buffer+20)
8273 19           	        ADD HL,DE
8274 AF           	        XOR A
8275 32 84 84     	        LD (chirp_index),A
                 	pitch_ready:
8278 22 82 84     	        LD (pitch_phase),HL
827B 3A 84 84     	        LD A,(chirp_index)
827E FE 0F        	        CP 15
8280 30 20        	        JR NC,excitation_ready
8282 6F           	        LD L,A
8283 26 00        	        LD H,0
8285 11 CA 84     	        LD DE,chirp_signs
8288 19           	        ADD HL,DE
8289 3C           	        INC A
828A 32 84 84     	        LD (chirp_index),A
828D 7E           	        LD A,(HL)
828E B7           	        OR A
828F 2A B9 84     	        LD HL,(frame_buffer+22)
8292 28 03        	        JR Z,chirp_ready
8294 2A BB 84     	        LD HL,(frame_buffer+24)
                 	chirp_ready:
8297 ED 5B 85 84  	        LD DE,(forward)
829B 19           	        ADD HL,DE
829C CD 34 82     	        CALL clip_hl
829F 22 85 84     	        LD (forward),HL
                 	excitation_ready:
82A2 DD 21 9F 84  	        LD IX,history+18
82A6 0E 72        	        LD C,0x72
82A8 06 0A        	        LD B,10
                 	lattice_loop:
82AA DD 6E 00     	        LD L,(IX+0)
82AD DD 66 01     	        LD H,(IX+1)
82B0 79           	        LD A,C
82B1 CD 13 82     	        CALL mul_table
82B4 EB           	        EX DE,HL
82B5 2A 85 84     	        LD HL,(forward)
82B8 B7           	        OR A
82B9 ED 52        	        SBC HL,DE
82BB CD 34 82     	        CALL clip_hl
82BE 22 85 84     	        LD (forward),HL
82C1 79           	        LD A,C
82C2 CD 13 82     	        CALL mul_table
82C5 DD 5E 00     	        LD E,(IX+0)
82C8 DD 56 01     	        LD D,(IX+1)
82CB 19           	        ADD HL,DE
82CC CD 34 82     	        CALL clip_hl
82CF DD 75 02     	        LD (IX+2),L
82D2 DD 74 03     	        LD (IX+3),H
82D5 DD 2B        	        DEC IX
82D7 DD 2B        	        DEC IX
82D9 0D           	        DEC C
82DA 0D           	        DEC C
82DB 10 CD        	        DJNZ lattice_loop
82DD 2A 85 84     	        LD HL,(forward)
82E0 22 8D 84     	        LD (history),HL
82E3 2A 87 84     	        LD HL,(deemphasis)
82E6 3E 76        	        LD A,0x76
82E8 CD 13 82     	        CALL mul_table
82EB ED 5B 85 84  	        LD DE,(forward)
82EF 19           	        ADD HL,DE
82F0 CD 34 82     	        CALL clip_hl
82F3 22 87 84     	        LD (deemphasis),HL
82F6 ED 5B 8B 84  	        LD DE,(previous_output)
82FA 22 8B 84     	        LD (previous_output),HL
82FD B7           	        OR A
82FE ED 52        	        SBC HL,DE
8300 CD 34 82     	        CALL clip_hl
8303 ED 5B 89 84  	        LD DE,(dc_state)
8307 19           	        ADD HL,DE
8308 CD 34 82     	        CALL clip_hl
830B 5A           	        LD E,D               ; signed previous DC state >>8
830C 7A           	        LD A,D
830D 87           	        ADD A,A
830E 9F           	        SBC A,A
830F 57           	        LD D,A
8310 B7           	        OR A
8311 ED 52        	        SBC HL,DE
8313 CD 34 82     	        CALL clip_hl
8316 22 89 84     	        LD (dc_state),HL
8319 06 05        	        LD B,5
                 	pcm_shift:
831B CB 2C        	        SRA H
831D CB 1D        	        RR L
831F 10 FA        	        DJNZ pcm_shift
8321 7C           	        LD A,H
8322 B7           	        OR A
8323 28 0B        	        JR Z,pcm_positive
8325 3C           	        INC A
8326 20 10        	        JR NZ,pcm_low
8328 7D           	        LD A,L
8329 FE 81        	        CP 129
832B 38 0B        	        JR C,pcm_low
832D C6 80        	        ADD A,128
832F C9           	        RET
                 	pcm_positive:
8330 7D           	        LD A,L
8331 FE 80        	        CP 128
8333 30 06        	        JR NC,pcm_high
8335 C6 80        	        ADD A,128
8337 C9           	        RET
8338 3E 01        	pcm_low: LD A,1
833A C9           	        RET
833B 3E FF        	pcm_high: LD A,255
833D C9           	        RET
                 	
                 	; A=PCM8. IMA state persists across LPC frames and RAM bank boundaries.
                 	emit_pcm:
833E CD AA 83     	        CALL encode_ima
8341 4F           	        LD C,A
8342 3A C4 84     	        LD A,(half_byte)
8345 EE 01        	        XOR 1
8347 32 C4 84     	        LD (half_byte),A
834A 28 05        	        JR Z,emit_packed
834C 79           	        LD A,C
834D 32 C3 84     	        LD (pending_nibble),A
8350 C9           	        RET
                 	emit_packed:
8351 79           	        LD A,C
8352 07           	        RLCA
8353 07           	        RLCA
8354 07           	        RLCA
8355 07           	        RLCA
8356 21 C3 84     	        LD HL,pending_nibble
8359 B6           	        OR (HL)
835A 2A 75 84     	        LD HL,(output_cursor)
                 	ima_byte_ready:
835D 77           	        LD (HL),A
835E 23           	        INC HL
835F 22 75 84     	        LD (output_cursor),HL
8362 E5           	        PUSH HL
8363 2A C5 84     	        LD HL,(produced)
8366 23           	        INC HL
8367 22 C5 84     	        LD (produced),HL
836A 7C           	        LD A,H
836B B5           	        OR L
836C 20 07        	        JR NZ,produced_ready
836E 3A C7 84     	        LD A,(produced+2)
8371 3C           	        INC A
8372 32 C7 84     	        LD (produced+2),A
                 	produced_ready:
8375 CD 85 83     	        CALL update_unpack_progress
8378 E1           	        POP HL
8379 7C           	        LD A,H
837A B5           	        OR L
837B C0           	        RET NZ
837C 3A 6D 84     	        LD A,(unpack_progress)
837F FE 20        	        CP 32
8381 C8           	        RET Z                 ; last bank ended; do not read another section
8382 C3 9C 81     	        JP select_output
                 	
                 	update_unpack_progress:
8385 2A C8 84     	        LD HL,(unpack_threshold_cursor)
8388 ED 5B C5 84  	        LD DE,(produced)
838C 7B           	        LD A,E
838D BE           	        CP (HL)
838E C0           	        RET NZ
838F 23           	        INC HL
8390 7A           	        LD A,D
8391 BE           	        CP (HL)
8392 C0           	        RET NZ
8393 23           	        INC HL
8394 3A C7 84     	        LD A,(produced+2)
8397 BE           	        CP (HL)
8398 C0           	        RET NZ
8399 23           	        INC HL
839A 22 C8 84     	        LD (unpack_threshold_cursor),HL
839D 3A 6D 84     	        LD A,(unpack_progress)
83A0 6F           	        LD L,A
83A1 26 5A        	        LD H,0x5A
83A3 36 64        	        LD (HL),0x64
83A5 3C           	        INC A
83A6 32 6D 84     	        LD (unpack_progress),A
                 	unpack_progress_event:
83A9 C9           	        RET
                 	
83AA              	QUANTIZE: MACRO
83AA              	        OR A
83AA              	        SBC HL,DE
83AA              	        JR C,quant_skip_\0
83AA              	        PUSH HL
83AA              	        LD H,B
83AA              	        LD L,C
83AA              	        ADD HL,DE
83AA              	        LD B,H
83AA              	        LD C,L
83AA              	        POP HL
83AA              	        LD A,(ima_code)
83AA              	        OR \0
83AA              	        LD (ima_code),A
83AA              	        JR quant_done_\0
83AA              	quant_skip_\0: ASSERT 1
83AA              	        ADD HL,DE
83AA              	quant_done_\0: ASSERT 1
83AA              	        ENDM
                 	encode_ima:
83AA 67           	        LD H,A
83AB 2E 00        	        LD L,0
83AD ED 5B BF 84  	        LD DE,(ima_predictor)
83B1 B7           	        OR A
83B2 ED 52        	        SBC HL,DE
83B4 3E 00        	        LD A,0
