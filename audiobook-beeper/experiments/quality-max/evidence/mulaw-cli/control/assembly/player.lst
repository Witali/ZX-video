                 	
                 	; G.711 mu-law bytes stay compressed in banked RAM. Inverse companding
                 	; is pipelined one sample ahead through two 256-byte lookup planes.
                 	; Main HL: 16-bit modulo error, DE: unsigned decoded level, BC: 10FE.
                 	; Alternate BC: source cursor, HL: lookup cursor, DE: next level.
                 	; SP transfers just one level (two bytes); no expanded PCM/PDM buffer.
                 	; DI throughout playback. No calls and no input-dependent pulse branches.
                 	
8000              	first_address: EQU 49152
8000              	first_end_high: EQU 224
8000              	progress_first: EQU 1
8000              	        INCLUDE "config.inc"
8000              	        ORG 0x8000
8000              	LOAD_AUDIO: MACRO
8000              	        LD BC,0x7FFD
8000              	        LD A,\0+24
8000              	        OUT (C),A
8000              	        LD (load_bank),A
8000              	        LD DE,\1
8000              	        LD HL,\2
8000              	        LD B,\3
8000              	        CALL read_n
8000              	        ENDM
8000              	SILENCE: MACRO
8000              	        LD BC,0xFFFD
8000              	        LD A,\0
8000              	        OUT (C),A
8000              	        LD BC,0xBFFD
8000              	        XOR A
8000              	        OUT (C),A
8000              	        ENDM
8000 F3           	start:  DI
8001 31 00 60     	        LD SP,0x6000
8004 FD 21 3A 5C  	        LD IY,0x5C3A
8008 ED 56        	        IM 1
800A AF           	        XOR A
800B D3 FE        	        OUT (0xFE),A
800D 21 00 88     	        LD HL,screen_data
8010 11 00 40     	        LD DE,0x4000
8013 01 00 1B     	        LD BC,6912
8016 ED B0        	        LDIR
8018 01 FD 7F     	        LD BC,0x7FFD
801B 3E 1F        	        LD A,31
801D ED 79        	        OUT (C),A
801F 21 00 40     	        LD HL,0x4000
8022 11 00 C0     	        LD DE,0xC000
8025 01 00 1B     	        LD BC,6912
8028 ED B0        	        LDIR
802A 21 00 D8     	        LD HL,0xD800
802D 06 60        	        LD B,96
                 	show_loading:
802F 36 47        	        LD (HL),0x47
8031 2C           	        INC L
8032 10 FB        	        DJNZ show_loading
8034 21 A0 D8     	        LD HL,0xD8A0
8037 06 20        	        LD B,32
                 	show_progress:
8039 36 08        	        LD (HL),0x08
803B 2C           	        INC L
803C 10 FB        	        DJNZ show_progress
                 	loading_visible:
803E FB           	        EI
                 	
803F 01 FD 7F     		LD BC,0x7FFD
8042 3E 18        		LD A,0+24
8044 ED 79        		OUT (C),A
8046 32 91 81     		LD (load_bank),A
8049 11 04 03     		LD DE,772
804C 21 00 C0     		LD HL,49152
804F 06 20        		LD B,32
8051 CD 34 81     		CALL read_n
8054              	        LOAD_AUDIO 0,772,49152,32
8054              	        INCLUDE "loads.inc"
8054 F3           	        DI
8055 01 FD 7F     	        LD BC,0x7FFD
8058 3E 1F        	        LD A,31
805A ED 79        	        OUT (C),A
805C 21 00 D8     	        LD HL,0xD800
805F 06 60        	        LD B,96
                 	hide_loading:
8061 36 00        	        LD (HL),0
8063 2C           	        INC L
8064 10 FB        	        DJNZ hide_loading
8066 21 A0 D8     	        LD HL,0xD8A0
8069 06 20        	        LD B,32
                 	hide_progress:
806B 36 00        	        LD (HL),0
806D 2C           	        INC L
806E 10 FB        	        DJNZ hide_progress
                 	loading_hidden:
8070 01 FD FF     		LD BC,0xFFFD
8073 3E 08        		LD A,8
8075 ED 79        		OUT (C),A
8077 01 FD BF     		LD BC,0xBFFD
807A AF           		XOR A
807B ED 79        		OUT (C),A
807D              	        SILENCE 8
807D 01 FD FF     		LD BC,0xFFFD
8080 3E 09        		LD A,9
8082 ED 79        		OUT (C),A
8084 01 FD BF     		LD BC,0xBFFD
8087 AF           		XOR A
8088 ED 79        		OUT (C),A
808A              	        SILENCE 9
808A 01 FD FF     		LD BC,0xFFFD
808D 3E 0A        		LD A,10
808F ED 79        		OUT (C),A
8091 01 FD BF     		LD BC,0xBFFD
8094 AF           		XOR A
8095 ED 79        		OUT (C),A
8097              	        SILENCE 10
8097 01 FD 7F     	        LD BC,0x7FFD
809A 3E 18        	        LD A,24
809C ED 79        	        OUT (C),A
809E FB           	        EI
809F 76           	        HALT
80A0 F3           	        DI
80A1 31 00 88     	ready:  LD SP,0x8800
80A4 01 00 C0     	        LD BC,first_address
80A7 0A           	        LD A,(BC)
80A8 03           	        INC BC
80A9 6F           	        LD L,A
80AA 26 85        	        LD H,levels >> 8
80AC 5E           	        LD E,(HL)
80AD 24           	        INC H
80AE 56           	        LD D,(HL)
80AF 25           	        DEC H
80B0 D5           	        PUSH DE
80B1 DD 21 1E 81  	        LD IX,bank_tail_0
80B5 D9           	        EXX
80B6 D1           	        POP DE
80B7 21 00 80     	        LD HL,32768
80BA 01 FE 10     	        LD BC,0x10FE
                 	; One exact 16-bit first-order decision takes 34 T: ADD 11, SBC 4,
                 	; AND 7, OUT 12. Carry is consumed immediately. The table retains all
                 	; decoded bits, including small G.711 levels near silence.
80BD              	PULSE: MACRO
80BD              	        ASSERT \0 >= 0
80BD              	        ADD HL,DE
80BD              	        SBC A,A
80BD              	        AND 16
80BD              	out_\0: OUT (C),A
80BD              	        ENDM
                 	sample:
80BD              		ASSERT 0 >= 0
80BD 19           		ADD HL,DE
80BE 9F           		SBC A,A
80BF E6 10        		AND 16
80C1 ED 79        	out_0:	OUT (C),A
80C3              	        PULSE 0
80C3 D9           	        EXX
80C4 0A           	        LD A,(BC)
80C5 6F           	        LD L,A
80C6 D9           	        EXX                    ; 19 T prefetch: next compact code
80C7              		ASSERT 1 >= 0
80C7 19           		ADD HL,DE
80C8 9F           		SBC A,A
80C9 E6 10        		AND 16
80CB ED 79        	out_1:	OUT (C),A
80CD              	        PULSE 1
80CD D9           	        EXX
80CE 5E           	        LD E,(HL)
80CF 24           	        INC H
80D0 D9           	        EXX                    ; 19 T: next low decoded byte
80D1              		ASSERT 2 >= 0
80D1 19           		ADD HL,DE
80D2 9F           		SBC A,A
80D3 E6 10        		AND 16
80D5 ED 79        	out_2:	OUT (C),A
80D7              	        PULSE 2
80D7 D9           	        EXX
80D8 56           	        LD D,(HL)
80D9 25           	        DEC H
80DA D9           	        EXX                    ; 19 T: next high decoded byte
80DB              		ASSERT 3 >= 0
80DB 19           		ADD HL,DE
80DC 9F           		SBC A,A
80DD E6 10        		AND 16
80DF ED 79        	out_3:	OUT (C),A
80E1              	        PULSE 3
80E1 D9           	        EXX
80E2 D5           	        PUSH DE
80E3 D9           	        EXX                    ; 19 T: stage two bytes, not the audio
80E4              		ASSERT 4 >= 0
80E4 19           		ADD HL,DE
80E5 9F           		SBC A,A
80E6 E6 10        		AND 16
80E8 ED 79        	out_4:	OUT (C),A
80EA              	        PULSE 4
80EA D9           	        EXX
80EB 0C           	        INC C
80EC CA 12 81     	        JP Z,advance_page
                 	resume_cursor:
80EF D9           	        EXX                    ; ordinary cursor update: 22 T
80F0              		ASSERT 5 >= 0
80F0 19           		ADD HL,DE
80F1 9F           		SBC A,A
80F2 E6 10        		AND 16
80F4 ED 79        	out_5:	OUT (C),A
80F6              	        PULSE 5
80F6 3E 00        	        LD A,0
80F8 3E 00        	        LD A,0
80FA 3E 00        	        LD A,0                 ; 21 T padding; flags/data irrelevant
80FC              		ASSERT 6 >= 0
80FC 19           		ADD HL,DE
80FD 9F           		SBC A,A
80FE E6 10        		AND 16
8100 ED 79        	out_6:	OUT (C),A
8102              	        PULSE 6
8102 3E 00        	        LD A,0
8104 3E 00        	        LD A,0
8106 3E 00        	        LD A,0                 ; 21 T padding
8108              		ASSERT 7 >= 0
8108 19           		ADD HL,DE
8109 9F           		SBC A,A
810A E6 10        		AND 16
810C ED 79        	out_7:	OUT (C),A
810E              	        PULSE 7
810E D1           	        POP DE
810F C3 BD 80     	        JP sample              ; 20 T; current level changes only here
                 	; Page check happens after prefetch, one sample before a section ends.
                 	; This also handles bank 5's C000..DBFF range without touching TR-DOS.
                 	advance_page:
8112 04           	        INC B
8113 78           	        LD A,B
                 	end_page_compare:
8114 FE E0        	        CP first_end_high
8116 CA 1C 81     	        JP Z,bank_dispatch
8119 C3 EF 80     	        JP resume_cursor
                 	bank_dispatch:
811C DD E9        	        JP (IX)
                 	; Alternate registers are active here. Preserve lookup H/L; replace only
                 	; the input cursor, paging latch, terminal high byte and next tail target.
811E              	BANK_TAIL: MACRO
811E              	bank_tail_\0: ASSERT 1
811E              	        LD BC,0x7FFD
811E              	        LD A,\1+24
811E              	page_\0: OUT (C),A
811E              	        LD BC,\2
811E              	        LD IX,bank_tail_\3
811E              	        LD A,\4
811E              	        LD (end_page_compare+1),A
811E              	        JP resume_cursor
811E              	        ENDM
                 	
811E              	bank_tail_0:	ASSERT 1
811E 01 FD 7F     		LD BC,0x7FFD
8121 3E 18        		LD A,0+24
8123 ED 79        	page_0:	OUT (C),A
8125 01 00 C0     		LD BC,49152
8128 DD 21 1E 81  		LD IX,bank_tail_0
812C 3E E0        		LD A,224
812E 32 15 81     		LD (end_page_compare+1),A
8131 C3 EF 80     		JP resume_cursor
