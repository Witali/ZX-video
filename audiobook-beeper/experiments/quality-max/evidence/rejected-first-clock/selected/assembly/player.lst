8000              	SILENCE: MACRO
8000              	        LD BC,0xFFFD
8000              	        LD A,\0
8000              	        OUT (C),A
8000              	        LD BC,0xBFFD
8000              	        XOR A
8000              	        OUT (C),A
8000              	        ENDM
