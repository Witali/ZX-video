B440              	        IF chained_playback
                 	chain_exit:
B440              	        IF extended_ram
B440 F3           	        DI
B441 31 00 60     	        LD SP,0x6000
B444 FD 21 3A 5C  	        LD IY,0x5C3A
B448 ED 56        	        IM 1
B44A AF           	        XOR A
B44B D3 FE        	        OUT (0xFE),A
B44D 01 FD 7F     	        LD BC,0x7FFD
B450 3E 1F        	        LD A,31
B452 ED 79        	        OUT (C),A
B454 21 00 DB     	        LD HL,0xDB00
B457 11 00 40     	        LD DE,0x4000
B45A CD 6C BC     	        CALL DecompressLZSA2
B45D 21 01 00     	        LD HL,chain_volume
B460 3E 01        	        LD A,chain_next_slot
B462 C3 0B 40     	        JP 0x400B
B465              	        ELSE
B465              	        DI
B465              	        LD SP,0x6000
B465              	        LD IY,0x5C3A
B465              	        IM 1
B465              	        XOR A
B465              	        OUT (0xFE),A
                 	        ; Playback is over. Disable the exhausted progress counter while
                 	        ; reusing the loader to replace bank-5 tables with the controller.
B465              	        LD A,0xC9
B465              	        LD (update_progress),A
                 	chain_retry:
B465              	        LD BC,0x7FFD
B465              	        LD A,31
B465              	        OUT (C),A
B465              	        LD DE,chain_disk
B465              	        LD HL,0x4000
B465              	        LD B,chain_sectors
B465              	        EI
B465              	        CALL read_n
B465              	        DI
B465              	        LD HL,(0x4003)           ; refuse an unrelated disk's machine code
B465              	        LD DE,0x4D49            ; first two bytes of IMA3CHN1
B465              	        OR A
B465              	        SBC HL,DE
B465              	        JR NZ,chain_retry
B465              	        LD HL,chain_volume
B465              	        LD A,chain_next_slot
B465              	        JP 0x400B              ; fixed warm entry, after the signature
B465              	        ENDIF
B465              	        ENDIF
                 	resident_end:
B465              	        ASSERT $ <= 0x8000+resident_reserve
B465              	        IF extended_ram
B465              	        ASSERT $ <= 0xB800
B465              	        DS 0xB800-$
                 	
                 	; Loading-only extended-RAM cache, included in both transient controller and
                 	; fixed bank2. CACHE_STATE occupies16 unused packet-page bytes at5B70; callers
                 	; independently prove <=18 feedback entries (108 bytes) in each half-page.
                 	; All disk operations use a fixed-bank bounce buffer: TR-DOS is never asked
                 	; to preserve an extended7FFD/1FFD mapping. No cache code runs during PDM.
B800              	CACHE_STATE: EQU 0x5B70
B800              	cache_mode: EQU CACHE_STATE+2       ; 0=128,1=Scorpion,2=Pentagon512,3=Pentagon1024
B800              	cache_pages: EQU CACHE_STATE+3      ; distinct extra16-KiB pages,0/8/24/56
B800              	cache_start: EQU CACHE_STATE+4      ; linear first disk sector in this window
B800              	cache_count: EQU CACHE_STATE+6      ; number of valid cached256-byte sectors
B800              	cache_bar: EQU CACHE_STATE+8
B800              	cache_progress_enabled: EQU CACHE_STATE+9
B800              	cache_fraction: EQU CACHE_STATE+10
B800              	cache_total: EQU CACHE_STATE+12
B800              	cache_volume: EQU CACHE_STATE+14
                 	
                 	; A=physical RAM page,0..63. BC/DE/AF clobbered; HL preserved.
                 	; Shadow screen and48K ROM stay selected. Bit5 is never used on a512K
                 	; device: only the reversible EFF7 alias test may authorize the1024 mapping.
                 	cache_map:
B800 5F           	        LD E,A
B801 3A 72 5B     	        LD A,(cache_mode)
B804 FE 01        	        CP 1
B806 20 10        	        JR NZ,cache_map_pentagon
B808 7B           	        LD A,E
B809 E6 08        	        AND 8
B80B 87           	        ADD A,A
B80C 01 FD 1F     	        LD BC,0x1FFD
B80F ED 79        	        OUT (C),A
B811 7B           	        LD A,E
B812 E6 07        	        AND 7
B814 F6 18        	        OR 24
B816 18 12        	        JR cache_map_output
                 	cache_map_pentagon:
B818 7B           	        LD A,E
B819 E6 18        	        AND 24
B81B 07           	        RLCA
B81C 07           	        RLCA
B81D 07           	        RLCA
B81E 57           	        LD D,A
B81F 7B           	        LD A,E
B820 E6 20        	        AND 32
B822 B2           	        OR D
B823 57           	        LD D,A
B824 7B           	        LD A,E
B825 E6 07        	        AND 7
B827 F6 18        	        OR 24
B829 B2           	        OR D
                 	cache_map_output:
B82A 01 FD 7F     	        LD BC,0x7FFD
B82D ED 79        	        OUT (C),A
B82F C9           	        RET
                 	
                 	; A=normal paging byte. Clear Scorpion's high RAM bit before returning to
                 	; ordinary banks; preserve AF'/IY and use no ROM while high RAM is paged.
                 	cache_restore:
B830 5F           	        LD E,A
B831 3A 72 5B     	        LD A,(cache_mode)
B834 FE 01        	        CP 1
B836 20 06        	        JR NZ,cache_restore_low
B838 AF           	        XOR A
B839 01 FD 1F     	        LD BC,0x1FFD
B83C ED 79        	        OUT (C),A
                 	cache_restore_low:
B83E 7B           	        LD A,E
B83F 01 FD 7F     	        LD BC,0x7FFD
B842 ED 79        	        OUT (C),A
B844 C9           	        RET
                 	
                 	; Test two physical page selectors without destroying either original byte.
                 	; Private ref/candidate fields are outside paged RAM. Z=alias,NZ=distinct.
                 	; Even when both selectors alias, both saved originals are identical because
                 	; they are captured before either test write. Interrupts must be disabled.
                 	cache_alias:
B845 3A 1D BB     	        LD A,(cache_ref)
B848 CD 00 B8     	        CALL cache_map
B84B 3A 00 C0     	        LD A,(0xC000)
B84E 32 20 BB     	        LD (cache_ref_byte),A
B851 3A 1E BB     	        LD A,(cache_candidate)
B854 CD 00 B8     	        CALL cache_map
B857 3A 00 C0     	        LD A,(0xC000)
B85A 32 21 BB     	        LD (cache_candidate_byte),A
B85D 3A 1D BB     	        LD A,(cache_ref)
B860 CD 00 B8     	        CALL cache_map
B863 3E 55        	        LD A,0x55
B865 32 00 C0     	        LD (0xC000),A
B868 3A 1E BB     	        LD A,(cache_candidate)
B86B CD 00 B8     	        CALL cache_map
B86E 3E AA        	        LD A,0xAA
B870 32 00 C0     	        LD (0xC000),A
B873 3A 1D BB     	        LD A,(cache_ref)
B876 CD 00 B8     	        CALL cache_map
B879 3A 00 C0     	        LD A,(0xC000)
B87C FE 55        	        CP 0x55
B87E 3E 00        	        LD A,0
B880 20 01        	        JR NZ,cache_alias_saved
B882 3C           	        INC A
                 	cache_alias_saved:
B883 32 22 BB     	        LD (cache_distinct),A
B886 3A 1E BB     	        LD A,(cache_candidate)
B889 CD 00 B8     	        CALL cache_map
B88C 3A 21 BB     	        LD A,(cache_candidate_byte)
B88F 32 00 C0     	        LD (0xC000),A
B892 3A 1D BB     	        LD A,(cache_ref)
B895 CD 00 B8     	        CALL cache_map
B898 3A 20 BB     	        LD A,(cache_ref_byte)
B89B 32 00 C0     	        LD (0xC000),A
B89E 3A 22 BB     	        LD A,(cache_distinct)
B8A1 B7           	        OR A
B8A2 C9           	        RET
                 	
                 	; Cold initialization: probe Scorpion1FFD first, then safe Pentagon bits6/7.
                 	; EFF7 bit2 temporarily removes Pentagon1024 high RAM bits without asserting
                 	; 7FFD's lock bit. A512K machine ignores it and remains distinct. Verify every
                 	; candidate against all earlier pages, so mirrored expansion cannot inflate
                 	; the reported capacity. Every probe restores original RAM and normal paging.
                 	cache_detect:
B8A3 F3           	        DI
B8A4 AF           	        XOR A
B8A5 21 70 5B     	        LD HL,CACHE_STATE
B8A8 11 71 5B     	        LD DE,CACHE_STATE+1
B8AB 01 0F 00     	        LD BC,15
B8AE 77           	        LD (HL),A
B8AF ED B0        	        LDIR
B8B1 32 1D BB     	        LD (cache_ref),A
B8B4 3E 08        	        LD A,8
B8B6 32 1E BB     	        LD (cache_candidate),A
B8B9 3E 01        	        LD A,1
B8BB 32 72 5B     	        LD (cache_mode),A
B8BE CD 45 B8     	        CALL cache_alias
B8C1 20 2E        	        JR NZ,cache_detect_scorpion
B8C3 3E 18        	        LD A,24
B8C5 CD 30 B8     	        CALL cache_restore
B8C8 3E 02        	        LD A,2
B8CA 32 72 5B     	        LD (cache_mode),A
B8CD CD 45 B8     	        CALL cache_alias
B8D0 28 55        	        JR Z,cache_detect_none
B8D2 01 F7 EF     	        LD BC,0xEFF7
B8D5 3E 04        	        LD A,4
B8D7 ED 79        	        OUT (C),A
B8D9 CD 45 B8     	        CALL cache_alias
B8DC F5           	        PUSH AF
B8DD 01 F7 EF     	        LD BC,0xEFF7
B8E0 AF           	        XOR A
B8E1 ED 79        	        OUT (C),A
B8E3 F1           	        POP AF
B8E4 3E 20        	        LD A,32
B8E6 20 0B        	        JR NZ,cache_detect_limit
B8E8 3E 03        	        LD A,3
B8EA 32 72 5B     	        LD (cache_mode),A
B8ED 3E 40        	        LD A,64
B8EF 18 02        	        JR cache_detect_limit
                 	cache_detect_scorpion:
B8F1 3E 10        	        LD A,16
                 	cache_detect_limit:
B8F3 32 1F BB     	        LD (cache_limit),A
B8F6 3E 08        	        LD A,8
B8F8 32 1E BB     	        LD (cache_candidate),A
                 	cache_detect_next:
B8FB AF           	        XOR A
B8FC 32 1D BB     	        LD (cache_ref),A
                 	cache_detect_reference:
B8FF CD 45 B8     	        CALL cache_alias
B902 28 27        	        JR Z,cache_detect_done
B904 3A 1D BB     	        LD A,(cache_ref)
B907 3C           	        INC A
B908 32 1D BB     	        LD (cache_ref),A
B90B 21 1E BB     	        LD HL,cache_candidate
B90E BE           	        CP (HL)
B90F 38 EE        	        JR C,cache_detect_reference
B911 3A 73 5B     	        LD A,(cache_pages)
B914 3C           	        INC A
B915 32 73 5B     	        LD (cache_pages),A
B918 3A 1E BB     	        LD A,(cache_candidate)
B91B 3C           	        INC A
B91C 32 1E BB     	        LD (cache_candidate),A
B91F 21 1F BB     	        LD HL,cache_limit
B922 BE           	        CP (HL)
B923 38 D6        	        JR C,cache_detect_next
B925 18 04        	        JR cache_detect_done
                 	cache_detect_none:
B927 AF           	        XOR A
B928 32 72 5B     	        LD (cache_mode),A
                 	cache_detect_done:
B92B 3E 18        	        LD A,24
B92D CD 30 B8     	        CALL cache_restore
B930 21 52 43     	        LD HL,0x4352            ; 'RC',little endian
B933 22 70 5B     	        LD (CACHE_STATE),HL
B936 C9           	        RET
                 	
                 	; DE=TR-DOS track/sector. Return HL=linear sector; AF/DE clobbered.
                 	cache_linear:
B937 26 00        	        LD H,0
B939 6A           	        LD L,D
B93A 29           	        ADD HL,HL
B93B 29           	        ADD HL,HL
B93C 29           	        ADD HL,HL
B93D 29           	        ADD HL,HL
B93E 16 00        	        LD D,0
B940 19           	        ADD HL,DE
B941 C9           	        RET
                 	
                 	; HL=zero-based cached sector, <3584. A=RAM page,HL=page-local source.
                 	cache_location:
B942 7C           	        LD A,H
B943 87           	        ADD A,A
B944 87           	        ADD A,A
B945 57           	        LD D,A
B946 7D           	        LD A,L
B947 07           	        RLCA
B948 07           	        RLCA
B949 E6 03        	        AND 3
B94B B2           	        OR D
B94C C6 08        	        ADD A,8
B94E 5F           	        LD E,A
B94F 7D           	        LD A,L
B950 E6 3F        	        AND 63
B952 F6 C0        	        OR 0xC0
B954 67           	        LD H,A
B955 2E 00        	        LD L,0
B957 7B           	        LD A,E
B958 C9           	        RET
                 	
                 	; A=normal destination paging,HL=destination,DE=track/sector.
                 	; Read one sector, using the cache only for a proved complete hit. Cached
                 	; transfers first copy to fixed bounce RAM, then restore destination paging.
                 	; Preserve the persistent state even when the destination is its table page.
                 	cache_read_sector:
B959 F3           	        DI
B95A 32 23 BB     	        LD (cache_destination_page),A
B95D 22 24 BB     	        LD (cache_destination),HL
B960 ED 53 26 BB  	        LD (cache_disk_address),DE
B964 21 70 5B     	        LD HL,CACHE_STATE
B967 11 32 BB     	        LD DE,cache_saved_state
B96A 01 10 00     	        LD BC,16
B96D ED B0        	        LDIR
B96F ED 5B 26 BB  	        LD DE,(cache_disk_address)
B973 CD 37 B9     	        CALL cache_linear
B976 ED 5B 74 5B  	        LD DE,(cache_start)
B97A B7           	        OR A
B97B ED 52        	        SBC HL,DE
B97D 38 2D        	        JR C,cache_read_rom
B97F E5           	        PUSH HL
B980 ED 5B 76 5B  	        LD DE,(cache_count)
B984 B7           	        OR A
B985 ED 52        	        SBC HL,DE
B987 E1           	        POP HL
B988 30 22        	        JR NC,cache_read_rom
B98A CD 42 B9     	        CALL cache_location
B98D CD 00 B8     	        CALL cache_map
B990 11 42 BB     	        LD DE,cache_bounce
B993 01 00 01     	        LD BC,256
B996 ED B0        	        LDIR
B998 3A 23 BB     	        LD A,(cache_destination_page)
B99B CD 30 B8     	        CALL cache_restore
B99E 21 42 BB     	        LD HL,cache_bounce
B9A1 ED 5B 24 BB  	        LD DE,(cache_destination)
B9A5 01 00 01     	        LD BC,256
B9A8 ED B0        	        LDIR
                 	cache_hit_event:
B9AA 18 14        	        JR cache_read_restored
                 	cache_read_rom:
B9AC 3A 23 BB     	        LD A,(cache_destination_page)
B9AF CD 30 B8     	        CALL cache_restore
B9B2 2A 24 BB     	        LD HL,(cache_destination)
B9B5 ED 5B 26 BB  	        LD DE,(cache_disk_address)
B9B9 01 05 01     	        LD BC,0x0105
B9BC FB           	        EI
                 	cache_physical_read:
B9BD CD 13 3D     	        CALL 0x3D13
                 	cache_read_restored:
B9C0 21 32 BB     	        LD HL,cache_saved_state
B9C3 11 70 5B     	        LD DE,CACHE_STATE
B9C6 01 10 00     	        LD BC,16
B9C9 ED B0        	        LDIR
B9CB FB           	        EI
B9CC C9           	        RET
                 	
                 	; HL=linear first future sector,DE=one-past-last sector on this volume.
                 	; Refill only after the previous window has been consumed. Read the complete
                 	; available window before audio, stopping at EOF rather than reading padding.
                 	; Each disk read targets fixed bounce RAM before its physical extra-page copy.
                 	cache_prefetch:
B9CD 22 28 BB     	        LD (cache_future),HL
B9D0 E5           	        PUSH HL
B9D1 2A 74 5B     	        LD HL,(cache_start)
B9D4 ED 4B 76 5B  	        LD BC,(cache_count)
B9D8 09           	        ADD HL,BC
B9D9 C1           	        POP BC
B9DA B7           	        OR A
B9DB ED 42        	        SBC HL,BC
B9DD 28 01        	        JR Z,cache_prefetch_empty
B9DF D0           	        RET NC                  ; some future sectors are still cached
                 	cache_prefetch_empty:
B9E0 01 00 00     	        LD BC,0
B9E3 ED 43 76 5B  	        LD (cache_count),BC      ; EOF/zero capacity must leave no stale window
B9E7 2A 28 BB     	        LD HL,(cache_future)
B9EA 22 74 5B     	        LD (cache_start),HL
B9ED EB           	        EX DE,HL
B9EE B7           	        OR A
B9EF ED 52        	        SBC HL,DE
B9F1 C8           	        RET Z
B9F2 D8           	        RET C
B9F3 3A 73 5B     	        LD A,(cache_pages)
B9F6 B7           	        OR A
B9F7 C8           	        RET Z
B9F8 47           	        LD B,A
B9F9 0E 00        	        LD C,0
B9FB CB 38        	        SRL B
B9FD CB 19        	        RR C
B9FF CB 38        	        SRL B
BA01 CB 19        	        RR C                    ; BC=pages*64
BA03 B7           	        OR A
BA04 ED 42        	        SBC HL,BC
BA06 30 03        	        JR NC,cache_prefetch_capacity
BA08 09           	        ADD HL,BC
BA09 44           	        LD B,H
BA0A 4D           	        LD C,L
                 	cache_prefetch_capacity:
BA0B ED 43 2A BB  	        LD (cache_fill_limit),BC
BA0F 21 00 00     	        LD HL,0
BA12 22 76 5B     	        LD (cache_count),HL
BA15 22 2C BB     	        LD (cache_fill_index),HL
                 	cache_fill_next:
BA18 2A 74 5B     	        LD HL,(cache_start)
BA1B ED 5B 2C BB  	        LD DE,(cache_fill_index)
BA1F 19           	        ADD HL,DE
BA20 7D           	        LD A,L
BA21 E6 0F        	        AND 15
BA23 5F           	        LD E,A
BA24 CB 3C        	        SRL H
BA26 CB 1D        	        RR L
BA28 CB 3C        	        SRL H
BA2A CB 1D        	        RR L
BA2C CB 3C        	        SRL H
BA2E CB 1D        	        RR L
BA30 CB 3C        	        SRL H
BA32 CB 1D        	        RR L
BA34 55           	        LD D,L
BA35 D5           	        PUSH DE
BA36 3E 18        	        LD A,24
BA38 CD 30 B8     	        CALL cache_restore
BA3B D1           	        POP DE
BA3C 21 42 BB     	        LD HL,cache_bounce
BA3F 01 05 01     	        LD BC,0x0105
BA42 FB           	        EI
                 	cache_prefetch_physical_read:
BA43 CD 13 3D     	        CALL 0x3D13
BA46 F3           	        DI
BA47 2A 2C BB     	        LD HL,(cache_fill_index)
BA4A CD 42 B9     	        CALL cache_location
BA4D E5           	        PUSH HL
BA4E CD 00 B8     	        CALL cache_map
BA51 D1           	        POP DE
BA52 21 42 BB     	        LD HL,cache_bounce
BA55 01 00 01     	        LD BC,256
BA58 ED B0        	        LDIR
BA5A 3E 18        	        LD A,24
BA5C CD 30 B8     	        CALL cache_restore
BA5F 2A 2C BB     	        LD HL,(cache_fill_index)
BA62 23           	        INC HL
BA63 22 2C BB     	        LD (cache_fill_index),HL
BA66 22 76 5B     	        LD (cache_count),HL
BA69 CD 7A BA     	        CALL cache_progress
                 	cache_prefetch_sector_done:
BA6C 2A 2C BB     	        LD HL,(cache_fill_index)
BA6F ED 4B 2A BB  	        LD BC,(cache_fill_limit)
BA73 B7           	        OR A
BA74 ED 42        	        SBC HL,BC
BA76 38 A0        	        JR C,cache_fill_next
BA78 FB           	        EI
BA79 C9           	        RET
                 	
                 	; Progress uses remainder arithmetic: add32 per completed sector and publish
                 	; one cell when remainder>=total. No approximation or early100% completion.
                 	; Caller supplies the actual logical loading+prefetch total before its reads.
                 	cache_progress:
BA7A 3A 79 5B     	        LD A,(cache_progress_enabled)
BA7D B7           	        OR A
BA7E C8           	        RET Z
BA7F 2A 7A 5B     	        LD HL,(cache_fraction)
BA82 11 20 00     	        LD DE,32
BA85 19           	        ADD HL,DE
BA86 ED 5B 7C 5B  	        LD DE,(cache_total)
BA8A B7           	        OR A
BA8B ED 52        	        SBC HL,DE
BA8D 30 05        	        JR NC,cache_progress_publish
BA8F 19           	        ADD HL,DE
BA90 22 7A 5B     	        LD (cache_fraction),HL
BA93 C9           	        RET
                 	cache_progress_publish:
BA94 22 7A 5B     	        LD (cache_fraction),HL
BA97 3A 78 5B     	        LD A,(cache_bar)
BA9A FE 20        	        CP 32
BA9C D0           	        RET NC
BA9D 3C           	        INC A
BA9E 32 78 5B     	        LD (cache_bar),A
                 	cache_progress_event:
BAA1 C3 A4 BA     	        JP cache_draw_bar
                 	
                 	; Loading-only UI: the shadow screen is bank7. Restore the caller's normal
                 	; destination page afterward. HL/DE/BC/AF are scratch; AF'/IX/IY untouched.
                 	cache_draw_bar:
BAA4 F3           	        DI
BAA5 3E 1F        	        LD A,31
BAA7 CD 30 B8     	        CALL cache_restore
BAAA 21 C0 DA     	        LD HL,0xDAC0
BAAD 3A 78 5B     	        LD A,(cache_bar)
BAB0 5F           	        LD E,A
BAB1 06 20        	        LD B,32
                 	cache_draw_cell:
BAB3 7B           	        LD A,E
BAB4 B7           	        OR A
BAB5 3E 04        	        LD A,4
BAB7 28 03        	        JR Z,cache_draw_empty
BAB9 1D           	        DEC E
BABA 3E 24        	        LD A,0x24
                 	cache_draw_empty:
BABC 77           	        LD (HL),A
BABD 23           	        INC HL
BABE 10 F3        	        DJNZ cache_draw_cell
BAC0 3A 23 BB     	        LD A,(cache_destination_page)
BAC3 CD 30 B8     	        CALL cache_restore
BAC6 FB           	        EI
BAC7 C9           	        RET
                 	
                 	; HL=current record start,DE=record end. Include any newly needed prefetch
                 	; in the exact progress denominator; an existing unconsumed window is free.
                 	cache_begin_progress:
BAC8 22 2E BB     	        LD (cache_record_start),HL
BACB ED 53 28 BB  	        LD (cache_future),DE
BACF EB           	        EX DE,HL
BAD0 B7           	        OR A
BAD1 ED 52        	        SBC HL,DE
BAD3 22 7C 5B     	        LD (cache_total),HL
BAD6 2A 74 5B     	        LD HL,(cache_start)
BAD9 ED 5B 76 5B  	        LD DE,(cache_count)
BADD 19           	        ADD HL,DE
BADE ED 5B 28 BB  	        LD DE,(cache_future)
BAE2 B7           	        OR A
BAE3 ED 52        	        SBC HL,DE
BAE5 38 02        	        JR C,cache_begin_fill
BAE7 20 23        	        JR NZ,cache_begin_ready
                 	cache_begin_fill:
BAE9 2A 30 BB     	        LD HL,(cache_disk_end)
BAEC B7           	        OR A
BAED ED 52        	        SBC HL,DE
BAEF 3A 73 5B     	        LD A,(cache_pages)
BAF2 47           	        LD B,A
BAF3 0E 00        	        LD C,0
BAF5 CB 38        	        SRL B
BAF7 CB 19        	        RR C
BAF9 CB 38        	        SRL B
BAFB CB 19        	        RR C
BAFD B7           	        OR A
BAFE ED 42        	        SBC HL,BC
BB00 30 03        	        JR NC,cache_begin_capacity
BB02 09           	        ADD HL,BC
BB03 44           	        LD B,H
BB04 4D           	        LD C,L
                 	cache_begin_capacity:
BB05 2A 7C 5B     	        LD HL,(cache_total)
BB08 09           	        ADD HL,BC
BB09 22 7C 5B     	        LD (cache_total),HL
                 	cache_begin_ready:
BB0C AF           	        XOR A
BB0D 32 78 5B     	        LD (cache_bar),A
BB10 21 00 00     	        LD HL,0
BB13 22 7A 5B     	        LD (cache_fraction),HL
BB16 3C           	        INC A
BB17 32 79 5B     	        LD (cache_progress_enabled),A
BB1A C3 A4 BA     	        JP cache_draw_bar
                 	
BB1D 00           	cache_ref: DEFB 0
BB1E 08           	cache_candidate: DEFB 8
BB1F 00           	cache_limit: DEFB 0
BB20 00           	cache_ref_byte: DEFB 0
BB21 00           	cache_candidate_byte: DEFB 0
BB22 00           	cache_distinct: DEFB 0
BB23 18           	cache_destination_page: DEFB 24
BB24 00 00        	cache_destination: DEFW 0
BB26 00 00        	cache_disk_address: DEFW 0
BB28 00 00        	cache_future: DEFW 0
BB2A 00 00        	cache_fill_limit: DEFW 0
BB2C 00 00        	cache_fill_index: DEFW 0
BB2E 00 00        	cache_record_start: DEFW 0
BB30 00 00        	cache_disk_end: DEFW 0
BB32              	cache_saved_state: DEFS 16
BB42              	cache_bounce: DEFS 256
                 	cache_code_end:
BC42              	        INCLUDE "ram-cache.asm"
                 	; Clone pacing preserves all main/alternate registers and the lookup SP.
                 	; Standard128 keeps JP(IY); redirect JP adds10 T, Pentagon entry two NOPs.
                 	hardware_delay:
BC42 00           	        NOP
BC43 00           	        NOP
BC44 00           	        NOP
BC45 00           	        NOP
BC46 FD E9        	        JP (IY)
                 	patch_hardware_timing:
BC48 3A 72 5B     	        LD A,(cache_mode)
BC4B B7           	        OR A
BC4C C8           	        RET Z
BC4D FE 01        	        CP 1
BC4F 11 44 BC     	        LD DE,hardware_delay+2
BC52 20 03        	        JR NZ,patch_pentagon
BC54 C9           	        RET                     ; Scorpion retains the128-style ULA-paced path
BC55 00           	        NOP                     ; retain all addresses in the fixed worker
BC56 00           	        NOP
                 	patch_pentagon:
BC57 21 2C 84     	        LD HL,first_base+first_size-3
BC5A 06 6F        	        LD B,first_patterns
                 	patch_first:
BC5C 36 C3        	        LD (HL),0xC3
BC5E 23           	        INC HL
BC5F 73           	        LD (HL),E
BC60 23           	        INC HL
BC61 72           	        LD (HL),D
BC62 7D           	        LD A,L
BC63 C6 2D        	        ADD A,first_size-2
BC65 6F           	        LD L,A
BC66 30 01        	        JR NC,patch_first_next
BC68 24           	        INC H
                 	patch_first_next:
BC69 10 F1        	        DJNZ patch_first
BC6B C9           	        RET
BC6C              	        IF chained_playback
                 	
                 	; Syntax-adapted forward LZSA2 decoder; original default instructions.
                 	;
                 	;  Speed-optimized LZSA2 decompressor by spke & uniabis (210 bytes)
                 	;
                 	;  ver.00 by spke for LZSA 1.0.0 (02-07/06/2019, 218 bytes);
                 	;  ver.01 by spke for LZSA 1.0.5 (24/07/2019, added support for backward decompression);
                 	;  ver.02 by spke for LZSA 1.0.6 (27/07/2019, fixed a bug in the backward decompressor);
                 	;  ver.03 by uniabis (30/07/2019, 213(-5) bytes, +3.8% speed and support for Hitachi HD64180);
                 	;  ver.04 by spke for LZSA 1.0.7 (01/08/2019, 214(+1) bytes, +0.2% speed and small re-organization of macros);
                 	;  ver.05 by spke (27/08/2019, 216(+2) bytes, +1.1% speed);
                 	;  ver.06 by spke for LZSA 1.1.0 (26/09/2019, added full revision history);
                 	;  ver.07 by spke for LZSA 1.1.1 (10/10/2019, +0.2% speed and an option for unrolled copying of long matches);
                 	;  ver.08 by spke (07-08/04/2022, 210(-6) bytes, +1.7% speed, using self-modifying code by default)
                 	;
                 	;  The data must be compressed using the command line compressor by Emmanuel Marty
                 	;  The compression is done as follows:
                 	;
                 	;  lzsa.exe -f2 -r <sourcefile> <outfile>
                 	;
                 	;  where option -r asks for the generation of raw (frame-less) data.
                 	;
                 	;  The decompression is done in the standard way:
                 	;
                 	;  ld hl,FirstByteOfCompressedData
                 	;  ld de,FirstByteOfMemoryForDecompressedData
                 	;  call DecompressLZSA2
                 	;
                 	;  Backward compression is also supported; you can compress files backward using:
                 	;
                 	;  lzsa.exe -f2 -r -b <sourcefile> <outfile>
                 	;
                 	;  and decompress the resulting files using:
                 	;
                 	;  ld hl,LastByteOfCompressedData
                 	;  ld de,LastByteOfMemoryForDecompressedData
                 	;  call DecompressLZSA2
                 	;
                 	;  (do not forget to uncomment the BACKWARD_DECOMPRESS option in the decompressor).
                 	;
                 	;  Of course, LZSA2 compression algorithms are (c) 2019 Emmanuel Marty,
                 	;  see https://github.com/emmanuel-marty/lzsa for more information
                 	;
                 	;  Drop me an email if you have any comments/ideas/suggestions: zxintrospec@gmail.com
                 	;
                 	;  This software is provided 'as-is', without any express or implied
                 	;  warranty.  In no event will the authors be held liable for any damages
                 	;  arising from the use of this software.
                 	;
                 	;  Permission is granted to anyone to use this software for any purpose,
                 	;  including commercial applications, and to alter it and redistribute it
                 	;  freely, subject to the following restrictions:
                 	;
                 	;  1. The origin of this software must not be misrepresented; you must not
                 	;     claim that you wrote the original software. If you use this software
                 	;     in a product, an acknowledgment in the product documentation would be
                 	;     appreciated but is not required.
                 	;  2. Altered source versions must be plainly marked as such, and must not be
                 	;     misrepresented as being the original software.
                 	;  3. This notice may not be removed or altered from any source distribution.
                 	;	DEFINE	UNROLL_LONG_MATCHES						; uncomment for faster decompression of very compressible data (+38 bytes)
                 	;	DEFINE	BACKWARD_DECOMPRESS						; uncomment for data compressed with option -b (+5 bytes, -3.2% speed)
                 			; HL = DE - HL
                 	DecompressLZSA2:
BC6C 06 00        	        ld b,0
BC6E 37           	        scf
BC6F 08           	        EX AF,AF'
BC70 18 65        	        jr ReadToken
                 	ManyLiterals:
BC72 3E 12        	        ld a,18
BC74 86           	        ADD A,(HL)
BC75 23           	        INC HL
BC76 30 1C        	        jr nc,CopyMoreLiterals
BC78 4E           	        ld c,(hl)
BC79 23           	        INC HL
BC7A 78           	        ld a,b
BC7B 46           	        ld b,(hl)
BC7C 18 64        	        jr ReadToken_NEXTHLuseBC
                 	MoreLiterals:
BC7E 46           	        ld b,(hl)
BC7F 23           	        INC HL
BC80 37           	        scf
BC81 08           	        EX AF,AF'
BC82 30 09        	        jr nc,MoreLiterals_noUpdate
BC84 7E           	        ld a,(hl)
BC85 B7           	        or a
BC86 08           	        EX AF,AF'
BC87 7E           	        ld a,(hl)
BC88 23           	        INC HL
