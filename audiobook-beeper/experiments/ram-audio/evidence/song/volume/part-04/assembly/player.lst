B94B B2           	        OR D
B94C C6 08        	        ADD A,8
B94E 5F           	        LD E,A
B94F 7D           	        LD A,L
B950 E6 3F        	        AND 63
B952 F6 C0        	        OR 0xC0
B954 67           	        LD H,A
B955 2E 00        	        LD L,0
B957 7B           	        LD A,E
