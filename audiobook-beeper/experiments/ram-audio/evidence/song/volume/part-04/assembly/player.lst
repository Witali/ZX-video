22 40 B3 3D 27 80 B2 63 FD C0 B5 28 F8 C0 B5 EC F2 C0 B5 B1 ED C0 B5 75 E8 C0 B4 3A E3 00 B4 FE DD 40 B3 C3 D8 80 B2 60 02 40 B6 21 07 40 B6 E3 0B 40 B6 A4 10 40 B6 67 15 40 B5 28 1A 80 B4 EA 1E C0 B3 AB 23 C0 B2 A0 FD 40 B6 DF F8 40 B6 1D F4 40 B6 5C EF 40 B6 99 EA 40 B5 D8 E5 80 B4 16 E1 C0 B3 55 DC C0 B2 FF 0F 00 B5 FE 2F 00 B5 FE 4F 00 B5 FD 6F 00 B5 FE 8F 00 B6 FD AF 00 B6 FD CF 00 B6 FC EF 00 B6 01 F0 00 B5 02 D0 00 B5 02 B0 00 B5 03 90 00 B5 02 70 00 B6 03 50 00 B6 03 30 00 B6 04 10 00 B6 29 02 80 B6 7C 06 80 B6 CF 0A 80 B6 22 0F 80 B6 75 13 80 B5 C8 17 C0 B4 1B 1C 00 B4 6E 20 40 B3 D7 FD 80 B6 84 F9 80 B6 31 F5 80 B6 DE F0 80 B6 8B EC 80 B5 38 E8 C0 B4 E5 E3 00 B4 92 DF 40 B3 F7 01 C0 B6 E5 05 C0 B6 D4 09 C0 B6 C2 0D C0 B6 B1 11 C0 B5 9F 15 40 B5 8E 19 80 B4 7C 1D C0 B3 09 FE C0 B6 1B FA C0 B6 2C F6 C0 B6 3E F2 C0 B6 4F EE C0 B5 61 EA 40 B5 72 E6 80 B4 84 E2 C0 B3 C9 01 00 B7 5C 05 00 B7 EF 08 00 B7 82 0C 00 B7 15 10 40 B6 A8 13 80 B5 3B 17 C0 B4 CE 1A 00 B4 37 FE 00 B7 A4 FA 00 B7 11 F7 00 B7 7E F3 00 B7 EB EF 40 B6 58 EC 80 B5 C5 E8 C0 B4 32 E5 00 B4 9F 01 C0 63 DE 04 C0 63 1E 08 C0 63 5D 0B C0 63 9E 0E 80 B6 DD 11 C0 B5 1D 15 40 B5 5C 18 80 B4 61 FE C0 63 22 FB C0 63 E2 F7 C0 63 A3 F4 C0 63 62 F1 80 B6 23 EE C0 B5 E3 EA 40 B5 A4 E7 80 B4 	        MDAT "decoder-extra.bin"
B740              	        IF chained_playback
                 	chain_exit:
B740              	        IF extended_ram
B740 F3           	        DI
B741 31 00 60     	        LD SP,0x6000
B744 FD 21 3A 5C  	        LD IY,0x5C3A
B748 ED 56        	        IM 1
B74A AF           	        XOR A
B74B D3 FE        	        OUT (0xFE),A
B74D 01 FD 7F     	        LD BC,0x7FFD
B750 3E 1F        	        LD A,31
B752 ED 79        	        OUT (C),A
B754 21 00 DB     	        LD HL,0xDB00
B757 11 00 40     	        LD DE,0x4000
B75A CD 65 BC     	        CALL DecompressLZSA2
B75D 21 01 00     	        LD HL,chain_volume
B760 3E 04        	        LD A,chain_next_slot
B762 C3 0B 40     	        JP 0x400B
B765              	        ELSE
                 	        ; Final silent-guard entry; no live register inputs, all clobbered.
                 	        ; Restore the TR-DOS stack/IY/interrupt mode, then reload a transient
                 	        ; controller over obsolete PDM tables. This routine does not return.
B765              	        DI
B765              	        LD SP,0x6000
B765              	        LD IY,0x5C3A
B765              	        IM 1
B765              	        XOR A
B765              	        OUT (0xFE),A
                 	        ; Playback is over. Disable the exhausted progress counter while
                 	        ; reusing the loader to replace bank-5 tables with the controller.
B765              	        LD A,0xC9
B765              	        LD (update_progress),A
                 	chain_retry:
B765              	        LD BC,0x7FFD
B765              	        LD A,31
B765              	        OUT (C),A
B765              	        LD DE,chain_disk
B765              	        LD HL,0x4000
B765              	        LD B,chain_sectors
B765              	        EI
B765              	        CALL read_n
B765              	        DI
B765              	        LD HL,(0x4003)           ; refuse an unrelated disk's machine code
B765              	        LD DE,0x4D49            ; first two bytes of IMA3CHN1
B765              	        OR A
B765              	        SBC HL,DE
B765              	        JR NZ,chain_retry
B765              	        LD HL,chain_volume
B765              	        LD A,chain_next_slot
B765              	        JP 0x400B              ; fixed warm entry, after the signature
B765              	        ENDIF
B765              	        ENDIF
                 	resident_end:
B765              	        ASSERT $ <= 0x8000+resident_reserve
B765              	        IF extended_ram
B765              	        ASSERT $ <= 0xB800
B765              	        DS 0xB800-$
                 	
                 	; Loading-only extended-RAM cache, included in both transient controller and
                 	; fixed bank2. CACHE_STATE occupies16 unused packet-page bytes at5B70; callers
                 	; independently prove <=18 feedback entries (108 bytes) in each half-page.
                 	; All disk operations use a fixed-bank bounce buffer: TR-DOS is never asked
                 	; to preserve an extended7FFD/1FFD mapping. No cache code runs during PDM.
B800              	CACHE_STATE: EQU 0x5B70
B800              	cache_mode: EQU CACHE_STATE+2       ; 0=128,1=Scorpion,2=Pentagon512,3=Pentagon1024
B800              	cache_pages: EQU CACHE_STATE+3      ; distinct extra16-KiB pages,0/8/24/56
B800              	cache_start: EQU CACHE_STATE+4      ; linear first disk sector in this window
B800              	cache_count: EQU CACHE_STATE+6      ; number of valid cached256-byte sectors
B800              	cache_bar: EQU CACHE_STATE+8
B800              	cache_progress_enabled: EQU CACHE_STATE+9
B800              	cache_fraction: EQU CACHE_STATE+10
B800              	cache_total: EQU CACHE_STATE+12
B800              	cache_volume: EQU CACHE_STATE+14
                 	
                 	; A=physical RAM page,0..63. BC/DE/AF clobbered; HL preserved.
                 	; Shadow screen and48K ROM stay selected. Bit5 is never used on a512K
                 	; device: only the reversible EFF7 alias test may authorize the1024 mapping.
                 	cache_map:
B800 5F           	        LD E,A
B801 3A 72 5B     	        LD A,(cache_mode)
B804 FE 01        	        CP 1
B806 20 10        	        JR NZ,cache_map_pentagon
B808 7B           	        LD A,E
B809 E6 08        	        AND 8
B80B 87           	        ADD A,A
B80C 01 FD 1F     	        LD BC,0x1FFD
B80F ED 79        	        OUT (C),A
B811 7B           	        LD A,E
B812 E6 07        	        AND 7
B814 F6 18        	        OR 24
B816 18 12        	        JR cache_map_output
                 	cache_map_pentagon:
B818 7B           	        LD A,E
B819 E6 18        	        AND 24
B81B 07           	        RLCA
B81C 07           	        RLCA
B81D 07           	        RLCA
B81E 57           	        LD D,A
B81F 7B           	        LD A,E
B820 E6 20        	        AND 32
B822 B2           	        OR D
B823 57           	        LD D,A
B824 7B           	        LD A,E
B825 E6 07        	        AND 7
B827 F6 18        	        OR 24
B829 B2           	        OR D
                 	cache_map_output:
B82A 01 FD 7F     	        LD BC,0x7FFD
B82D ED 79        	        OUT (C),A
B82F C9           	        RET
                 	
                 	; A=normal paging byte. Clear Scorpion's high RAM bit before returning to
                 	; ordinary banks; preserve AF'/IY and use no ROM while high RAM is paged.
                 	cache_restore:
B830 5F           	        LD E,A
B831 3A 72 5B     	        LD A,(cache_mode)
B834 FE 01        	        CP 1
B836 20 06        	        JR NZ,cache_restore_low
B838 AF           	        XOR A
B839 01 FD 1F     	        LD BC,0x1FFD
B83C ED 79        	        OUT (C),A
                 	cache_restore_low:
B83E 7B           	        LD A,E
B83F 01 FD 7F     	        LD BC,0x7FFD
B842 ED 79        	        OUT (C),A
B844 C9           	        RET
                 	
                 	; Test two physical page selectors without destroying either original byte.
                 	; Private ref/candidate fields are outside paged RAM. Z=alias,NZ=distinct.
                 	; Even when both selectors alias, both saved originals are identical because
                 	; they are captured before either test write. Interrupts must be disabled.
                 	cache_alias:
B845 3A 16 BB     	        LD A,(cache_ref)
B848 CD 00 B8     	        CALL cache_map
B84B 3A 00 C0     	        LD A,(0xC000)
B84E 32 19 BB     	        LD (cache_ref_byte),A
B851 3A 17 BB     	        LD A,(cache_candidate)
B854 CD 00 B8     	        CALL cache_map
B857 3A 00 C0     	        LD A,(0xC000)
B85A 32 1A BB     	        LD (cache_candidate_byte),A
B85D 3A 16 BB     	        LD A,(cache_ref)
B860 CD 00 B8     	        CALL cache_map
B863 3E 55        	        LD A,0x55
B865 32 00 C0     	        LD (0xC000),A
B868 3A 17 BB     	        LD A,(cache_candidate)
B86B CD 00 B8     	        CALL cache_map
B86E 3E AA        	        LD A,0xAA
B870 32 00 C0     	        LD (0xC000),A
B873 3A 16 BB     	        LD A,(cache_ref)
B876 CD 00 B8     	        CALL cache_map
B879 3A 00 C0     	        LD A,(0xC000)
B87C FE 55        	        CP 0x55
B87E 3E 00        	        LD A,0
B880 20 01        	        JR NZ,cache_alias_saved
B882 3C           	        INC A
                 	cache_alias_saved:
B883 32 1B BB     	        LD (cache_distinct),A
B886 3A 17 BB     	        LD A,(cache_candidate)
B889 CD 00 B8     	        CALL cache_map
B88C 3A 1A BB     	        LD A,(cache_candidate_byte)
B88F 32 00 C0     	        LD (0xC000),A
B892 3A 16 BB     	        LD A,(cache_ref)
B895 CD 00 B8     	        CALL cache_map
B898 3A 19 BB     	        LD A,(cache_ref_byte)
B89B 32 00 C0     	        LD (0xC000),A
B89E 3A 1B BB     	        LD A,(cache_distinct)
B8A1 B7           	        OR A
B8A2 C9           	        RET
                 	
                 	; Cold initialization: probe Scorpion1FFD first, then safe Pentagon bits6/7.
                 	; EFF7 bit2 temporarily removes Pentagon1024 high RAM bits without asserting
                 	; 7FFD's lock bit. A512K machine ignores it and remains distinct. Verify every
                 	; candidate against all earlier pages, so mirrored expansion cannot inflate
                 	; the reported capacity. Every probe restores original RAM and normal paging.
                 	cache_detect:
B8A3 F3           	        DI
B8A4 AF           	        XOR A
B8A5 21 70 5B     	        LD HL,CACHE_STATE
B8A8 11 71 5B     	        LD DE,CACHE_STATE+1
B8AB 01 0F 00     	        LD BC,15
B8AE 77           	        LD (HL),A
B8AF ED B0        	        LDIR
B8B1 32 16 BB     	        LD (cache_ref),A
B8B4 3E 08        	        LD A,8
B8B6 32 17 BB     	        LD (cache_candidate),A
B8B9 3E 01        	        LD A,1
B8BB 32 72 5B     	        LD (cache_mode),A
B8BE CD 45 B8     	        CALL cache_alias
B8C1 20 2E        	        JR NZ,cache_detect_scorpion
B8C3 3E 18        	        LD A,24
