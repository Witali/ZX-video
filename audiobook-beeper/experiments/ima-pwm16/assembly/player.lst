                 	; Macro arguments: page base, label prefix, nibble (0=low/1=high),
                 	; and stage (0=table decode/1=quantize and publish).
8151              	CELL:   MACRO
8151              	        ASSERT $ <= \0
8151              	        DS \0-$
8151              	\1_ramp_high: ASSERT 1
8151              	        DS 15                   ; 0..15 NOPs: 0..60 T
8151              	\1_fall: DB 0xED,0x71         ; OUT (C),0: 12 T, NMOS Z80 (pyz80 lacks mnemonic)
8151              	        XOR 79                  ; 7: complementary low-ramp address, CY=0
8151              	        LD L,A                  ; 4
8151              	        JP (HL)                 ; 4
8151              	        DS \0+64-$
8151              	\1_ramp_low: ASSERT 1
8151              	        DS 15                   ; complementary NOP count; total always15
8151              	        IF \3 == 0
8151              	        EXX                     ; 4
8151              	        POP BC                  ; 10: signed modular delta
8151              	        POP HL                  ; 10: clean next state row
8151              	\1_state: ADD IX,BC            ; 15: host-proven no saturation needed
8151              	        EXX                     ; 4
8151              	        XOR 79                  ; 7: restore old width q; total low work50
                 	        ; JP adds10 T: low work60 T in both stages.
8151              	        JP \1_next
8151              	        ELSE
8151              	        JP \1_publish          ; 10: match the first-stage low work60 T
8151              	\1_publish: ASSERT 1
8151              	        LD A,IYL                ; 8: publish the new sample's width
8151              	        IF \2 == 1
8151              	        INC E                   ; 4: move input only after high nibble
8151              	        JP NZ,\1_address_ok    ; 10
8151              	        INC D                   ; 4
8151              	        JP Z,bank_dispatch      ; 10: bank handled while output is low
8151              	        NOP                     ; 4
8151              	        JP low_first            ; 10: page path low work50 T
8151              	\1_address_ok: ASSERT 1
8151              	        EXX                     ; 4: harmless padding, preserves main DE
8151              	        EXX                     ; 4
8151              	        JP \1_address_next     ; 10
8151              	\1_address_next: ASSERT 1
8151              	        JP low_first            ; 10: normal path low work50 T
8151              	        ELSE
8151              	        DS 8                    ; 32 T, AF and predictor unchanged
8151              	        JP high_first           ; 10: low-nibble path low work50 T
8151              	        ENDIF
8151              	        ENDIF
8151              	        ASSERT $ <= \0+128
8151              	        DS \0+128-$
8151              	\1: ASSERT 1
8151              	        LD H,\0 >> 8           ; 7: page-specific NOP ladder
8151              	        LD L,A                  ; 4: L saves q while decoder uses A
8151              	\1_rise: OUT (C),B             ; 12: B=16, EAR high, MIC/border low
8151              	        IF \3 == 0
8151              	        LD A,(DE)               ; 7
8151              	        IF \2 == 0
8151              	        AND 15                  ; 7
8151              	        RLCA                    ; 4
8151              	        RLCA                    ; 4
8151              	        ELSE
8151              	        AND 240                 ; 7
8151              	        RRCA                    ; 4
8151              	        RRCA                    ; 4
8151              	        ENDIF
8151              	        EXX                     ; 4
8151              	        OR L                    ; 4
8151              	        LD L,A                  ; 4
8151              	        LD SP,HL                ; 6
8151              	        EXX                     ; 4
8151              	        LD A,L                  ; 4: restore q from main L
8151              	        NOP                     ; 4: high work52 T
8151              	        ELSE
8151              	        LD A,IXH                ; 8: top eight bits of full IMA predictor
8151              	        CPL                     ; 4: invert for descending high-ramp length
8151              	        RRCA                    ; 4
8151              	        RRCA                    ; 4
8151              	        RRCA                    ; 4
8151              	        RRCA                    ; 4
8151              	        AND 15                  ; 7: quantize to16 pulse widths
8151              	        LD IYL,A                ; 8: candidate; current width still in main L
8151              	        LD A,L                  ; 4: restore q; AND15 cleared carry
8151              	        RET C                   ; 5: NEVER taken; high work52 T
8151              	        ENDIF
8151              	        JP (HL)                 ; 4
8151              	        ENDM
                 	
8151              	BANK_TAIL: MACRO
8151              	bank_tail_\0: ASSERT 1
8151              	        LD BC,0x7FFD            ; 10
8151              	        LD A,\1+16             ; 7
8151              	page_\0: OUT (C),A             ; 12
