8000              	        ORG 0x8000
                 	
8000              	LOAD_BANK: MACRO
8000              	        LD BC,0x7FFD
8000              	        LD A,\0+16
8000              	        OUT (C),A
8000              	        LD DE,\1
8000              	        LD (disk_position),DE
8000              	        LD HL,\2
8000              	        LD B,\3
8000              	        CALL read_n
8000              	        ENDM
                 	
8000              	SILENCE_AY: MACRO
8000              	        LD BC,0xFFFD
8000              	        LD A,\0
8000              	        OUT (C),A
8000              	        LD BC,0xBFFD
8000              	        XOR A
8000              	        OUT (C),A
8000              	        ENDM
                 	
