                 	
                 	; Full-input CPU probe: VQ7x512 (or predictive VQ7) -> PCM8 -> IMA nibbles.
                 	; This is not a release player. Port01 is a test sink, not a sound output.
                 	; IMA arithmetic is assembled from the separately maintained LPC prototype.
                 	; It is identical to that baseline, allowing its cost to be measured directly.
                 	; Alternate HL=vector, DE=input cursor, C=high index bits, B=predictor.
                 	; IYH=samples left in vector, IYL=indices left in high-bit header.
                 	
8000              	predictive: EQU 0
8000              	first_segment_samples: EQU 55680
8000              	segment_count: EQU 3
8000              	        INCLUDE "vq-config.inc"
8000              	        ORG 0x8000
8000 F3           	start:  DI
8001 31 F0 5F     	        LD SP,0x5FF0
8004 DD 21 80 D9  	        LD IX,first_segment_samples
8008 FD 21 01 01  	        LD IY,0x0101
800C 3E 13        	        LD A,19
800E 01 FD 7F     	        LD BC,0x7FFD
8011 ED 79        	        OUT (C),A
8013 D9           	        EXX
8014 11 00 C0     	        LD DE,0xC000
8017 06 80        	        LD B,128
8019 D9           	        EXX
                 	sample_loop:
801A CD 45 80     	        CALL next_pcm
                 	pcm_ready:
801D CD 83 80     	        CALL encode_ima
                 	ima_ready:
8020 D3 01        	        OUT (1),A
8022 DD 2B        	        DEC IX
8024 DD 7C        	        LD A,IXH
8026 DD B5        	        OR IXL
8028 C2 1A 80     	        JP NZ,sample_loop
802B 3A 40 81     	        LD A,(segments_left)
802E 3D           	        DEC A
802F 32 40 81     	        LD (segments_left),A
8032 C2 1A 80     	        JP NZ,sample_loop    ; IX=0 deliberately counts another 65536 samples
8035 06 80        	        LD B,128
                 	guard_loop:
8037 C5           	        PUSH BC
8038 3E 80        	        LD A,128
                 	guard_pcm_ready:
803A CD 83 80     	        CALL encode_ima
                 	guard_ima_ready:
803D D3 01        	        OUT (1),A
803F C1           	        POP BC
8040 10 F5        	        DJNZ guard_loop
                 	complete:
8042 C3 42 80     	        JP complete
                 	
                 	next_pcm:
8045 D9           	        EXX
8046 FD 25        	        DEC IYH
8048 20 21        	        JR NZ,have_vector
804A FD 26 07     	        LD IYH,7
804D FD 2D        	        DEC IYL
804F 20 07        	        JR NZ,have_header
8051 CD 6F 80     	        CALL read_byte
8054 4F           	        LD C,A
8055 FD 2E 08     	        LD IYL,8
                 	have_header:
8058 CD 6F 80     	        CALL read_byte
805B 6F           	        LD L,A
805C 26 00        	        LD H,0
805E 29           	        ADD HL,HL
805F 29           	        ADD HL,HL
8060 29           	        ADD HL,HL
8061 7C           	        LD A,H
8062 F6 90        	        OR 0x90
8064 67           	        LD H,A
8065 CB 39        	        SRL C
8067 30 02        	        JR NC,low_half
8069 CB DC        	        SET 3,H
                 	low_half:
806B              	        IF predictive
806B              	        LD A,(last_pcm)
806B              	        SRL A
806B              	        ADD A,64
806B              	        LD B,A
806B              	        ENDIF
                 	have_vector:
806B 7E           	        LD A,(HL)
806C 2C           	        INC L               ; seven values fit inside an aligned eight-byte row
806D              	        IF predictive
806D              	        ADD A,B             ; PC encoder rejects all overflowing vectors
806D              	        LD (last_pcm),A
806D              	        ENDIF
806D D9           	        EXX
806E C9           	        RET
                 	
                 	read_byte:
806F 1A           	        LD A,(DE)
8070 13           	        INC DE
8071 CB 7A        	        BIT 7,D
8073 C0           	        RET NZ
8074 F5           	        PUSH AF
8075 C5           	        PUSH BC
8076 3E 17        	        LD A,23
8078 01 FD 7F     	        LD BC,0x7FFD
807B ED 79        	        OUT (C),A
807D 11 00 C0     	        LD DE,0xC000
8080 C1           	        POP BC
8081 F1           	        POP AF
8082 C9           	        RET
                 	
                 	
8083              	QUANTIZE: MACRO
8083              	        OR A
8083              	        SBC HL,DE
8083              	        JR C,quant_skip_\0
8083              	        PUSH HL
8083              	        LD H,B
8083              	        LD L,C
8083              	        ADD HL,DE
8083              	        LD B,H
8083              	        LD C,L
8083              	        POP HL
8083              	        LD A,(ima_code)
8083              	        OR \0
8083              	        LD (ima_code),A
8083              	        JR quant_done_\0
8083              	quant_skip_\0: ASSERT 1
8083              	        ADD HL,DE
8083              	quant_done_\0: ASSERT 1
8083              	        ENDM
                 	encode_ima:
8083 67           	        LD H,A
8084 2E 00        	        LD L,0
8086 ED 5B 42 81  	        LD DE,(ima_predictor)
808A B7           	        OR A
808B ED 52        	        SBC HL,DE
808D 3E 00        	        LD A,0
808F 30 09        	        JR NC,ima_magnitude
8091 EB           	        EX DE,HL
8092 21 00 00     	        LD HL,0
8095 B7           	        OR A
8096 ED 52        	        SBC HL,DE
8098 3E 08        	        LD A,8
                 	ima_magnitude:
809A 32 45 81     	        LD (ima_code),A
809D E5           	        PUSH HL
809E 3A 44 81     	        LD A,(ima_index)
80A1 87           	        ADD A,A
80A2 6F           	        LD L,A
80A3 26 A0        	        LD H,steps >> 8
80A5 5E           	        LD E,(HL)
80A6 2C           	        INC L
80A7 56           	        LD D,(HL)
80A8 42           	        LD B,D
80A9 4B           	        LD C,E
80AA CB 38        	        SRL B
80AC CB 19        	        RR C
80AE CB 38        	        SRL B
80B0 CB 19        	        RR C
80B2 CB 38        	        SRL B
80B4 CB 19        	        RR C
80B6 E1           	        POP HL
80B7 B7           		OR A
80B8 ED 52        		SBC HL,DE
80BA 38 11        		JR C,quant_skip_4
80BC E5           		PUSH HL
80BD 60           		LD H,B
80BE 69           		LD L,C
80BF 19           		ADD HL,DE
80C0 44           		LD B,H
80C1 4D           		LD C,L
80C2 E1           		POP HL
80C3 3A 45 81     		LD A,(ima_code)
80C6 F6 04        		OR 4
80C8 32 45 81     		LD (ima_code),A
80CB 18 01        		JR quant_done_4
80CD              	quant_skip_4:	ASSERT 1
80CD 19           		ADD HL,DE
80CE              	quant_done_4:	ASSERT 1
80CE              	        QUANTIZE 4
80CE CB 3A        	        SRL D
80D0 CB 1B        	        RR E
80D2 B7           		OR A
80D3 ED 52        		SBC HL,DE
80D5 38 11        		JR C,quant_skip_2
80D7 E5           		PUSH HL
80D8 60           		LD H,B
80D9 69           		LD L,C
80DA 19           		ADD HL,DE
80DB 44           		LD B,H
80DC 4D           		LD C,L
80DD E1           		POP HL
80DE 3A 45 81     		LD A,(ima_code)
80E1 F6 02        		OR 2
80E3 32 45 81     		LD (ima_code),A
80E6 18 01        		JR quant_done_2
80E8              	quant_skip_2:	ASSERT 1
80E8 19           		ADD HL,DE
80E9              	quant_done_2:	ASSERT 1
80E9              	        QUANTIZE 2
80E9 CB 3A        	        SRL D
80EB CB 1B        	        RR E
80ED B7           		OR A
80EE ED 52        		SBC HL,DE
80F0 38 11        		JR C,quant_skip_1
80F2 E5           		PUSH HL
80F3 60           		LD H,B
80F4 69           		LD L,C
80F5 19           		ADD HL,DE
80F6 44           		LD B,H
80F7 4D           		LD C,L
80F8 E1           		POP HL
80F9 3A 45 81     		LD A,(ima_code)
80FC F6 01        		OR 1
80FE 32 45 81     		LD (ima_code),A
8101 18 01        		JR quant_done_1
8103              	quant_skip_1:	ASSERT 1
8103 19           		ADD HL,DE
8104              	quant_done_1:	ASSERT 1
8104              	        QUANTIZE 1
8104 2A 42 81     	        LD HL,(ima_predictor)
8107 3A 45 81     	        LD A,(ima_code)
810A CB 5F        	        BIT 3,A
810C 28 05        	        JR Z,ima_add
810E B7           	        OR A
810F ED 42        	        SBC HL,BC
8111 18 01        	        JR ima_updated
                 	ima_add:
8113 09           	        ADD HL,BC
                 	ima_updated:
8114 22 42 81     	        LD (ima_predictor),HL
8117 3A 45 81     	        LD A,(ima_code)
811A E6 07        	        AND 7
811C FE 04        	        CP 4
811E 3A 44 81     	        LD A,(ima_index)
8121 30 06        	        JR NC,ima_index_up
8123 B7           	        OR A
8124 28 13        	        JR Z,ima_index_ready
8126 3D           	        DEC A
8127 18 10        	        JR ima_index_ready
                 	ima_index_up:
8129 4F           	        LD C,A
812A 3A 45 81     	        LD A,(ima_code)
812D E6 07        	        AND 7
812F D6 03        	        SUB 3
8131 87           	        ADD A,A
8132 81           	        ADD A,C
8133 FE 59        	        CP 89
8135 38 02        	        JR C,ima_index_ready
8137 3E 58        	        LD A,88
                 	ima_index_ready:
8139 32 44 81     	        LD (ima_index),A
813C 3A 45 81     	        LD A,(ima_code)
813F C9           	        RET
8140              	        INCLUDE "ima-encoder.inc"
8140 03           	segments_left: DB segment_count
8141 80           	last_pcm: DB 128
8142 00 80        	ima_predictor: DW 32768
8144 00           	ima_index: DB 0
8145 00           	ima_code: DB 0
8146              	        ASSERT $ < 0x9000
8146              	        DS 0x9000-$
9000 64 5E 5B 56 4F 4C 50 A5 77 76 76 75 75 77 78 A5 C2 BE B3 A7 9A 8C 7F A5 1F 2B 44 59 6F 88 9B A5 8D 76 66 5B 4A 3B 3C A5 C7 E7 CA 90 68 4E 58 A5 A9 A7 A0 98 91 88 7F A5 50 5B 66 73 7D 82 86 A5 34 51 8F B5 98 6A 62 A5 93 9F AE BA C1 C4 C2 A5 7C 81 88 8D 91 96 99 A5 74 7F 87 93 A0 B2 BA A5 51 58 5D 6D 7A 6F 66 A5 A3 95 81 6E 5E 52 49 A5 9C 90 84 84 8A 87 7C A5 79 73 80 A0 B0 B4 BC A5 3D 38 3A 3C 41 4C 58 A5 86 8C 96 A6 BE 99 5C A5 7C 7F 84 88 8C 8E 8D A5 CF C7 BD AD 8F 71 5E A5 80 80 80 80 80 80 80 A5 95 55 24 22 39 59 6C A5 9C 88 70 61 5C 5C 5B A5 9E 97 91 88 7C 75 71 A5 D4 C6 9A 82 7B 80 8C A5 8C 8F 99 A5 7E 5D 6C A5 8E 6D 84 8C 61 6A 8C A5 A0 62 76 72 3F 53 76 A5 9F B0 B0 A1 7F 6E 72 A5 AC 7C 55 5D 84 94 81 A5 9C 94 7B 6F 6F 5A 46 A5 BA BD BF BB B0 A1 92 A5 71 69 66 6F 82 96 9F A5 89 89 89 88 86 84 83 A5 7A 7C 7F 83 86 88 89 A5 79 74 6D 68 65 62 62 A5 D8 BA A9 B9 D4 D2 B1 A5 92 97 8F 98 AF AE A5 A5 8C 8C 9F 9E 8A 9A A7 A5 74 70 6D 70 79 83 8D A5 74 71 6E 6B 6A 6A 6C A5 9A A1 A8 AE AA 9E 92 A5 93 9A AA 80 51 60 7A A5 AF B8 AF A2 91 95 A6 A5 8D 97 A2 A8 98 78 6A A5 66 5B 50 48 49 4F 57 A5 8A 92 AE C8 89 49 47 A5 C6 94 5F 71 4D 2A 4D A5 65 6B 75 83 91 A2 B1 A5 AE 76 3C 36 5D A9 DC A5 48 4A 5F 85 96 A5 BF A5 98 90 3E 30 5D 79 97 A5 B5 A8 74 85 A5 84 71 A5 9C 9E 9E 93 85 80 7D A5 77 68 58 4A 40 3C 3D A5 9D 9F 62 2C 18 41 9F A5 92 7C 6C 72 8C A6 AB A5 4D 51 6C 91 9B 88 84 A5 92 81 6F 66 64 6C 74 A5 45 44 46 4D 5C 5F 5F A5 93 8B 6C 5E 60 73 93 A5 76 75 74 75 73 6B 66 A5 7B 5C 49 3D 2C 27 31 A5 70 67 69 79 8F 93 89 A5 94 A1 AE B6 B8 B8 B0 A5 B2 97 5E 5C 76 84 77 A5 7E 7B 7D 83 8D 9A A3 A5 AC C6 D3 B0 77 48 31 A5 63 79 A7 CD E2 DD D0 A5 5A 4F 47 40 40 42 46 A5 9A 93 8B 7E 71 66 5C A5 6B 70 76 7C 83 8A 8F A5 71 8C A1 AB BC CE D0 A5 68 5E 5D 6F 7D 7C 7B A5 70 72 78 A0 A0 4C 16 A5 82 82 80 82 86 8C 91 A5 A5 D2 BF 7F 9F 9B 78 A5 C3 C6 A1 75 58 4B 57 A5 E5 C0 6C 39 4F 98 CF A5 B3 A6 9C 8E 74 5A 44 A5 8C 74 54 35 23 1A 1B A5 9A 9A 99 96 90 87 7C A5 56 38 22 20 21 27 39 A5 2A 