8000              	sectors_5: EQU 64
8000              	disk_6: EQU 7177
8000              	address_6: EQU 56576
8000              	sectors_6: EQU 35
8000              	disk_7: EQU 7692
8000              	address_7: EQU 57344
8000              	sectors_7: EQU 32
8000              	        INCLUDE "config.inc"
8000              	        ORG 0x8000
                 	
8000              	PULSE:  MACRO
8000              	\0:    OUT (C),B               ; 12: rising edge, B=16
8000              	        EX AF,AF'               ; 4: preserve decoder flags/candidate
8000              	        ADD A,D                 ; 4: width error feedback, modulo256
8000              	        JP C,\0_wide           ; 10 for both outcomes
8000              	\0_narrow: OUT (C),E           ; 12: E=0, high pulse30 T
8000              	        JP \0_done             ; 10: balancing delay after falling
8000              	\0_wide: JP \0_wide_fall      ; 10: same delay before falling
8000              	\0_wide_fall: OUT (C),E        ; 12: high pulse40 T
8000              	\0_done: EX AF,AF'             ; 4: restore decoder, save width error
8000              	        ENDM
                 	
8000              	LOAD_BANK: MACRO
8000              	        LD BC,0x7FFD
8000              	        LD A,\0+16
8000              	        OUT (C),A
8000              	        LD DE,\1
8000              	        LD (disk_position),DE
8000              	        LD HL,\2
8000              	        LD B,\3
8000              	        CALL read_n
8000              	        ENDM
                 	
8000              	SILENCE_AY: MACRO
8000              	        LD BC,0xFFFD
8000              	        LD A,\0
8000              	        OUT (C),A
8000              	        LD BC,0xBFFD
8000              	        XOR A
8000              	        OUT (C),A
8000              	        ENDM
                 	
