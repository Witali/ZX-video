816B              	        PULSE low_out2
816B CB 45        	        BIT 0,L                 ; 8: Z selects sign, not predictor sign
816D DD 09        	        ADD IX,BC               ; 15: biased addition with carry
816F C2 A8 81     	        JP NZ,low_negative      ; 10: same time taken or not taken
                 	low_positive:
