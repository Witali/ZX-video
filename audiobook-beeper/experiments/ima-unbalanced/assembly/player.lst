                 	bank_dispatch:
828C FD E9        	        JP (IY)                 ; 8 T, no stack use; preceding work totals 32 T
                 	
                 	; Bank tail keeps the preceding PCM level for four extra PDM pulses.
                 	; Holds: [74,78,81,76,80,79,74,80,72,77] = 771 T per boundary high nibble.
                 	; 771 - 453 = 14 page overhead + 304 bank overhead. No long mute interval.
828E              	BANK_TAIL: MACRO
828E              	bank_tail_\0: ASSERT \0 >= 0
828E              	        PULSE bank_\0_out5
828E              	        LD A,IXH                ; 8+13+10 = 31 T
828E              	        LD (bank_candidate),A   ; retain last decoded sample across decoder reset
828E              	        LD BC,0x7FFD
828E              	        PULSE bank_\0_out6
828E              	        LD A,\1+16              ; 7+12+7 = 26 T; both OUTs may be contended
828E              	page_\0: OUT (C),A
828E              	        LD D,\2 >> 8            ; E is already zero after input pointer wrap
                 	                                ; 7 T vs LD DE,nn 10 T: -3 T/bank transition
828E              	        PULSE bank_\0_out7
828E              	        LD IY,bank_tail_\3      ; 14+10+8 = 32 T, including tag clear below
828E              	        IF \0 == 7
828E              	        LD HL,tables+64*initial_index
828E              	        ELSE
828E              	        LD BC,0                 ; timing padding, scratch register
828E              	        ENDIF
828E              	        RES 0,L                 ; bank_finish has no room for this 8-T operation
828E              	        PULSE bank_\0_out8
828E              	        IF \0 == 7
828E              	        LD IX,initial_predictor+32768 ; reset IMA only; PDM error stays continuous
828E              	        ELSE
828E              	        LD A,0                  ; 7+7 = 14 T, preserve next IY target
828E              	        LD A,0
828E              	        ENDIF
828E              	        JP bank_finish          ; 14+10 = 24 T
828E              	        ENDM
                 	
