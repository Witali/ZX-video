8095 21 00 C0     		LD HL,address_5
8098 06 40        		LD B,sectors_5
809A CD F1 84     		CALL read_n
809D              	        LOAD_BANK 7, disk_5, address_5, sectors_5
809D 01 FD 7F     		LD BC,0x7FFD
80A0 3E 12        		LD A,2+16
80A2 ED 79        		OUT (C),A
80A4 11 09 1C     		LD DE,disk_6
80A7 ED 53 13 85  		LD (disk_position),DE
80AB 21 00 DD     		LD HL,address_6
80AE 06 23        		LD B,sectors_6
80B0 CD F1 84     		CALL read_n
80B3              	        LOAD_BANK 2, disk_6, address_6, sectors_6
80B3 01 FD 7F     		LD BC,0x7FFD
80B6 3E 15        		LD A,5+16
80B8 ED 79        		OUT (C),A
80BA 11 0C 1E     		LD DE,disk_7
80BD ED 53 13 85  		LD (disk_position),DE
80C1 21 00 E0     		LD HL,address_7
80C4 06 20        		LD B,sectors_7
80C6 CD F1 84     		CALL read_n
80C9              	        LOAD_BANK 5, disk_7, address_7, sectors_7
80C9 F3           	        DI
80CA 01 FD FF     		LD BC,0xFFFD
80CD 3E 08        		LD A,8
80CF ED 79        		OUT (C),A
80D1 01 FD BF     		LD BC,0xBFFD
80D4 AF           		XOR A
80D5 ED 79        		OUT (C),A
