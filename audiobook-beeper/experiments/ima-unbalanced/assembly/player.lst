801E ED 79        		OUT (C),A
8020 11 09 04     		LD DE,disk_0
8023 ED 53 13 85  		LD (disk_position),DE
8027 21 00 C0     		LD HL,address_0
802A 06 40        		LD B,sectors_0
802C CD F1 84     		CALL read_n
802F              	        LOAD_BANK 0, disk_0, address_0, sectors_0
802F 01 FD 7F     		LD BC,0x7FFD
