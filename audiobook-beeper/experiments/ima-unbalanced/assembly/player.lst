80E9 ED 79        		OUT (C),A
80EB 01 FD BF     		LD BC,0xBFFD
80EE AF           		XOR A
80EF ED 79        		OUT (C),A
80F1              	        SILENCE_AY 10
80F1 01 FD 7F     	        LD BC,0x7FFD
80F4 3E 10        	        LD A,16
80F6 ED 79        	        OUT (C),A
80F8 FB           	        EI
80F9 76           	        HALT                    ; one startup IRQ, then no IRQ/disk activity
80FA F3           	        DI
80FB 11 00 C0     	ready:  LD DE,address_0
80FE 21 00 86     	        LD HL,tables+64*initial_index
8101 DD 21 00 80  	        LD IX,initial_predictor+32768
8105 FD 21 8E 82  	        LD IY,bank_tail_0
                 	
                 	; Prime the first sample, without producing a dummy PCM value on the port.
                 	; ADD IX preserves BIT's Z flag and supplies carry for unsigned saturation.
8109 1A           	        LD A,(DE)
810A E6 0F        	        AND 15
810C 07           	        RLCA
810D 07           	        RLCA
810E B5           	        OR L
810F E6 FC        	        AND 252
8111 6F           	        LD L,A
8112 F9           	        LD SP,HL
8113 C1           	        POP BC
8114 E1           	        POP HL
8115 CB 45        	        BIT 0,L
8117 DD 09        	        ADD IX,BC
8119 C2 26 81     	        JP NZ,prime_negative
811C D2 2D 81     	        JP NC,prime_done
811F DD 21 FF FF  	        LD IX,65535
8123 C3 2D 81     	        JP prime_done
                 	prime_negative:
8126 DA 2D 81     	        JP C,prime_done
8129 DD 21 00 00  	        LD IX,0
                 	prime_done:
812D CB 85        	        RES 0,L                 ; prime has no PDM deadline; prepare clean row
812F DD 7C        	        LD A,IXH
8131 D9           	        EXX
8132 01 FE 10     	        LD BC,0x10FE
8135 57           	        LD D,A
8136 1E 00        	        LD E,0
8138 08           	        EX AF,AF'
8139 3E 80        	        LD A,128
813B 08           	        EX AF,AF'
813C D9           	        EXX
813D C3 DE 81     	        JP high                 ; output sample 0 while decoding sample 1
                 	
                 	; Low nibble: six output holds [74,78,81,72,56,78] = 439 T.
8140              		ASSERT low_out0 >= 0
8140 D9           		EXX
8141 08           		EX AF,AF'
8142 82           		ADD A,D
8143 CB 1B        		RR E
8145 CB 9B        		RES 3,E
8147 ED 59        	low_out0:	OUT (C),E
8149 08           		EX AF,AF'
814A D9           		EXX
814B              	low:    PULSE low_out0
814B 1A           	        LD A,(DE)               ; address formation: 7+7+4+4+4 = 26 T
814C E6 0F        	        AND 15
814E 07           	        RLCA
814F 07           	        RLCA
8150 B5           	        OR L                    ; row low bits occupy bits 6..7
8151              		ASSERT low_out1 >= 0
8151 D9           		EXX
8152 08           		EX AF,AF'
8153 82           		ADD A,D
8154 CB 1B        		RR E
8156 CB 9B        		RES 3,E
