                 	
                 	; Expand MSB-first three-bit codes to the even IMA nibbles (code <<1).
                 	; Eight source codes occupy3 bytes and become4 low-nibble-first IMA bytes.
                 	; This special transport is bit-exact for the project's step6 ADPCM3.
                 	; It is not the generic ADPCM-XQ / WAV three-bit format.
                 	; Independent CPU benchmark: HL=inputC000, DE=output4000, IX=group count.
                 	; Version0: bit loop; version1: unrolled extraction; version2: byte algebra;
                 	; version3: four fixed256-byte lookup tables. All produce identical bytes.
                 	
8000              	optimization: EQU 2
8000              	groups: EQU 4096
8000              	        INCLUDE "expand-config.inc"
8000              	        ORG 0x8000
8000 F3           	start:  DI
8001 31 F0 BF     	        LD SP,0xBFF0
8004 21 00 C0     	        LD HL,0xC000
8007 11 00 40     	        LD DE,0x4000
800A DD 21 00 10  	        LD IX,groups
800E 06 01        	        LD B,1
                 	group_loop:
8010              	        IF optimization < 2
8010              	        LD IYL,4
                 	pair_loop:
8010              	        CALL code
8010              	        LD IYH,A
8010              	        CALL code
8010              	        RLCA
8010              	        RLCA
8010              	        RLCA
8010              	        RLCA
8010              	        OR IYH
8010              	        LD (DE),A
8010              	        INC DE
8010              	        DEC IYL
8010              	        JR NZ,pair_loop
8010              	        ELSE
8010 7E           	        LD A,(HL)
8011 23           	        INC HL
8012 47           	        LD B,A
8013 7E           	        LD A,(HL)
8014 23           	        INC HL
8015 4F           	        LD C,A
8016 7E           	        LD A,(HL)
8017 23           	        INC HL
8018 FD 67        	        LD IYH,A
801A              	        IF optimization == 2
801A 78           	        LD A,B
801B 0F           	        RRCA
801C 0F           	        RRCA
801D 0F           	        RRCA
801E 0F           	        RRCA
801F E6 0E        	        AND 0x0E
8021 FD 6F        	        LD IYL,A
8023 78           	        LD A,B
8024 07           	        RLCA
8025 07           	        RLCA
8026 07           	        RLCA
8027 E6 E0        	        AND 0xE0
8029 FD B5        	        OR IYL
802B 12           	        LD (DE),A
802C 13           	        INC DE
802D 78           	        LD A,B
802E E6 03        	        AND 3
8030 07           	        RLCA
8031 07           	        RLCA
8032 47           	        LD B,A
8033 79           	        LD A,C
8034 07           	        RLCA
8035 E6 E0        	        AND 0xE0
8037 B0           	        OR B
8038 47           	        LD B,A
8039 79           	        LD A,C
803A 07           	        RLCA
803B 07           	        RLCA
803C E6 02        	        AND 2
803E B0           	        OR B
803F 12           	        LD (DE),A
8040 13           	        INC DE
8041 79           	        LD A,C
8042 E6 0E        	        AND 14
8044 47           	        LD B,A
8045 79           	        LD A,C
8046 0F           	        RRCA
8047 E6 80        	        AND 128
8049 B0           	        OR B
804A 47           	        LD B,A
804B FD 7C        	        LD A,IYH
804D 0F           	        RRCA
804E E6 60        	        AND 0x60
8050 B0           	        OR B
8051 12           	        LD (DE),A
8052 13           	        INC DE
8053 FD 7C        	        LD A,IYH
8055 0F           	        RRCA
8056 0F           	        RRCA
8057 E6 0E        	        AND 14
8059 47           	        LD B,A
805A FD 7C        	        LD A,IYH
805C 0F           	        RRCA
805D 0F           	        RRCA
805E 0F           	        RRCA
805F E6 E0        	        AND 0xE0
8061 B0           	        OR B
8062 12           	        LD (DE),A
8063 13           	        INC DE
8064              	        ELSE
8064              	        PUSH HL
8064              	        LD L,B
8064              	        LD H,0x90
8064              	        LD A,(HL)
8064              	        LD (DE),A
8064              	        INC DE
8064              	        LD A,B
8064              	        AND 3
8064              	        RLCA
8064              	        RLCA
8064              	        LD B,A
8064              	        LD L,C
8064              	        INC H
8064              	        LD A,(HL)
8064              	        OR B
8064              	        LD (DE),A
8064              	        INC DE
8064              	        LD L,C
8064              	        INC H
8064              	        LD B,(HL)
8064              	        LD A,IYH
8064              	        RRCA
8064              	        AND 0x60
8064              	        OR B
8064              	        LD (DE),A
8064              	        INC DE
8064              	        LD A,IYH
8064              	        LD L,A
8064              	        INC H
8064              	        LD A,(HL)
8064              	        LD (DE),A
8064              	        INC DE
8064              	        POP HL
8064              	        ENDIF
8064              	        ENDIF
8064 DD 2B        	        DEC IX
8066 DD 7C        	        LD A,IXH
8068 DD B5        	        OR IXL
806A C2 10 80     	        JP NZ,group_loop
                 	complete:
806D C3 6D 80     	        JP complete
                 	
8070              	        IF optimization < 2
8070              	code:   XOR A
8070              	        IF optimization == 0
8070              	        PUSH DE
8070              	        LD E,3
                 	code_bit:
8070              	        CALL read_bit
8070              	        RLA
8070              	        DEC E
8070              	        JR NZ,code_bit
8070              	        POP DE
8070              	        ELSE
8070              	        CALL read_bit
8070              	        RLA
8070              	        CALL read_bit
8070              	        RLA
8070              	        CALL read_bit
8070              	        RLA
8070              	        ENDIF
8070              	        ADD A,A
8070              	        RET
                 	read_bit:
8070              	        DEC B
8070              	        JR NZ,bit_ready
8070              	        LD C,(HL)
8070              	        INC HL
8070              	        LD B,8
                 	bit_ready:
8070              	        SLA C
8070              	        RET
8070              	        ENDIF
                 	code_end:
8070              	        IF optimization == 3
8070              	        DS 0x9000-$
8070              	        MDAT "lookup.bin"
8070              	        ENDIF
