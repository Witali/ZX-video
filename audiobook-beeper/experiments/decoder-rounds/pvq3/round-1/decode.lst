                 	
                 	; PVQ3x512 half-last predictor: independent decoder CPU/buffer probe.
                 	; Eight nine-bit indices = high-bit header (LSB first), then8 low bytes.
                 	; Dictionary rows:3 signed residual bytes +1 guard; address9000+4*index.
                 	; The PC rejects overflowing reconstructed samples, so ADD A,B is sufficient.
                 	; R0: sample iterator + memory history. R1: IXH history. R2: address tables.
                 	; R3: one dispatch per vector; store three PCM bytes and update history once.
                 	; Test caller: mainDE output, mainBC sample/vector count; alternateDE input.
                 	
8000              	optimization: EQU 1
8000              	        INCLUDE "pvq-config.inc"
8000              	        ORG 0x8000
8000              	loop:   IF optimization < 3
8000 CD 0E 80     	        CALL next_sample
8003 12           	        LD (DE),A
8004 13           	        INC DE
8005              	        ELSE
8005              	        CALL next_vector
8005              	        ENDIF
8005 0B           	        DEC BC
8006 78           	        LD A,B
8007 B1           	        OR C
8008 C2 00 80     	        JP NZ,loop
                 	complete:
800B C3 0B 80     	        JP complete
                 	
800E              	        IF optimization < 3
                 	next_sample:
800E D9           	        EXX
800F FD 25        	        DEC IYH
8011 20 25        	        JR NZ,have_vector
8013 FD 26 03     	        LD IYH,3
8016              	        ELSE
                 	next_vector:
8016              	        EXX
8016              	        ENDIF
8016 FD 2D        	        DEC IYL
8018 20 06        	        JR NZ,have_header
801A 1A           	        LD A,(DE)
801B 13           	        INC DE
801C 4F           	        LD C,A
801D FD 2E 08     	        LD IYL,8
                 	have_header:
8020 1A           	        LD A,(DE)
8021 13           	        INC DE
8022 6F           	        LD L,A
8023              	        IF optimization < 2
8023 26 00        	        LD H,0
8025 29           	        ADD HL,HL
8026 29           	        ADD HL,HL
8027 7C           	        LD A,H
8028 F6 90        	        OR 0x90
802A 67           	        LD H,A
802B              	        ELSE
802B              	        LD H,0x88
802B              	        LD A,(HL)
802B              	        INC H
802B              	        LD H,(HL)
802B              	        LD L,A
802B              	        ENDIF
802B CB 39        	        SRL C
802D 30 02        	        JR NC,low_half
802F CB D4        	        SET 2,H
                 	low_half:
8031              	        IF optimization == 0
8031              	        LD A,(last_pcm)
8031              	        ELSE
8031 DD 7C        	        LD A,IXH
8033              	        ENDIF
8033 CB 3F        	        SRL A
8035 C6 40        	        ADD A,64
8037 47           	        LD B,A
                 	have_vector:
8038              	        IF optimization < 3
8038 7E           	        LD A,(HL)
8039 2C           	        INC L
803A 80           	        ADD A,B
803B              	        IF optimization == 0
803B              	        LD (last_pcm),A
803B              	        ELSE
803B DD 67        	        LD IXH,A
803D              	        ENDIF
803D D9           	        EXX
803E C9           	        RET
803F              	        ELSE
803F              	        LD A,(HL)
803F              	        INC L
803F              	        ADD A,B
803F              	        EXX
803F              	        LD (DE),A
803F              	        INC DE
803F              	        EXX
803F              	        LD A,(HL)
803F              	        INC L
803F              	        ADD A,B
803F              	        EXX
803F              	        LD (DE),A
803F              	        INC DE
803F              	        EXX
803F              	        LD A,(HL)
803F              	        ADD A,B
803F              	        LD IXH,A
803F              	        EXX
803F              	        LD (DE),A
803F              	        INC DE
803F              	        RET
803F              	        ENDIF
803F 80           	last_pcm: DB 128
                 	code_end:
8040              	        IF optimization >= 2
8040              	        DS 0x8800-$
8040              	        MDAT "pointer-low.bin"
8040              	        MDAT "pointer-high.bin"
8040              	        ENDIF
8040              	        DS 0x9000-$
9000 FF F4 EC A5 F6 07 17 A5 F5 03 20 A5 E6 C7 B3 A5 2A 2A 27 A5 E4 A8 91 A5 00 00 FF A5 1A 4A 5E A5 38 13 BB A5 01 FD FE A5 D9 E5 05 A5 09 0C 0D A5 07 25 13 A5 0F 02 F1 A5 EB E3 E2 A5 20 2A 11 A5 21 2F 35 A5 E0 D3 E5 A5 1B FB F5 A5 FC E7 BE A5 09 01 F7 A5 04 F6 F1 A5 0E 08 FC A5 0B 22 38 A5 CE BC BD A5 F8 F7 F7 A5 18 FB D2 A5 1F 0D 1E A5 FD 0D 0D A5 53 6B 35 A5 16 11 08 A5 FE 0B 00 A5 0B 0C 09 A5 FC E7 F3 A5 04 06 08 A5 30 41 1C A5 DF FB FA A5 0D 1A 14 A5 FD FB 10 A5 03 13 2B A5 E1 DF E1 A5 15 1F 24 A5 EA FB 20 A5 12 3A 3C A5 0A 39 4B A5 E4 ED F5 A5 1B 15 16 A5 08 0A 17 A5 E8 12 FE A5 FC C6 BF A5 10 28 3E A5 FF FF FF A5 08 1A 4B A5 04 FF F8 A5 FC 1B 18 A5 04 D2 A6 A5 FB F2 D6 A5 1A 26 1F A5 E8 0B 36 A5 FF E9 00 A5 02 27 F1 A5 1A 2F 3A A5 D4 D2 D4 A5 FC FC FC A5 1A 0D FC A5 E9 D3 D6 A5 08 05 FB A5 07 14 F8 A5 30 2E F1 A5 0D 30 09 A5 1D 0C F2 A5 E7 D6 C9 A5 1B 27 2E A5 11 13 12 A5 BC D8 30 A5 15 22 12 A5 BF B2 BF A5 50 54 28 A5 25 71 71 A5 EE DB F2 A5 0E D8 D1 A5 0D 17 1D A5 4D 49 15 A5 22 44 3D A5 04 05 05 A5 0A F6 DF A5 3A 0E D5 A5 0E D8 B4 A5 13 2D 33 A5 FF FB 08 A5 BD B8 D4 A5 F7 D4 B7 A5 E0 F1 1F A5 E2 D9 D2 A5 EA DA E2 A5 2A F5 D5 A5 1E 16 09 A5 00 01 01 A5 F3 E3 E9 A5 11 0E 1A A5 CC D9 12 A5 E8 E9 F0 A5 FD 59 7F A5 2B 06 CF A5 E6 F3 02 A5 F1 E3 CB A5 01 04 07 A5 E6 BD A6 A5 D7 C9 C9 A5 F1 E9 F4 A5 02 F8 1C A5 D4 01 3E A5 05 1F 2D A5 D6 D2 DC A5 15 F4 01 A5 FC F9 F6 A5 F6 12 17 A5 F8 13 3F A5 EB E1 DB A5 C3 97 B5 A5 04 01 CA A5 0C 09 04 A5 1E 25 27 A5 30 37 02 A5 15 07 F5 A5 17 13 29 A5 F5 11 2E A5 FD 02 FF A5 44 59 51 A5 EC 20 51 A5 FD E7 D7 A5 EC 05 22 A5 F6 FE 02 A5 EA E7 07 A5 DD D3 CD A5 F8 B0 89 A5 13 FD 09 A5 11 EC C5 A5 01 1D 36 A5 F0 C9 AE A5 07 EF 0C A5 F2 E4 D8 A5 F0 F1 F3 A5 FB F6 FD A5 FA 29 2C A5 DD F3 0E A5 16 10 DB A5 CC C4 DE A5 05 09 0C A5 E6 BF D7 A5 E6 E6 E7 A5 1B 12 03 A5 DD D4 04 A5 04 F9 EC A5 F5 EA 0E A5 FA FD 00 A5 35 38 31 A5 D3 C0 F0 A5 0A 1E 05 A5 12 1E 1C A5 01 04 18 A5 2E 18 02 A5 E1 E6 ED A5 FE 02 04 A5 2C 0D F2 A5 D2 D8 E2 A5 C7 