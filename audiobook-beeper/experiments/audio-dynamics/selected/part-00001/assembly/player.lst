B740              	        IF chained_playback
                 	chain_exit:
                 	        ; Final silent-guard entry; no live register inputs, all clobbered.
                 	        ; Restore the TR-DOS stack/IY/interrupt mode, then reload a transient
                 	        ; controller over obsolete PDM tables. This routine does not return.
B740              	        DI
B740              	        LD SP,0x6000
B740              	        LD IY,0x5C3A
B740              	        IM 1
B740              	        XOR A
B740              	        OUT (0xFE),A
                 	        ; Playback is over. Disable the exhausted progress counter while
                 	        ; reusing the loader to replace bank-5 tables with the controller.
B740              	        LD A,0xC9
B740              	        LD (update_progress),A
                 	chain_retry:
B740              	        LD BC,0x7FFD
B740              	        LD A,31
B740              	        OUT (C),A
B740              	        LD DE,chain_disk
B740              	        LD HL,0x4000
B740              	        LD B,chain_sectors
B740              	        EI
B740              	        CALL read_n
B740              	        DI
B740              	        LD HL,(0x4003)           ; refuse an unrelated disk's machine code
