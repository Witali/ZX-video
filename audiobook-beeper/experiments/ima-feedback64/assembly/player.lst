                 	
                 	; Live guarded IMA + eight-bit block error-feedback PDM.
                 	; Authoritative instruction source, assembled externally by pyz80.
                 	; Main E = rotating output byte; B = twice the 6-bit feedback state;
                 	; C = next output byte; D/HL/AF = scratch; IY = packed input cursor.
                 	; Alternate HL = IMA row, BC = signed delta; IX = biased PCM16.
                 	; SP is a read-only table cursor during playback. No CALL/PUSH/IRQ then.
                 	; A table lookup computes eight new bits AND the next feedback state.
                 	; This is live conversion, not a stored or unpacked PDM soundtrack.
                 	;
                 	; Four input bytes are unrolled. Low halves take 428 T; the first three
                 	; high halves take 436 T, the fourth 446 T: mean 433.25 T/sample.
                 	; Previous feedback kernel: 437 T; standard six-slot PDM: 438 T.
                 	; Holds: 49,53,56,58,53,56,59, then 44 (low), 52/62 (high).
                 	; Counts exclude ULA contention, ROM and physical disk latency.
                 	
8000              	initial_predictor: EQU 0
8000              	initial_index: EQU 0
8000              	initial_feedback: EQU 34
8000              	disk_0: EQU 1548
8000              	address_0: EQU 49152
8000              	sectors_0: EQU 64
8000              	disk_1: EQU 2572
8000              	address_1: EQU 49152
8000              	sectors_1: EQU 64
8000              	disk_2: EQU 3596
8000              	address_2: EQU 49152
8000              	sectors_2: EQU 64
8000              	disk_3: EQU 4620
8000              	address_3: EQU 49152
8000              	sectors_3: EQU 64
8000              	disk_4: EQU 5644
8000              	address_4: EQU 49152
8000              	sectors_4: EQU 64
8000              	disk_5: EQU 6668
8000              	address_5: EQU 49152
8000              	sectors_5: EQU 64
8000              	disk_6: EQU 7692
8000              	address_6: EQU 57344
8000              	sectors_6: EQU 32
8000              	        INCLUDE "config.inc"
8000              	        ORG 0x8000
                 	
8000              	PULSE: MACRO
8000              	        ASSERT \0 >= 0
8000              	        RLC E                   ; 8: MSB-first, byte returns after eight bits
8000              	        SBC A,A                 ; 4: carry to 00/FF
8000              	        AND 16                  ; 7: EAR only, MIC/border zero
8000              	\0:     OUT (0xFE),A            ; 11: total 30 T, AF is scratch
8000              	        ENDM
                 	
8000              	LOAD_BANK: MACRO
8000              	        LD BC,0x7FFD
8000              	        LD A,\0+16
8000              	        OUT (C),A
8000              	        LD DE,\1
8000              	        LD (disk_position),DE
8000              	        LD HL,\2
8000              	        LD B,\3
8000              	        CALL read_n
8000              	        ENDM
                 	
8000              	SILENCE_AY: MACRO
8000              	        LD BC,0xFFFD
8000              	        LD A,\0
8000              	        OUT (C),A
8000              	        LD BC,0xBFFD
8000              	        XOR A
8000              	        OUT (C),A
8000              	        ENDM
                 	
