                 	
                 	; Read small three-bit IMA blocks, expand them directly into resident RAM.
                 	; Fixed bank2: code8000..8FFF, four lookup pages9000..93FF, screen9400..AEFF.
                 	; Bank5: screen4000..5AFF, ROM workspace/stack5B00..5FFF, input6000..77FF.
                 	; Output is paged at C000. Bank2's final F800..FFFF aliases B800..BFFF,
                 	; safely beyond this preloader. Nothing needs the complete input in RAM.
                 	
8000              	audio_disk: EQU 3335
8000              	player_disk: EQU 1024
8000              	chunk_count: EQU 13
8000              	trampoline_size: EQU 44
8000              	        INCLUDE "ima3-config.inc"
8000              	        ORG 0x8000
8000 F3           	start:  DI
8001 31 00 60     	        LD SP,0x6000
8004 FD 21 3A 5C  	        LD IY,0x5C3A
8008 ED 56        	        IM 1
800A AF           	        XOR A
800B D3 FE        	        OUT (0xFE),A
800D 21 00 94     	        LD HL,screen_data
8010 11 00 40     	        LD DE,0x4000
8013 01 00 1B     	        LD BC,6912
8016 ED B0        	        LDIR
8018 11 07 0D     	        LD DE,audio_disk
801B ED 53 23 81  	        LD (disk_position),DE
801F 21 35 81     	        LD HL,chunk_data
8022 22 2E 81     	        LD (chunk_cursor),HL
                 	chunk_loop:
8025 2A 2E 81     	        LD HL,(chunk_cursor)
8028 7E           	        LD A,(HL)               ; output bank
8029 23           	        INC HL
802A 01 FD 7F     	        LD BC,0x7FFD
802D F6 10        	        OR 16                   ; ROM1, visible screen5, paging enabled
802F ED 79        	        OUT (C),A
8031 5E           	        LD E,(HL)
8032 23           	        INC HL
8033 56           	        LD D,(HL)
8034 23           	        INC HL
8035 ED 53 30 81  	        LD (output_address),DE
8039 46           	        LD B,(HL)               ; number of disk sectors for this block
803A 23           	        INC HL
803B 5E           	        LD E,(HL)
803C 23           	        INC HL
803D 56           	        LD D,(HL)
803E 23           	        INC HL
803F ED 53 32 81  	        LD (group_count),DE     ; three input bytes -> four output bytes
8043 7E           	        LD A,(HL)
8044 23           	        INC HL
8045 32 2D 81     	        LD (unpack_target),A    ; completed output fraction, 0..32 cells
8048 22 2E 81     	        LD (chunk_cursor),HL
804B 21 00 60     	        LD HL,0x6000
804E CD B4 80     	        CALL read_n
                 	block_loaded:
8051 21 00 60     	        LD HL,0x6000
8054 ED 5B 30 81  	        LD DE,(output_address)
8058 DD 2A 32 81  	        LD IX,(group_count)
805C CD 7A 80     	        CALL expand
                 	block_expanded:
805F CD 0F 81     	        CALL update_unpack
8062 3A 34 81     	        LD A,(chunks_left)
8065 3D           	        DEC A
8066 32 34 81     	        LD (chunks_left),A
8069 C2 25 80     	        JP NZ,chunk_loop
                 	unpack_complete:
806C 21 D0 81     	        LD HL,trampoline_data
806F 11 00 60     	        LD DE,0x6000
8072 01 2C 00     	        LD BC,trampoline_size
8075 ED B0        	        LDIR
                 	handoff:
8077 C3 00 60     	        JP 0x6000               ; loader replaces8000..B7FF with the player
                 	
                 	; The round-3 lookup core, unchanged at285 T per eight samples.
                 	; CALL/RET and block setup/progress are outside that count.
                 	expand:
                 	group_loop:
807A 7E           	        LD A,(HL)
807B 23           	        INC HL
807C 47           	        LD B,A
807D 7E           	        LD A,(HL)
807E 23           	        INC HL
807F 4F           	        LD C,A
8080 7E           	        LD A,(HL)
8081 23           	        INC HL
8082 FD 67        	        LD IYH,A
8084 E5           	        PUSH HL
8085 68           	        LD L,B
8086 26 90        	        LD H,0x90
8088 7E           	        LD A,(HL)
8089 12           	        LD (DE),A
808A 13           	        INC DE
808B 78           	        LD A,B
808C E6 03        	        AND 3
808E 07           	        RLCA
808F 07           	        RLCA
8090 47           	        LD B,A
8091 69           	        LD L,C
8092 24           	        INC H
8093 7E           	        LD A,(HL)
8094 B0           	        OR B
8095 12           	        LD (DE),A
8096 13           	        INC DE
8097 69           	        LD L,C
8098 24           	        INC H
8099 46           	        LD B,(HL)
809A FD 7C        	        LD A,IYH
809C 0F           	        RRCA
809D E6 60        	        AND 0x60
809F B0           	        OR B
80A0 12           	        LD (DE),A
80A1 13           	        INC DE
80A2 FD 7C        	        LD A,IYH
80A4 6F           	        LD L,A
80A5 24           	        INC H
80A6 7E           	        LD A,(HL)
80A7 12           	        LD (DE),A
80A8 13           	        INC DE
                 	group_written:
80A9 E1           	        POP HL
80AA DD 2B        	        DEC IX
80AC DD 7C        	        LD A,IXH
80AE DD B5        	        OR IXL
80B0 C2 7A 80     	        JP NZ,group_loop
                 	expand_end:
80B3 C9           	        RET
                 	
                 	; Read through the real TR-DOS ROM. The preloader never holds IY scratch
                 	; across this call: restore the ROM's system-variable pointer every time.
80B4 22 25 81     	read_n: LD (disk_destination),HL
                 	read_sector:
80B7 C5           	        PUSH BC
80B8 FD 21 3A 5C  	        LD IY,0x5C3A
80BC 2A 25 81     	        LD HL,(disk_destination)
80BF ED 5B 23 81  	        LD DE,(disk_position)
80C3 01 05 01     	        LD BC,0x0105
80C6 FB           	        EI
                 	disk_call:
80C7 CD 13 3D     	        CALL 0x3D13
80CA F3           	        DI
                 	disk_return:
80CB 2A 25 81     	        LD HL,(disk_destination)
80CE 24           	        INC H
80CF 22 25 81     	        LD (disk_destination),HL
80D2 ED 5B 23 81  	        LD DE,(disk_position)
80D6 1C           	        INC E
80D7 CB 63        	        BIT 4,E
80D9 28 03        	        JR Z,sector_ok
80DB 1E 00        	        LD E,0
80DD 14           	        INC D
                 	sector_ok:
80DE ED 53 23 81  	        LD (disk_position),DE
80E2 2A 27 81     	        LD HL,(sectors_read)    ; more than256 sectors: use a16-bit counter
80E5 23           	        INC HL
80E6 22 27 81     	        LD (sectors_read),HL
80E9 EB           	        EX DE,HL
80EA 2A 2A 81     	        LD HL,(load_threshold_cursor)
80ED 7B           	        LD A,E
80EE BE           	        CP (HL)
80EF 20 1A        	        JR NZ,load_no_update
80F1 23           	        INC HL
80F2 7A           	        LD A,D
80F3 BE           	        CP (HL)
80F4 20 15        	        JR NZ,load_no_update
80F6 23           	        INC HL
80F7 22 2A 81     	        LD (load_threshold_cursor),HL
80FA 3A 29 81     	        LD A,(load_progress)
80FD 4F           	        LD C,A
80FE 06 00        	        LD B,0
8100 21 40 59     	        LD HL,0x5940
8103 09           	        ADD HL,BC
8104 36 64        	        LD (HL),0x64
8106 3C           	        INC A
8107 32 29 81     	        LD (load_progress),A
                 	load_progress_event:
810A 00           	        NOP
                 	load_no_update:
810B C1           	        POP BC
810C 10 A9        	        DJNZ read_sector
810E C9           	        RET
                 	
                 	; Update after each decoded block, outside the expansion hot loop.
                 	update_unpack:
810F 3A 2D 81     	        LD A,(unpack_target)
8112 47           	        LD B,A
8113 3A 2C 81     	        LD A,(unpack_progress)
                 	unpack_step:
8116 B8           	        CP B
8117 C8           	        RET Z
8118 6F           	        LD L,A
8119 26 5A        	        LD H,0x5A
811B 36 64        	        LD (HL),0x64
811D 3C           	        INC A
811E 32 2C 81     	        LD (unpack_progress),A
                 	unpack_progress_event:
8121 18 F3        	        JR unpack_step
                 	
8123 00 00        	disk_position: DW 0
8125 00 00        	disk_destination: DW 0
8127 00 00        	sectors_read: DW 0
8129 00           	load_progress: DB 0
812A 90 81        	load_threshold_cursor: DW load_thresholds
812C 00           	unpack_progress: DB 0
812D 00           	unpack_target: DB 0
812E 00 00        	chunk_cursor: DW 0
8130 00 00        	output_address: DW 0
8132 00 00        	group_count: DW 0
8134 0D           	chunks_left: DB chunk_count
8135 00 00 C0 18 00 08 02 00 00 E0 18 00 08 05 04 00 C0 18 00 08 08 04 00 E0 18 00 08 0B 06 00 C0 18 00 08 0E 06 00 E0 18 00 08 10 01 00 C0 18 00 08 13 01 00 E0 18 00 08 16 03 00 C0 18 00 08 19 03 00 E0 18 00 08 1C 07 00 DB 18 00 08 1E 07 00 FB 04 40 01 1F 02 00 F8 06 00 02 20 	chunk_data: MDAT "chunks.bin"
8190 09 00 12 00 1A 00 23 00 2B 00 34 00 3C 00 45 00 4E 00 56 00 5F 00 67 00 70 00 78 00 81 00 89 00 92 00 9B 00 A3 00 AC 00 B4 00 BD 00 C5 00 CE 00 D7 00 DF 00 E8 00 F0 00 F9 00 01 01 0A 01 12 01 	load_thresholds: MDAT "load-thresholds.bin"
81D0 F3 31 F0 5F FD 21 3A 5C 11 00 04 21 00 80 06 38 C5 D5 E5 01 05 01 FB CD 13 3D F3 E1 D1 C1 24 1C CB 63 28 03 1E 00 14 10 E7 C3 00 80 	trampoline_data: MDAT "trampoline.bin"
                 	code_end:
81FC              	        ASSERT $ <= 0x9000
81FC              	        DS 0x9000-$
9000 00 00 00 00 20 20 20 20 40 40 40 40 60 60 60 60 80 80 80 80 A0 A0 A0 A0 C0 C0 C0 C0 E0 E0 E0 E0 02 02 02 02 22 22 22 22 42 42 42 42 62 62 62 62 82 82 82 82 A2 A2 A2 A2 C2 C2 C2 C2 E2 E2 E2 E2 04 04 04 04 24 24 24 24 44 44 44 44 64 64 64 64 84 84 84 84 A4 A4 A4 A4 C4 C4 C4 C4 E4 E4 E4 E4 06 06 06 06 26 26 26 26 46 46 46 46 66 66 66 66 86 86 86 86 A6 A6 A6 A6 C6 C6 C6 C6 E6 E6 E6 E6 08 08 08 08 28 28 28 28 48 48 48 48 68 68 68 68 88 88 88 88 A8 A8 A8 A8 C8 C8 C8 C8 E8 E8 E8 E8 0A 0A 0A 0A 2A 2A 2A 2A 4A 4A 4A 4A 6A 6A 6A 6A 8A 8A 8A 8A AA AA AA AA CA CA CA CA EA EA EA EA 0C 0C 0C 0C 2C 2C 2C 2C 4C 4C 4C 4C 6C 6C 6C 6C 8C 8C 8C 8C AC AC AC AC CC CC CC CC EC EC EC EC 0E 0E 0E 0E 2E 2E 2E 2E 4E 4E 4E 4E 6E 6E 6E 6E 8E 8E 8E 8E AE AE AE AE CE CE CE CE EE EE EE EE 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 20 40 40 40 40 40 40 40 40 40 40 40 40 40 40 40 40 60 60 60 60 60 60 60 60 60 60 60 60 60 60 60 60 80 80 80 80 80 80 80 80 80 80 80 80 80 80 80 80 A0 A0 A0 A0 A0 A0 A0 A0 A0 A0 A0 A0 A0 A0 A0 A0 C0 C0 C0 C0 C0 C0 C0 C0 C0 C0 C0 C0 C0 C0 C0 C0 E0 E0 E0 E0 E0 E0 E0 E0 E0 E0 E0 E0 E0 E0 E0 E0 02 02 02 02 02 02 02 02 02 02 02 02 02 02 02 02 22 22 22 22 22 22 22 22 22 22 22 22 22 22 22 22 42 42 42 42 42 42 42 42 42 42 42 42 42 42 42 42 62 62 62 62 62 62 62 62 62 62 62 62 62 62 62 62 82 82 82 82 82 82 82 82 82 82 82 82 82 82 82 82 A2 A2 A2 A2 A2 A2 A2 A2 A2 A2 A2 A2 A2 A2 A2 A2 C2 C2 C2 C2 C2 C2 C2 C2 C2 C2 C2 C2 C2 C2 C2 C2 E2 E2 E2 E2 E2 E2 E2 E2 E2 E2 E2 E2 E2 E2 E2 E2 00 80 02 82 04 84 06 86 08 88 0A 8A 0C 8C 0E 8E 00 80 02 82 04 84 06 86 08 88 0A 8A 0C 8C 0E 8E 00 80 02 82 04 84 06 86 08 88 0A 8A 0C 8C 0E 8E 00 80 02 82 04 84 06 86 08 88 0A 8A 0C 8C 0E 8E 00 80 02 82 04 84 06 86 08 88 0A 8A 0C 8C 0E 8E 00 80 02 82 04 84 06 86 08 88 0A 8A 0C 8C 0E 8E 00 80 02 82 04 84 06 86 08 88 0A 8A 0C 8C 0E 8E 00 80 02 82 04 84 06 86 08 88 0A 8A 0C 8C 0E 8E 00 80 02 82 04 84 06 86 08 88 0A 8A 0C 8C 0E 8E 00 80 02 82 04 84 06 86 08 