                 	
                 	; Optimistic exact signed 16 x 16 multiplication for Speex's LPC synthesis.
                 	; One operand has seven prepared 256-byte table planes. Table creation,
                 	; coefficient changes, 32-bit accumulation and argument setup are excluded.
                 	; Input H=first table page, L=low input byte, A=high input byte.
                 	; Output B:D:E:C is the signed 32-bit product, most significant byte first.
                 	; INC H preserves carry between the three byte additions.
8000              	        ORG 0x8000
8000 CD 04 80     	start:  CALL multiply          ; 17 T, counted separately
8003 00           	stop:   NOP
                 	multiply:
8004 4E           	        LD C,(HL)             ; 7: product of unsigned low byte, byte 0
8005 24           	        INC H                 ; 4
8006 5E           	        LD E,(HL)             ; 7: byte 1
8007 24           	        INC H                 ; 4
8008 56           	        LD D,(HL)             ; 7: byte 2
8009 24           	        INC H                 ; 4
800A 46           	        LD B,(HL)             ; 7: sign extension, byte 3
800B 6F           	        LD L,A                ; 4: signed high-byte table index
800C 24           	        INC H                 ; 4
800D 7E           	        LD A,(HL)             ; 7: high-byte contribution, byte 1
800E 83           	        ADD A,E               ; 4
800F 5F           	        LD E,A                ; 4
8010 24           	        INC H                 ; 4
8011 7E           	        LD A,(HL)             ; 7: byte 2
8012 8A           	        ADC A,D               ; 4
8013 57           	        LD D,A                ; 4
8014 24           	        INC H                 ; 4
8015 7E           	        LD A,(HL)             ; 7: byte 3
8016 88           	        ADC A,B               ; 4
8017 47           	        LD B,A                ; 4
8018 C9           	        RET                   ; 10
                 	; 7 reads * 7 + 6 increments * 4 + LD L,A 4 + 3 adds * 4
                 	; + 3 result moves * 4 + RET 10 = 111 T (128 T with CALL).
