                 	bank_finish:
847F              	bank_candidate: EQU $+1
847F 16 00        	        LD D,0                  ; 7: direct publication vs old LD A,n /LD D,A
8481 33           	        INC SP                  ; 6: cursor dead
8482 C3 28 81     	        JP low                  ; 10: 10+7+6+10=33 T, hold73 vs old71
                 	
                 	; Startup-only real-stack disk reader. No disk access while PDM is running.
8485 C5           	read_n: PUSH BC
8486 E5           	        PUSH HL
8487 ED 5B A7 84  	        LD DE,(disk_position)
848B 01 05 01     	        LD BC,0x0105
                 	disk_call:
848E CD 13 3D     	        CALL 0x3D13
8491 E1           	        POP HL
8492 C1           	        POP BC
8493 24           	        INC H
8494 ED 5B A7 84  	        LD DE,(disk_position)
8498 1C           	        INC E
8499 CB 63        	        BIT 4,E
849B 28 03        	        JR Z,sector_ok
849D 1E 00        	        LD E,0
849F 14           	        INC D
                 	sector_ok:
84A0 ED 53 A7 84  	        LD (disk_position),DE
84A4 10 DF        	        DJNZ read_n
84A6 C9           	        RET
84A7 00 00        	disk_position: DW 0
                 	code_end:
