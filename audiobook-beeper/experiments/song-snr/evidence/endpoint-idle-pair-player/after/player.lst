800F 07           	        RLCA
8010 21 C0 B6     	        LD HL,decoder_seed
8013 B5           	        OR L
8014 6F           	        LD L,A
8015 F9           	        LD SP,HL
8016 C1           	        POP BC
8017 E1           	        POP HL
8018 DD 09        	        ADD IX,BC
801A D9           	        EXX
801B DD 7C        	        LD A,IXH
801D 6F           	        LD L,A
801E 26 B3        	        LD H,pcm_high >> 8
8020 66           	        LD H,(HL)
8021 2E 30        	        LD L,initial_feedback_offset
8023 F9           	        LD SP,HL
8024 E1           	        POP HL
8025 FD E1        	        POP IY
8027 D1           	        POP DE
8028 01 FE 00     	        LD BC,0x00FE
802B 37           	        SCF
802C 08           	        EX AF,AF'
802D D9           	        EXX
802E 1A           	        LD A,(DE)
802F E6 F0        	        AND 240
8031 0F           	        RRCA
8032 0F           	        RRCA
8033 13           	        INC DE
8034 D9           	        EXX
8035 E9           	        JP (HL)
                 	; Enter with the alternate bank active, A already the extracted high nibble.
8036              	PAGE_TAIL: MACRO
8036              	page_tail_\0: ASSERT 1
8036              	        INC D
8036              	        JP Z,bank_handoff_\0
8036              	        EXX
8036              	        IF \0
8036              	        OUT (C),D
8036              	        ELSE
8036              	        DB 0xED,0x71
8036              	        ENDIF
8036              	        JP (HL)
8036              	bank_handoff_\0: ASSERT 1
8036              	        EX AF,AF'
8036              	        EXX
8036              	        LD B,\0*16              ; save last bit; 00FE/10FE are uncontended high bytes
8036              	        EXX
8036              	        JP bank_jump
8036              	        ENDM
8036              	page_tail_0:	ASSERT 1
8036 14           		INC D
8037 CA 3E 80     		JP Z,bank_handoff_0
803A D9           		EXX
803B              		IF 0
803B              		OUT (C),D
803B              		ELSE
803B 71           		DB 0xED,0x71
803D              		ENDIF
803D E9           		JP (HL)
803E              	bank_handoff_0:	ASSERT 1
803E 08           		EX AF,AF'
803F D9           		EXX
8040 06 00        		LD B,0*16
8042 D9           		EXX
8043 C3 56 80     		JP bank_jump
8046              	        PAGE_TAIL 0
8046              	page_tail_1:	ASSERT 1
8046 14           		INC D
8047 CA 4E 80     		JP Z,bank_handoff_1
804A D9           		EXX
804B              		IF 1
804B ED 51        		OUT (C),D
804D              		ELSE
804D              		DB 0xED,0x71
804D              		ENDIF
804D E9           		JP (HL)
804E              	bank_handoff_1:	ASSERT 1
804E 08           		EX AF,AF'
804F D9           		EXX
8050 06 10        		LD B,1*16
8052 D9           		EXX
8053 C3 56 80     		JP bank_jump
8056              	        PAGE_TAIL 1
8056 C3 59 80     	bank_jump: JP stream_bank_tail
                 	; The alternate bank is active here. AF' already holds the extracted code;
                 	; alternate HL is still needed by the next decode, so save/restore it around
                 	; the fixed-RAM descriptor walk. BC/DE are the usual paging/cursor scratches.
                 	; A three-byte descriptor is paging byte,source high byte,Scorpion1FFD byte.
                 	; Zero paging marks an exhausted RAM batch; only insufficient RAM reloads.
                 	stream_bank_tail:
8059 22 2F BF     	        LD (stream_tail_hl),HL
805C 2A 2D BF     	        LD HL,(stream_next_record)
805F 7E           	        LD A,(HL)
8060 B7           	        OR A
8061 CA C5 BC     	        JP Z,stream_exhausted
8064 32 20 BF     	        LD (stream_paging),A
8067 23           	        INC HL
8068 56           	        LD D,(HL)
8069 1E 00        	        LD E,0
806B 23           	        INC HL
806C 7E           	        LD A,(HL)
806D 23           	        INC HL
806E 22 2D BF     	        LD (stream_next_record),HL
8071 2A 2F BF     	        LD HL,(stream_tail_hl)
                 	stream_high_switch:
8074 C3 7C 80     	        JP stream_high_done     ; Scorpion patches this to3 NOPs at cold boot
8077 01 FD 1F     	        LD BC,0x1FFD
807A ED 79        	        OUT (C),A
                 	stream_high_done:
807C 01 FD 7F     	        LD BC,0x7FFD
807F 3A 20 BF     	        LD A,(stream_paging)
                 	stream_page_event:
8082 ED 79        	        OUT (C),A
8084 D9           	        EXX
8085 37           	        SCF
8086 08           	        EX AF,AF'
8087 ED 41        	        OUT (C),B               ; release the saved pulse after paging
8089 E9           	        JP (HL)
                 	startup_hot_end:
808A              	        IF compact_stream_loader
                 	        ; Optional persistent loading helpers reuse fixed-bank2 startup
                 	        ; padding. They remain callable at every insufficient-RAM refill.
                 	        ; The bounce is mutable sector RAM, separately reserved after code;
                 	        ; neither region overlaps the live startup/tail or FIRST dictionary.
                 	stream_probe_start:
                 	
                 	; Loading-only extended-RAM cache, included in both transient controller and
                 	; fixed bank2. CACHE_STATE occupies16 unused packet-page bytes at5B70; callers
                 	; independently prove <=18 feedback entries (108 bytes) in each half-page.
                 	; All disk operations use a fixed-bank bounce buffer: TR-DOS is never asked
                 	; to preserve an extended7FFD/1FFD mapping. No cache code runs during PDM.
808A              	CACHE_STATE: EQU 0x5B70
808A              	cache_mode: EQU CACHE_STATE+2       ; 0=128,1=Scorpion,2=Pentagon512,3=Pentagon1024
808A              	cache_pages: EQU CACHE_STATE+3      ; distinct extra16-KiB pages,0/8/24/56
808A              	cache_start: EQU CACHE_STATE+4      ; linear first disk sector in this window
808A              	cache_count: EQU CACHE_STATE+6      ; number of valid cached256-byte sectors
808A              	cache_bar: EQU CACHE_STATE+8
808A              	cache_progress_enabled: EQU CACHE_STATE+9
808A              	cache_fraction: EQU CACHE_STATE+10
808A              	cache_total: EQU CACHE_STATE+12
808A              	cache_volume: EQU CACHE_STATE+14
                 	
                 	; A=physical RAM page,0..63. BC/DE/AF clobbered; HL preserved.
                 	; Shadow screen and48K ROM stay selected. Bit5 is never used on a512K
                 	; device: only the reversible EFF7 alias test may authorize the1024 mapping.
                 	cache_map:
808A 5F           	        LD E,A
808B 3A 72 5B     	        LD A,(cache_mode)
808E FE 01        	        CP 1
8090 20 10        	        JR NZ,cache_map_pentagon
8092 7B           	        LD A,E
8093 E6 08        	        AND 8
8095 87           	        ADD A,A
8096 01 FD 1F     	        LD BC,0x1FFD
8099 ED 79        	        OUT (C),A
809B 7B           	        LD A,E
809C E6 07        	        AND 7
809E F6 18        	        OR 24
80A0 18 12        	        JR cache_map_output
                 	cache_map_pentagon:
80A2 7B           	        LD A,E
80A3 E6 18        	        AND 24
80A5 07           	        RLCA
80A6 07           	        RLCA
80A7 07           	        RLCA
80A8 57           	        LD D,A
80A9 7B           	        LD A,E
80AA E6 20        	        AND 32
80AC B2           	        OR D
80AD 57           	        LD D,A
80AE 7B           	        LD A,E
80AF E6 07        	        AND 7
80B1 F6 18        	        OR 24
80B3 B2           	        OR D
                 	cache_map_output:
80B4 01 FD 7F     	        LD BC,0x7FFD
80B7 ED 79        	        OUT (C),A
80B9 C9           	        RET
                 	
                 	; A=normal paging byte. Clear Scorpion's high RAM bit before returning to
                 	; ordinary banks; preserve AF'/IY and use no ROM while high RAM is paged.
                 	cache_restore:
80BA 5F           	        LD E,A
80BB 3A 72 5B     	        LD A,(cache_mode)
80BE FE 01        	        CP 1
80C0 20 06        	        JR NZ,cache_restore_low
80C2 AF           	        XOR A
80C3 01 FD 1F     	        LD BC,0x1FFD
80C6 ED 79        	        OUT (C),A
                 	cache_restore_low:
80C8 7B           	        LD A,E
80C9 01 FD 7F     	        LD BC,0x7FFD
80CC ED 79        	        OUT (C),A
80CE C9           	        RET
                 	
                 	; Test two physical page selectors without destroying either original byte.
                 	; Private ref/candidate fields are outside paged RAM. Z=alias,NZ=distinct.
                 	; Even when both selectors alias, both saved originals are identical because
                 	; they are captured before either test write. Interrupts must be disabled.
                 	cache_alias:
80CF 3A 14 BF     	        LD A,(cache_ref)
80D2 CD 8A 80     	        CALL cache_map
80D5 3A 00 C0     	        LD A,(0xC000)
80D8 32 17 BF     	        LD (cache_ref_byte),A
80DB 3A 15 BF     	        LD A,(cache_candidate)
80DE CD 8A 80     	        CALL cache_map
80E1 3A 00 C0     	        LD A,(0xC000)
80E4 32 18 BF     	        LD (cache_candidate_byte),A
80E7 3A 14 BF     	        LD A,(cache_ref)
80EA CD 8A 80     	        CALL cache_map
80ED 3E 55        	        LD A,0x55
80EF 32 00 C0     	        LD (0xC000),A
80F2 3A 15 BF     	        LD A,(cache_candidate)
80F5 CD 8A 80     	        CALL cache_map
80F8 3E AA        	        LD A,0xAA
80FA 32 00 C0     	        LD (0xC000),A
80FD 3A 14 BF     	        LD A,(cache_ref)
8100 CD 8A 80     	        CALL cache_map
8103 3A 00 C0     	        LD A,(0xC000)
8106 FE 55        	        CP 0x55
8108 3E 00        	        LD A,0
810A 20 01        	        JR NZ,cache_alias_saved
810C 3C           	        INC A
                 	cache_alias_saved:
810D 32 19 BF     	        LD (cache_distinct),A
8110 3A 15 BF     	        LD A,(cache_candidate)
8113 CD 8A 80     	        CALL cache_map
8116 3A 18 BF     	        LD A,(cache_candidate_byte)
8119 32 00 C0     	        LD (0xC000),A
811C 3A 14 BF     	        LD A,(cache_ref)
811F CD 8A 80     	        CALL cache_map
8122 3A 17 BF     	        LD A,(cache_ref_byte)
8125 32 00 C0     	        LD (0xC000),A
8128 3A 19 BF     	        LD A,(cache_distinct)
812B B7           	        OR A
812C C9           	        RET
                 	
                 	; Cold initialization: probe Scorpion1FFD first, then safe Pentagon bits6/7.
                 	; EFF7 bit2 temporarily removes Pentagon1024 high RAM bits without asserting
                 	; 7FFD's lock bit. A512K machine ignores it and remains distinct. Verify every
                 	; candidate against all earlier pages, so mirrored expansion cannot inflate
                 	; the reported capacity. Every probe restores original RAM and normal paging.
                 	cache_detect:
812D F3           	        DI
812E AF           	        XOR A
812F 21 70 5B     	        LD HL,CACHE_STATE
8132 11 71 5B     	        LD DE,CACHE_STATE+1
8135 01 0F 00     	        LD BC,15
8138 77           	        LD (HL),A
8139 ED B0        	        LDIR
813B 32 14 BF     	        LD (cache_ref),A
813E 3E 08        	        LD A,8
8140 32 15 BF     	        LD (cache_candidate),A
8143 3E 01        	        LD A,1
8145 32 72 5B     	        LD (cache_mode),A
8148 CD CF 80     	        CALL cache_alias
814B 20 2E        	        JR NZ,cache_detect_scorpion
814D 3E 18        	        LD A,24
814F CD BA 80     	        CALL cache_restore
8152 3E 02        	        LD A,2
8154 32 72 5B     	        LD (cache_mode),A
8157 CD CF 80     	        CALL cache_alias
815A 28 55        	        JR Z,cache_detect_none
815C 01 F7 EF     	        LD BC,0xEFF7
815F 3E 04        	        LD A,4
8161 ED 79        	        OUT (C),A
8163 CD CF 80     	        CALL cache_alias
8166 F5           	        PUSH AF
8167 01 F7 EF     	        LD BC,0xEFF7
816A AF           	        XOR A
816B ED 79        	        OUT (C),A
816D F1           	        POP AF
816E 3E 20        	        LD A,32
8170 20 0B        	        JR NZ,cache_detect_limit
8172 3E 03        	        LD A,3
8174 32 72 5B     	        LD (cache_mode),A
8177 3E 40        	        LD A,64
8179 18 02        	        JR cache_detect_limit
                 	cache_detect_scorpion:
817B 3E 10        	        LD A,16
                 	cache_detect_limit:
817D 32 16 BF     	        LD (cache_limit),A
8180 3E 08        	        LD A,8
8182 32 15 BF     	        LD (cache_candidate),A
                 	cache_detect_next:
8185 AF           	        XOR A
8186 32 14 BF     	        LD (cache_ref),A
                 	cache_detect_reference:
8189 CD CF 80     	        CALL cache_alias
818C 28 27        	        JR Z,cache_detect_done
818E 3A 14 BF     	        LD A,(cache_ref)
8191 3C           	        INC A
8192 32 14 BF     	        LD (cache_ref),A
8195 21 15 BF     	        LD HL,cache_candidate
8198 BE           	        CP (HL)
8199 38 EE        	        JR C,cache_detect_reference
819B 3A 73 5B     	        LD A,(cache_pages)
819E 3C           	        INC A
819F 32 73 5B     	        LD (cache_pages),A
81A2 3A 15 BF     	        LD A,(cache_candidate)
81A5 3C           	        INC A
81A6 32 15 BF     	        LD (cache_candidate),A
81A9 21 16 BF     	        LD HL,cache_limit
81AC BE           	        CP (HL)
81AD 38 D6        	        JR C,cache_detect_next
81AF 18 04        	        JR cache_detect_done
                 	cache_detect_none:
81B1 AF           	        XOR A
81B2 32 72 5B     	        LD (cache_mode),A
                 	cache_detect_done:
81B5 3E 18        	        LD A,24
81B7 CD BA 80     	        CALL cache_restore
81BA 21 52 43     	        LD HL,0x4352            ; 'RC',little endian
81BD 22 70 5B     	        LD (CACHE_STATE),HL
81C0 C9           	        RET
                 	
81C1              	        INCLUDE "stream-probe.asm"
                 	stream_probe_end:
81C1              	stream_bounce: DEFS 256
82C1              	        ENDIF
                 	startup_end:
82C1              	        ASSERT $ <= first_base
82C1              	        DS first_base-$
8340              	PULSE: MACRO
