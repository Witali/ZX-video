                 	resident_end:
                 	        ; Loading-only worker follows the complete universal dictionary.
                 	        ; Its origin changes no live instruction, paging tail or SP lookup.
BC40              	        ASSERT $ <= worker_origin
BC40              	        IF compact_stream_loader
BC40              	        ASSERT $ == worker_origin
BC40              	        ENDIF
BC40              	        DS worker_origin-$
                 	
                 	; Loading/reload work stays in fixed bank2. TR-DOS always reads a fixed bounce
                 	; buffer with normal RAM selected, then a sector is copied into its final
                 	; physical page. There are no copies/ROM calls between live banks when RAM fits.
                 	; In compact mode the same persistent probe and bounce occupy startup padding;
                 	; the false branch below preserves every default opcode/address and TRD byte.
BC40              	        IF compact_stream_loader
BC40              	        ELSE
                 	stream_probe_start:
BC40              	        INCLUDE "stream-probe.asm"
                 	stream_probe_end:
BC40              	        ENDIF
                 	
                 	stream_cold_start:
BC40 F3           	        DI
BC41 31 00 60     	        LD SP,0x6000
BC44 FD 21 3A 5C  	        LD IY,0x5C3A
BC48 ED 56        	        IM 1
BC4A AF           	        XOR A
BC4B D3 FE        	        OUT (0xFE),A
BC4D 01 FD 1F     	        LD BC,0x1FFD
BC50 ED 79        	        OUT (C),A
BC52 01 FD 7F     	        LD BC,0x7FFD
BC55 3E 1F        	        LD A,31
BC57 ED 79        	        OUT (C),A
BC59 11 0D 08     	        LD DE,cover_disk
BC5C 21 00 C0     	        LD HL,0xC000
BC5F 06 1B        	        LD B,27
BC61 CD 3E BE     	        CALL stream_read_n
                 	cover_visible:
BC64 11 01 05     	        LD DE,lower_disk
BC67 21 00 40     	        LD HL,0x4000
BC6A 06 1C        	        LD B,28
BC6C CD 3E BE     	        CALL stream_read_n
BC6F 11 0D 06     	        LD DE,upper_disk
BC72 21 00 60     	        LD HL,0x6000
BC75 06 20        	        LD B,32
BC77 CD 3E BE     	        CALL stream_read_n
BC7A CD 2D 81     	        CALL cache_detect       ; only after lookup sectors, so no state overlap
BC7D 3A 73 5B     	        LD A,(cache_pages)
BC80 C6 06        	        ADD A,6
BC82 32 1B BF     	        LD (stream_bank_limit),A
BC85 3A 72 5B     	        LD A,(cache_mode)
BC88 FE 01        	        CP 1
BC8A 20 0A        	        JR NZ,stream_patch_pentagon
BC8C AF           	        XOR A
BC8D 32 74 80     	        LD (stream_high_switch),A
BC90 32 75 80     	        LD (stream_high_switch+1),A
BC93 32 76 80     	        LD (stream_high_switch+2),A
                 	stream_patch_pentagon:
BC96 CD 6C BE     	        CALL stream_patch_first
BC99 21 A8 00     	        LD HL,audio_sector
BC9C 22 23 BF     	        LD (stream_disk_sector),HL
BC9F 21 08 00     	        LD HL,audio_sectors
BCA2 22 25 BF     	        LD (stream_remaining),HL
BCA5 CD 0E BD     	        CALL stream_load_chunk
BCA8 01 FD FF     	        LD BC,0xFFFD
BCAB 3E 08        	        LD A,8
                 	stream_mute_ay:
BCAD ED 79        	        OUT (C),A
BCAF F5           	        PUSH AF
BCB0 01 FD BF     	        LD BC,0xBFFD
BCB3 AF           	        XOR A
BCB4 ED 79        	        OUT (C),A
BCB6 01 FD FF     	        LD BC,0xFFFD
BCB9 F1           	        POP AF
BCBA 3C           	        INC A
BCBB FE 0B        	        CP 11
BCBD 38 EE        	        JR C,stream_mute_ay
                 	stream_loaded:
BCBF FB           	        EI
BCC0 76           	        HALT
BCC1 F3           	        DI
BCC2 C3 03 80     	        JP ready
                 	
                 	; Preserve all live main/alternate registers and the lookup SP across a slow
                 	; insufficient-RAM refill. Incoming DE is replaced by the new first descriptor
                 	; on return, while prefetched predictor/code/row and PDM feedback remain exact.
                 	stream_exhausted:
BCC5 2A 25 BF     	        LD HL,(stream_remaining)
BCC8 7C           	        LD A,H
BCC9 B5           	        OR L
BCCA CA 8A BE     	        JP Z,stream_finish
                 	stream_reload_begin:
BCCD 2A 2F BF     	        LD HL,(stream_tail_hl)
BCD0 ED 73 31 BF  	        LD (stream_lookup_sp),SP
BCD4 31 00 60     	        LD SP,0x6000
BCD7 F5           	        PUSH AF
BCD8 C5           	        PUSH BC
BCD9 D5           	        PUSH DE
BCDA E5           	        PUSH HL
BCDB DD E5        	        PUSH IX
BCDD FD E5        	        PUSH IY
BCDF D9           	        EXX
BCE0 C5           	        PUSH BC
BCE1 D5           	        PUSH DE
BCE2 E5           	        PUSH HL
BCE3 08           	        EX AF,AF'
BCE4 F5           	        PUSH AF
BCE5 08           	        EX AF,AF'
BCE6 D9           	        EXX
BCE7 FD 21 3A 5C  	        LD IY,0x5C3A
BCEB AF           	        XOR A
BCEC D3 FE        	        OUT (0xFE),A
BCEE CD 0E BD     	        CALL stream_load_chunk
BCF1 21 46 BF     	        LD HL,stream_records
BCF4 22 2D BF     	        LD (stream_next_record),HL
BCF7 D9           	        EXX
BCF8 08           	        EX AF,AF'
BCF9 F1           	        POP AF
BCFA 08           	        EX AF,AF'
BCFB E1           	        POP HL
BCFC D1           	        POP DE
BCFD C1           	        POP BC
BCFE D9           	        EXX
BCFF FD E1        	        POP IY
BD01 DD E1        	        POP IX
BD03 E1           	        POP HL
BD04 D1           	        POP DE
BD05 C1           	        POP BC
BD06 F1           	        POP AF
BD07 ED 7B 31 BF  	        LD SP,(stream_lookup_sp)
                 	stream_reload_end:
BD0B C3 59 80     	        JP stream_bank_tail
                 	
                 	; Allocate a complete physical-page batch in source order. Bank7 preserves
                 	; its6912-byte shadow screen; bank2/5 remain code/table/workspace. Others offer
                 	;64 sectors. Each source slice ends atFFFF so the existing page-tail detector
                 	; needs no per-sample length comparison. Clear descriptors before refilling.
                 	stream_load_chunk:
BD0E F3           	        DI
BD0F 3E 18        	        LD A,24
BD11 CD BA 80     	        CALL cache_restore
BD14 3A 73 5B     	        LD A,(cache_pages)
BD17 47           	        LD B,A
BD18 0E 00        	        LD C,0
BD1A CB 38        	        SRL B
BD1C CB 19        	        RR C
BD1E CB 38        	        SRL B
BD20 CB 19        	        RR C
BD22 21 65 01     	        LD HL,357
BD25 09           	        ADD HL,BC
BD26 ED 5B 25 BF  	        LD DE,(stream_remaining)
BD2A B7           	        OR A
BD2B ED 52        	        SBC HL,DE
BD2D 38 04        	        JR C,stream_chunk_capacity
BD2F 42           	        LD B,D
BD30 4B           	        LD C,E
BD31 18 03        	        JR stream_chunk_total
                 	stream_chunk_capacity:
BD33 19           	        ADD HL,DE
BD34 44           	        LD B,H
BD35 4D           	        LD C,L
                 	stream_chunk_total:
BD36 ED 43 7C 5B  	        LD (cache_total),BC
BD3A 21 00 00     	        LD HL,0
BD3D 22 7A 5B     	        LD (cache_fraction),HL
BD40 AF           	        XOR A
BD41 32 78 5B     	        LD (cache_bar),A
BD44 32 1C BF     	        LD (stream_bank_index),A
BD47 3C           	        INC A
BD48 32 79 5B     	        LD (cache_progress_enabled),A
BD4B CD F1 BE     	        CALL cache_draw_bar
BD4E 21 46 BF     	        LD HL,stream_records
BD51 22 27 BF     	        LD (stream_record_write),HL
                 	stream_allocate:
BD54 3A 1C BF     	        LD A,(stream_bank_index)
BD57 FE 06        	        CP 6
BD59 30 0A        	        JR NC,stream_extended_bank
BD5B 5F           	        LD E,A
BD5C 16 00        	        LD D,0
BD5E 21 33 BF     	        LD HL,stream_base_banks
BD61 19           	        ADD HL,DE
BD62 7E           	        LD A,(HL)
BD63 18 02        	        JR stream_bank_selected
                 	stream_extended_bank:
BD65 C6 02        	        ADD A,2
                 	stream_bank_selected:
BD67 32 1D BF     	        LD (stream_physical),A
BD6A 11 40 00     	        LD DE,64
BD6D FE 07        	        CP 7
BD6F 20 02        	        JR NZ,stream_capacity_known
BD71 1E 25        	        LD E,37
                 	stream_capacity_known:
BD73 2A 25 BF     	        LD HL,(stream_remaining)
BD76 B7           	        OR A
BD77 ED 52        	        SBC HL,DE
BD79 30 05        	        JR NC,stream_full_page
BD7B 19           	        ADD HL,DE
BD7C 5D           	        LD E,L
BD7D 21 00 00     	        LD HL,0
                 	stream_full_page:
BD80 22 25 BF     	        LD (stream_remaining),HL
BD83 7B           	        LD A,E
BD84 32 1E BF     	        LD (stream_sector_count),A
BD87 ED 44        	        NEG                     ; high address=256-sector_count
BD89 32 1F BF     	        LD (stream_address_high),A
BD8C 67           	        LD H,A
BD8D 2E 00        	        LD L,0
BD8F 22 29 BF     	        LD (stream_destination),HL
                 	        ; Build paging metadata separately from the live tail. Scorpion uses
                 	        ; only low7FFD bits and1FFD bit4; Pentagon high bits are authorized by
                 	        ; the detector. No512K record can assert the7FFD lock bit.
BD92 2A 27 BF     	        LD HL,(stream_record_write)
BD95 3A 1D BF     	        LD A,(stream_physical)
BD98 5F           	        LD E,A
BD99 E6 07        	        AND 7
BD9B F6 18        	        OR 24
BD9D 57           	        LD D,A
BD9E 3A 72 5B     	        LD A,(cache_mode)
BDA1 FE 01        	        CP 1
BDA3 28 0D        	        JR Z,stream_record_scorpion
BDA5 7B           	        LD A,E
BDA6 E6 18        	        AND 24
BDA8 07           	        RLCA
BDA9 07           	        RLCA
BDAA 07           	        RLCA
BDAB B2           	        OR D
BDAC 57           	        LD D,A
BDAD 7B           	        LD A,E
BDAE E6 20        	        AND 32
BDB0 B2           	        OR D
BDB1 57           	        LD D,A
                 	stream_record_scorpion:
BDB2 72           	        LD (HL),D
BDB3 23           	        INC HL
BDB4 3A 1F BF     	        LD A,(stream_address_high)
BDB7 77           	        LD (HL),A
BDB8 23           	        INC HL
BDB9 7B           	        LD A,E
BDBA E6 08        	        AND 8
BDBC 87           	        ADD A,A
BDBD 77           	        LD (HL),A
BDBE 23           	        INC HL
BDBF 22 27 BF     	        LD (stream_record_write),HL
                 	stream_sector_next:
BDC2 3E 18        	        LD A,24
BDC4 CD BA 80     	        CALL cache_restore
BDC7 2A 23 BF     	        LD HL,(stream_disk_sector)
BDCA 7D           	        LD A,L
BDCB E6 0F        	        AND 15
BDCD 5F           	        LD E,A
BDCE CB 3C        	        SRL H
BDD0 CB 1D        	        RR L
BDD2 CB 3C        	        SRL H
BDD4 CB 1D        	        RR L
BDD6 CB 3C        	        SRL H
BDD8 CB 1D        	        RR L
BDDA CB 3C        	        SRL H
BDDC CB 1D        	        RR L
BDDE 55           	        LD D,L
BDDF 21 C1 81     	        LD HL,stream_bounce
BDE2 01 05 01     	        LD BC,0x0105
BDE5 FB           	        EI
                 	stream_disk_call:
BDE6 CD 13 3D     	        CALL 0x3D13
BDE9 F3           	        DI
BDEA 3A 1D BF     	        LD A,(stream_physical)
BDED CD 8A 80     	        CALL cache_map
BDF0 21 C1 81     	        LD HL,stream_bounce
BDF3 ED 5B 29 BF  	        LD DE,(stream_destination)
BDF7 01 00 01     	        LD BC,256
BDFA ED B0        	        LDIR
BDFC ED 53 29 BF  	        LD (stream_destination),DE
BE00 2A 23 BF     	        LD HL,(stream_disk_sector)
BE03 23           	        INC HL
BE04 22 23 BF     	        LD (stream_disk_sector),HL
BE07 CD C2 BE     	        CALL cache_progress
BE0A 21 1E BF     	        LD HL,stream_sector_count
BE0D 35           	        DEC (HL)
BE0E 20 B2        	        JR NZ,stream_sector_next
BE10 21 1C BF     	        LD HL,stream_bank_index
BE13 34           	        INC (HL)
BE14 7E           	        LD A,(HL)
BE15 21 1B BF     	        LD HL,stream_bank_limit
BE18 BE           	        CP (HL)
BE19 30 08        	        JR NC,stream_chunk_loaded
BE1B 2A 25 BF     	        LD HL,(stream_remaining)
BE1E 7C           	        LD A,H
BE1F B5           	        OR L
BE20 C2 54 BD     	        JP NZ,stream_allocate
                 	stream_chunk_loaded:
BE23 2A 27 BF     	        LD HL,(stream_record_write)
BE26 36 00        	        LD (HL),0
BE28 3A 47 BF     	        LD A,(stream_records+1)
BE2B 67           	        LD H,A
BE2C 2E 00        	        LD L,0
BE2E 22 2B BF     	        LD (stream_first_address),HL
BE31 21 49 BF     	        LD HL,stream_records+3
BE34 22 2D BF     	        LD (stream_next_record),HL
BE37 3E 18        	        LD A,24
BE39 CD BA 80     	        CALL cache_restore
BE3C F3           	        DI
BE3D C9           	        RET
                 	
                 	; Ordinary bank2/5/shadow loads at cold boot; ROM owns register scratches.
                 	stream_read_n:
BE3E ED 53 21 BF  	        LD (stream_rom_position),DE
                 	stream_read_next:
BE42 C5           	        PUSH BC
BE43 E5           	        PUSH HL
BE44 ED 5B 21 BF  	        LD DE,(stream_rom_position)
BE48 01 05 01     	        LD BC,0x0105
BE4B FB           	        EI
BE4C CD 13 3D     	        CALL 0x3D13
BE4F F3           	        DI
BE50 E1           	        POP HL
BE51 C1           	        POP BC
BE52 24           	        INC H
BE53 ED 5B 21 BF  	        LD DE,(stream_rom_position)
BE57 1C           	        INC E
BE58 CB 63        	        BIT 4,E
BE5A 28 03        	        JR Z,stream_rom_sector_ok
BE5C 1E 00        	        LD E,0
BE5E 14           	        INC D
                 	stream_rom_sector_ok:
BE5F ED 53 21 BF  	        LD (stream_rom_position),DE
BE63 10 DD        	        DJNZ stream_read_next
BE65 C9           	        RET
                 	
                 	; Pentagon-only register-preserving pacing: JP10 +4 NOPs16 +old JP(IY)8,
                 	; ordinary delta26 T.128/Scorpion retain their original JP(IY), delta0.
                 	hardware_delay:
BE66 00           	        NOP
BE67 00           	        NOP
BE68 00           	        NOP
BE69 00           	        NOP
BE6A FD E9        	        JP (IY)
                 	stream_patch_first:
BE6C 3A 72 5B     	        LD A,(cache_mode)
BE6F FE 02        	        CP 2
BE71 D8           	        RET C
BE72 11 66 BE     	        LD DE,hardware_delay
BE75 21 67 83     	        LD HL,first_base+first_size-3
BE78 06 8B        	        LD B,first_patterns
                 	stream_patch_loop:
BE7A 36 C3        	        LD (HL),0xC3
BE7C 23           	        INC HL
BE7D 73           	        LD (HL),E
BE7E 23           	        INC HL
BE7F 72           	        LD (HL),D
BE80 7D           	        LD A,L
BE81 C6 28        	        ADD A,first_size-2
BE83 6F           	        LD L,A
BE84 30 01        	        JR NC,stream_patch_next
BE86 24           	        INC H
                 	stream_patch_next:
BE87 10 F1        	        DJNZ stream_patch_loop
BE89 C9           	        RET
                 	
                 	stream_finish:
BE8A F3           	        DI
BE8B 31 00 60     	        LD SP,0x6000
BE8E FD 21 3A 5C  	        LD IY,0x5C3A
BE92 AF           	        XOR A
BE93 D3 FE        	        OUT (0xFE),A
BE95 3E 1F        	        LD A,31
BE97 CD BA 80     	        CALL cache_restore
BE9A 21 39 BF     	        LD HL,stream_end_message
BE9D 11 80 D0     	        LD DE,0xD080           ; footer bitmap at y160,keep the title visible
                 	stream_print:
BEA0 7E           	        LD A,(HL)
BEA1 B7           	        OR A
BEA2 28 1A        	        JR Z,stream_finished
BEA4 23           	        INC HL
BEA5 E5           	        PUSH HL
BEA6 6F           	        LD L,A
BEA7 26 00        	        LD H,0
BEA9 29           	        ADD HL,HL
BEAA 29           	        ADD HL,HL
BEAB 29           	        ADD HL,HL
BEAC 01 00 3C     	        LD BC,0x3C00
BEAF 09           	        ADD HL,BC
BEB0 D5           	        PUSH DE
BEB1 06 08        	        LD B,8
                 	stream_glyph:
BEB3 7E           	        LD A,(HL)
BEB4 12           	        LD (DE),A
BEB5 23           	        INC HL
BEB6 14           	        INC D
BEB7 10 FA        	        DJNZ stream_glyph
BEB9 D1           	        POP DE
BEBA 1C           	        INC E
BEBB E1           	        POP HL
BEBC 18 E2        	        JR stream_print
                 	stream_finished:
BEBE FB           	        EI
BEBF 76           	        HALT
BEC0 18 FC        	        JR stream_finished
                 	
                 	
                 	; Loading-only exact sector progress. A short batch can publish several
                 	; cells per sector, so subtract repeatedly instead of assuming total>=32.
                 	; HL/DE/BC/AF scratch. No code here runs during live audio.
                 	cache_progress:
BEC2 3A 79 5B     	        LD A,(cache_progress_enabled)
BEC5 B7           	        OR A
BEC6 C8           	        RET Z
BEC7 2A 7A 5B     	        LD HL,(cache_fraction)
BECA 11 20 00     	        LD DE,32
BECD 19           	        ADD HL,DE
                 	cache_progress_compare:
BECE ED 5B 7C 5B  	        LD DE,(cache_total)
BED2 B7           	        OR A
BED3 ED 52        	        SBC HL,DE
BED5 38 15        	        JR C,cache_progress_remainder
BED7 22 7A 5B     	        LD (cache_fraction),HL
BEDA 3A 78 5B     	        LD A,(cache_bar)
BEDD FE 20        	        CP 32
BEDF D0           	        RET NC
BEE0 3C           	        INC A
BEE1 32 78 5B     	        LD (cache_bar),A
                 	cache_progress_event:
BEE4 CD F1 BE     	        CALL cache_draw_bar
BEE7 2A 7A 5B     	        LD HL,(cache_fraction)
BEEA 18 E2        	        JR cache_progress_compare
                 	cache_progress_remainder:
BEEC 19           	        ADD HL,DE
BEED 22 7A 5B     	        LD (cache_fraction),HL
BEF0 C9           	        RET
                 	
                 	; Shadow screen is always bank7. Restore normal bank0 before enabling IRQs;
                 	; loader explicitly maps the next destination before each physical copy.
                 	cache_draw_bar:
BEF1 F3           	        DI
BEF2 3E 1F        	        LD A,31
BEF4 CD BA 80     	        CALL cache_restore
BEF7 21 C0 DA     	        LD HL,0xDAC0
BEFA 3A 78 5B     	        LD A,(cache_bar)
BEFD 5F           	        LD E,A
BEFE 06 20        	        LD B,32
                 	cache_draw_cell:
BF00 7B           	        LD A,E
BF01 B7           	        OR A
BF02 3E 04        	        LD A,4
BF04 28 03        	        JR Z,cache_draw_empty
BF06 1D           	        DEC E
BF07 3E 24        	        LD A,0x24
                 	cache_draw_empty:
BF09 77           	        LD (HL),A
BF0A 23           	        INC HL
BF0B 10 F3        	        DJNZ cache_draw_cell
BF0D 3E 18        	        LD A,24
BF0F CD BA 80     	        CALL cache_restore
BF12 FB           	        EI
BF13 C9           	        RET
BF14              	        INCLUDE "stream-progress.asm"
BF14 00           	cache_ref: DEFB 0
BF15 08           	cache_candidate: DEFB 8
BF16 00           	cache_limit: DEFB 0
BF17 00           	cache_ref_byte: DEFB 0
BF18 00           	cache_candidate_byte: DEFB 0
BF19 00           	cache_distinct: DEFB 0
BF1A 18           	cache_destination_page: DEFB 24
BF1B 06           	stream_bank_limit: DEFB 6
BF1C 00           	stream_bank_index: DEFB 0
BF1D 00           	stream_physical: DEFB 0
BF1E 00           	stream_sector_count: DEFB 0
BF1F 00           	stream_address_high: DEFB 0
BF20 18           	stream_paging: DEFB 24
BF21 00 00        	stream_rom_position: DEFW 0
BF23 00 00        	stream_disk_sector: DEFW 0
BF25 00 00        	stream_remaining: DEFW 0
BF27 00 00        	stream_record_write: DEFW 0
BF29 00 00        	stream_destination: DEFW 0
BF2B 00 00        	stream_first_address: DEFW 0
BF2D 00 00        	stream_next_record: DEFW 0
BF2F 00 00        	stream_tail_hl: DEFW 0
BF31 00 00        	stream_lookup_sp: DEFW 0
BF33 07           	stream_base_banks: DEFB 0,4,6,1,3,7
BF39 00           	stream_end_message: DEFM "END OF AUDIO",0
BF46              	stream_records: DEFS record_slots*3+1
BF4D              	        IF compact_stream_loader
BF4D              	        ELSE
BF4D              	stream_bounce: DEFS 256
BF4D              	        ENDIF
                 	stream_worker_end:
BF4D              	        INCLUDE "stream-worker.asm"
                 	player_end:
BF4D              	        ASSERT $ < 0xBFFF
BF4D              	        DS 0xBFFF-$
BFFF 00           	        DEFB 0
