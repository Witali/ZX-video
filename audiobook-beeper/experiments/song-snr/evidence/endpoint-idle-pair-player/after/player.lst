B267              		ENDIF
B267              		PULSE ((255)>>2) & 1
B267 E6 0F        		AND 15
B269 07           		RLCA
B26A 07           		RLCA
B26B              		IF ((255)>>1) & 1
B26B ED 51        		OUT (C),D
B26D              		ELSE
B26D              		DB 0xED,0x71
B26D              		ENDIF
B26D              		PULSE ((255)>>1) & 1
B26D C3 70 B2     		JP $+3
B270 00           		NOP
B271 00           		NOP
B272 00           		NOP
B273              		IF (255) & 1
B273 ED 51        		OUT (C),D
B275              		ELSE
B275              		DB 0xED,0x71
B275              		ENDIF
B275              		PULSE (255) & 1
B275 E9           		JP (HL)
B276              		IF ((255)>>3) & 1
B276 ED 51        		OUT (C),D
B278              		ELSE
B278              		DB 0xED,0x71
B278              		ENDIF
B278              		PULSE ((255)>>3) & 1
B278 08           		EX AF,AF'
B279 D9           		EXX
B27A 1A           		LD A,(DE)
B27B D9           		EXX
B27C              		IF ((255)>>2) & 1
B27C ED 51        		OUT (C),D
B27E              		ELSE
B27E              		DB 0xED,0x71
B27E              		ENDIF
B27E              		PULSE ((255)>>2) & 1
B27E E6 F0        		AND 240
B280 0F           		RRCA
B281 0F           		RRCA
B282              		IF ((255)>>1) & 1
B282 ED 51        		OUT (C),D
B284              		ELSE
B284              		DB 0xED,0x71
B284              		ENDIF
B284              		PULSE ((255)>>1) & 1
B284 D9           		EXX
B285 1C           		INC E
B286              		IF (255) & 1
B286 CA 46 80     		JP Z,page_tail_1
B289              		ELSE
B289              		JP Z,page_tail_0
B289              		ENDIF
B289 D9           		EXX
B28A              		IF (255) & 1
B28A ED 51        		OUT (C),D
B28C              		ELSE
