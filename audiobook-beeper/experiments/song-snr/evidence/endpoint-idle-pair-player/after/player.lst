B25A              		PULSE ((255)>>4) & 1
B25A 08           		EX AF,AF'
B25B 3F           		CCF
B25C DA 76 B2     		JP C,$+26
B25F              		IF ((255)>>3) & 1
B25F ED 51        		OUT (C),D
B261              		ELSE
B261              		DB 0xED,0x71
B261              		ENDIF
B261              		PULSE ((255)>>3) & 1
B261 08           		EX AF,AF'
B262 D9           		EXX
B263 1A           		LD A,(DE)
B264 D9           		EXX
B265              		IF ((255)>>2) & 1
B265 ED 51        		OUT (C),D
