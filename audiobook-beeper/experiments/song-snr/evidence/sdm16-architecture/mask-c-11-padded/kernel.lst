8007 6F           	 LD L,A
8008 F9           	 LD SP,HL
8009 C1           	 POP BC
800A E1           	 POP HL
800B DD 09        	 ADD IX,BC
800D D9           	 EXX
800E DD 54        	 LD D,IXH
8010 DD 5D        	 LD E,IXL
8012 ED 5F        	 LD A,R
8014 00           	 NOP
8015 19           	 ADD HL,DE
8016 9F           	 SBC A,A
8017 A1           	 AND C
