B500 A2 04 C0 B5 E7 0D C0 B5 2C 17 C0 B5 71 20 C0 B5 B7 29 C0 B2 FC 32 80 B1 41 3C 80 B3 86 45 C0 B4 5E FB C0 B5 19 F2 C0 B5 D4 E8 C0 B5 8F DF C0 B5 49 D6 C0 B2 04 CD 80 B1 BF C3 80 B3 7A BA C0 B4 00 00 40 B5 01 00 40 B5 03 00 40 B5 04 00 40 B5 07 00 80 40 08 00 80 41 0A 00 80 42 0B 00 C0 B6 00 00 40 B5 FF FF 40 B5 FD FF 40 B5 FC FF 40 B5 F9 FF 80 40 F8 FF 80 41 F6 FF 80 42 F5 FF C0 B6 EE 0A C0 B4 CA 20 C0 B4 A6 36 C0 B4 82 4C C0 B4 5F 62 80 B6 3B 78 C0 63 17 8E C0 63 F3 A3 C0 63 12 F5 C0 B4 36 DF C0 B4 5A C9 C0 B4 7E B3 C0 B4 A1 9D 80 B6 C5 87 C0 63 E9 71 C0 63 0D 5C C0 63 36 04 40 B6 A3 0C 40 B6 11 15 40 B6 7E 1D 40 B6 EC 25 C0 B3 59 2E C0 B1 C7 36 80 B2 34 3F 80 B4 CA FB 40 B6 5D F3 40 B6 EF EA 40 B6 82 E2 40 B6 14 DA C0 B3 A7 D1 C0 B1 39 C9 80 B2 CC C0 80 B4 05 0C 80 B5 10 24 80 B5 1C 3C 80 B5 27 54 80 B5 34 6C 80 63 3F 84 C0 63 4B 9C C0 63 56 B4 C0 63 FB F3 80 B5 F0 DB 80 B5 E4 C3 80 B5 D9 AB 80 B5 CC 93 80 63 C1 7B C0 63 B5 63 C0 63 AA 4B C0 63 D4 03 C0 62 7D 0B C0 62 26 13 C0 62 CF 1A C0 62 79 22 00 B5 22 2A C0 B2 CB 31 80 B1 74 39 80 B3 2C FC C0 62 83 F4 C0 62 DA EC C0 62 31 E5 C0 62 87 DD 00 B5 DE D5 C0 B2 35 CE 80 B1 8C C6 80 B3 39 0D 00 B6 AC 27 00 B6 20 42 00 B6 93 5C 00 B6 07 77 C0 63 7A 91 C0 63 EE AB C0 63 61 C6 C0 63 C7 F2 00 B6 54 D8 00 B6 E0 BD 00 B6 6D A3 00 B6 F9 88 C0 63 86 6E C0 63 12 54 C0 63 9F 39 C0 63 02 00 C0 42 06 00 C0 42 0A 00 C0 42 0E 00 C0 42 12 00 C0 43 16 00 C0 44 1A 00 C0 45 1E 00 00 B7 FE FF C0 42 FA FF C0 42 F6 FF C0 42 F2 FF C0 42 EE FF C0 43 EA FF C0 44 E6 FF C0 45 E2 FF 00 B7 04 00 80 46 0C 00 80 46 15 00 80 46 1D 00 80 46 26 00 80 47 2E 00 80 48 37 00 80 49 3F 00 40 B7 FC FF 80 46 F4 FF 80 46 EB FF 80 46 E3 FF 80 46 DA FF 80 47 D2 FF 80 48 C9 FF 80 49 C1 FF 40 B7 09 00 C0 49 1B 00 C0 49 2D 00 C0 49 3F 00 C0 49 52 00 C0 4A 64 00 C0 4B 76 00 C0 4C 88 00 80 B7 F7 FF C0 49 E5 FF C0 49 D3 FF C0 49 C1 FF C0 49 AE FF C0 4A 9C FF C0 4B 8A FF C0 4C 78 FF 80 B7 13 00 80 4D 3A 00 80 4D 61 00 80 4D 88 00 80 4D B0 00 80 4E D7 00 80 4F FE 00 80 50 25 01 C0 B7 ED FF 80 4D C6 FF 80 4D 9F FF 80 4D 78 FF 80 4D 50 FF 80 4E 29 FF 80 4F 02 FF 80 50 DB FE C0 B7 2A 00 C0 50 7E 00 C0 50 D2 00 C0 50 26 01 C0 50 7B 01 C0 51 CF 01 C0 52 23 02 C0 53 77 02 00 B8 D6 FF C0 50 82 FF C0 50 2E FF C0 50 DA FE C0 50 85 FE C0 51 31 FE C0 52 DD FD C0 53 89 FD 00 B8 5A 00 80 54 0F 01 80 54 C4 01 80 54 79 02 80 54 2E 03 80 55 E3 03 80 56 98 04 80 57 4D 05 40 B8 A6 FF 80 54 F1 FE 80 54 3C FE 80 54 87 FD 80 54 D2 FC 80 55 1D FC 80 56 68 FB 80 57 B3 FA 40 B8 C2 00 C0 57 46 02 C0 57 CA 03 C0 57 4E 05 C0 57 D2 06 C0 58 56 08 C0 59 DA 09 C0 5A 5E 0B 80 B8 3E FF C0 57 BA FD C0 57 36 FC C0 57 B2 FA C0 57 2E F9 C0 58 AA F7 C0 59 26 F6 C0 5A A2 F4 80 B8 9F 01 80 5B DE 04 80 5B 1E 08 80 5B 5D 0B 80 5B 9E 0E C0 B8 DD 11 C0 60 1D 15 C0 61 5C 18 C0 62 61 FE 80 5B 22 FB 80 5B E2 F7 80 5B A3 F4 80 5B 62 F1 C0 B8 23 EE C0 60 E3 EA C0 61 A4 E7 C0 62 F7 01 C0 5B E5 05 C0 5B D4 09 C0 5B C2 0D C0 5B B1 11 C0 60 9F 15 C0 61 8E 19 C0 62 7C 1D C0 B5 09 FE C0 5B 1B FA C0 5B 2C F6 C0 5B 3E F2 C0 5B 4F EE C0 60 61 EA C0 61 72 E6 C0 62 84 E2 C0 B5 01 00 40 B5 03 00 40 B5 05 00 40 B5 07 00 40 B5 09 00 C0 40 0B 00 C0 41 0D 00 C0 42 0F 00 80 43 FF FF 40 B5 FD FF 40 B5 FB FF 40 B5 F9 FF 40 B5 F7 FF C0 40 F5 FF C0 41 F3 FF C0 42 F1 FF 80 43 	        MDAT "decoder-extra.bin"
                 	resident_end:
                 	        ; Loading-only worker follows the complete universal dictionary.
                 	        ; Its origin changes no live instruction, paging tail or SP lookup.
B940              	        ASSERT $ <= worker_origin
B940              	        DS worker_origin-$
                 	
                 	; Loading/reload work stays in fixed bank2. TR-DOS always reads a fixed bounce
                 	; buffer with normal RAM selected, then a sector is copied into its final
                 	; physical page. There are no copies/ROM calls between live banks when RAM fits.
                 	
                 	; Loading-only extended-RAM cache, included in both transient controller and
                 	; fixed bank2. CACHE_STATE occupies16 unused packet-page bytes at5B70; callers
                 	; independently prove <=18 feedback entries (108 bytes) in each half-page.
                 	; All disk operations use a fixed-bank bounce buffer: TR-DOS is never asked
                 	; to preserve an extended7FFD/1FFD mapping. No cache code runs during PDM.
BA00              	CACHE_STATE: EQU 0x5B70
BA00              	cache_mode: EQU CACHE_STATE+2       ; 0=128,1=Scorpion,2=Pentagon512,3=Pentagon1024
BA00              	cache_pages: EQU CACHE_STATE+3      ; distinct extra16-KiB pages,0/8/24/56
BA00              	cache_start: EQU CACHE_STATE+4      ; linear first disk sector in this window
BA00              	cache_count: EQU CACHE_STATE+6      ; number of valid cached256-byte sectors
BA00              	cache_bar: EQU CACHE_STATE+8
BA00              	cache_progress_enabled: EQU CACHE_STATE+9
BA00              	cache_fraction: EQU CACHE_STATE+10
BA00              	cache_total: EQU CACHE_STATE+12
BA00              	cache_volume: EQU CACHE_STATE+14
                 	
                 	; A=physical RAM page,0..63. BC/DE/AF clobbered; HL preserved.
                 	; Shadow screen and48K ROM stay selected. Bit5 is never used on a512K
                 	; device: only the reversible EFF7 alias test may authorize the1024 mapping.
                 	cache_map:
BA00 5F           	        LD E,A
BA01 3A 72 5B     	        LD A,(cache_mode)
BA04 FE 01        	        CP 1
BA06 20 10        	        JR NZ,cache_map_pentagon
BA08 7B           	        LD A,E
BA09 E6 08        	        AND 8
BA0B 87           	        ADD A,A
BA0C 01 FD 1F     	        LD BC,0x1FFD
BA0F ED 79        	        OUT (C),A
BA11 7B           	        LD A,E
BA12 E6 07        	        AND 7
BA14 F6 18        	        OR 24
BA16 18 12        	        JR cache_map_output
                 	cache_map_pentagon:
BA18 7B           	        LD A,E
BA19 E6 18        	        AND 24
BA1B 07           	        RLCA
BA1C 07           	        RLCA
BA1D 07           	        RLCA
BA1E 57           	        LD D,A
BA1F 7B           	        LD A,E
BA20 E6 20        	        AND 32
BA22 B2           	        OR D
BA23 57           	        LD D,A
BA24 7B           	        LD A,E
BA25 E6 07        	        AND 7
BA27 F6 18        	        OR 24
BA29 B2           	        OR D
                 	cache_map_output:
BA2A 01 FD 7F     	        LD BC,0x7FFD
BA2D ED 79        	        OUT (C),A
BA2F C9           	        RET
                 	
                 	; A=normal paging byte. Clear Scorpion's high RAM bit before returning to
                 	; ordinary banks; preserve AF'/IY and use no ROM while high RAM is paged.
                 	cache_restore:
BA30 5F           	        LD E,A
BA31 3A 72 5B     	        LD A,(cache_mode)
BA34 FE 01        	        CP 1
BA36 20 06        	        JR NZ,cache_restore_low
BA38 AF           	        XOR A
BA39 01 FD 1F     	        LD BC,0x1FFD
BA3C ED 79        	        OUT (C),A
                 	cache_restore_low:
BA3E 7B           	        LD A,E
BA3F 01 FD 7F     	        LD BC,0x7FFD
BA42 ED 79        	        OUT (C),A
BA44 C9           	        RET
                 	
                 	; Test two physical page selectors without destroying either original byte.
                 	; Private ref/candidate fields are outside paged RAM. Z=alias,NZ=distinct.
                 	; Even when both selectors alias, both saved originals are identical because
                 	; they are captured before either test write. Interrupts must be disabled.
                 	cache_alias:
BA45 3A 0B BE     	        LD A,(cache_ref)
BA48 CD 00 BA     	        CALL cache_map
BA4B 3A 00 C0     	        LD A,(0xC000)
BA4E 32 0E BE     	        LD (cache_ref_byte),A
BA51 3A 0C BE     	        LD A,(cache_candidate)
BA54 CD 00 BA     	        CALL cache_map
BA57 3A 00 C0     	        LD A,(0xC000)
BA5A 32 0F BE     	        LD (cache_candidate_byte),A
BA5D 3A 0B BE     	        LD A,(cache_ref)
BA60 CD 00 BA     	        CALL cache_map
BA63 3E 55        	        LD A,0x55
BA65 32 00 C0     	        LD (0xC000),A
BA68 3A 0C BE     	        LD A,(cache_candidate)
BA6B CD 00 BA     	        CALL cache_map
BA6E 3E AA        	        LD A,0xAA
BA70 32 00 C0     	        LD (0xC000),A
BA73 3A 0B BE     	        LD A,(cache_ref)
BA76 CD 00 BA     	        CALL cache_map
BA79 3A 00 C0     	        LD A,(0xC000)
BA7C FE 55        	        CP 0x55
BA7E 3E 00        	        LD A,0
BA80 20 01        	        JR NZ,cache_alias_saved
BA82 3C           	        INC A
                 	cache_alias_saved:
BA83 32 10 BE     	        LD (cache_distinct),A
BA86 3A 0C BE     	        LD A,(cache_candidate)
BA89 CD 00 BA     	        CALL cache_map
BA8C 3A 0F BE     	        LD A,(cache_candidate_byte)
BA8F 32 00 C0     	        LD (0xC000),A
BA92 3A 0B BE     	        LD A,(cache_ref)
BA95 CD 00 BA     	        CALL cache_map
BA98 3A 0E BE     	        LD A,(cache_ref_byte)
BA9B 32 00 C0     	        LD (0xC000),A
BA9E 3A 10 BE     	        LD A,(cache_distinct)
BAA1 B7           	        OR A
BAA2 C9           	        RET
                 	
                 	; Cold initialization: probe Scorpion1FFD first, then safe Pentagon bits6/7.
                 	; EFF7 bit2 temporarily removes Pentagon1024 high RAM bits without asserting
                 	; 7FFD's lock bit. A512K machine ignores it and remains distinct. Verify every
                 	; candidate against all earlier pages, so mirrored expansion cannot inflate
                 	; the reported capacity. Every probe restores original RAM and normal paging.
                 	cache_detect:
BAA3 F3           	        DI
BAA4 AF           	        XOR A
BAA5 21 70 5B     	        LD HL,CACHE_STATE
BAA8 11 71 5B     	        LD DE,CACHE_STATE+1
BAAB 01 0F 00     	        LD BC,15
BAAE 77           	        LD (HL),A
BAAF ED B0        	        LDIR
BAB1 32 0B BE     	        LD (cache_ref),A
BAB4 3E 08        	        LD A,8
BAB6 32 0C BE     	        LD (cache_candidate),A
BAB9 3E 01        	        LD A,1
BABB 32 72 5B     	        LD (cache_mode),A
BABE CD 45 BA     	        CALL cache_alias
BAC1 20 2E        	        JR NZ,cache_detect_scorpion
BAC3 3E 18        	        LD A,24
BAC5 CD 30 BA     	        CALL cache_restore
BAC8 3E 02        	        LD A,2
BACA 32 72 5B     	        LD (cache_mode),A
BACD CD 45 BA     	        CALL cache_alias
BAD0 28 55        	        JR Z,cache_detect_none
BAD2 01 F7 EF     	        LD BC,0xEFF7
BAD5 3E 04        	        LD A,4
BAD7 ED 79        	        OUT (C),A
BAD9 CD 45 BA     	        CALL cache_alias
BADC F5           	        PUSH AF
BADD 01 F7 EF     	        LD BC,0xEFF7
BAE0 AF           	        XOR A
BAE1 ED 79        	        OUT (C),A
BAE3 F1           	        POP AF
BAE4 3E 20        	        LD A,32
BAE6 20 0B        	        JR NZ,cache_detect_limit
BAE8 3E 03        	        LD A,3
BAEA 32 72 5B     	        LD (cache_mode),A
BAED 3E 40        	        LD A,64
BAEF 18 02        	        JR cache_detect_limit
                 	cache_detect_scorpion:
BAF1 3E 10        	        LD A,16
                 	cache_detect_limit:
BAF3 32 0D BE     	        LD (cache_limit),A
BAF6 3E 08        	        LD A,8
BAF8 32 0C BE     	        LD (cache_candidate),A
                 	cache_detect_next:
BAFB AF           	        XOR A
BAFC 32 0B BE     	        LD (cache_ref),A
                 	cache_detect_reference:
BAFF CD 45 BA     	        CALL cache_alias
BB02 28 27        	        JR Z,cache_detect_done
BB04 3A 0B BE     	        LD A,(cache_ref)
BB07 3C           	        INC A
BB08 32 0B BE     	        LD (cache_ref),A
BB0B 21 0C BE     	        LD HL,cache_candidate
BB0E BE           	        CP (HL)
BB0F 38 EE        	        JR C,cache_detect_reference
BB11 3A 73 5B     	        LD A,(cache_pages)
BB14 3C           	        INC A
BB15 32 73 5B     	        LD (cache_pages),A
BB18 3A 0C BE     	        LD A,(cache_candidate)
BB1B 3C           	        INC A
BB1C 32 0C BE     	        LD (cache_candidate),A
BB1F 21 0D BE     	        LD HL,cache_limit
BB22 BE           	        CP (HL)
BB23 38 D6        	        JR C,cache_detect_next
BB25 18 04        	        JR cache_detect_done
                 	cache_detect_none:
BB27 AF           	        XOR A
BB28 32 72 5B     	        LD (cache_mode),A
                 	cache_detect_done:
BB2B 3E 18        	        LD A,24
BB2D CD 30 BA     	        CALL cache_restore
BB30 21 52 43     	        LD HL,0x4352            ; 'RC',little endian
BB33 22 70 5B     	        LD (CACHE_STATE),HL
BB36 C9           	        RET
                 	
BB37              	        INCLUDE "stream-probe.asm"
                 	
                 	stream_cold_start:
BB37 F3           	        DI
BB38 31 00 60     	        LD SP,0x6000
BB3B FD 21 3A 5C  	        LD IY,0x5C3A
BB3F ED 56        	        IM 1
BB41 AF           	        XOR A
BB42 D3 FE        	        OUT (0xFE),A
BB44 01 FD 1F     	        LD BC,0x1FFD
BB47 ED 79        	        OUT (C),A
BB49 01 FD 7F     	        LD BC,0x7FFD
BB4C 3E 1F        	        LD A,31
BB4E ED 79        	        OUT (C),A
BB50 11 0D 08     	        LD DE,cover_disk
BB53 21 00 C0     	        LD HL,0xC000
BB56 06 1B        	        LD B,27
BB58 CD 35 BD     	        CALL stream_read_n
                 	cover_visible:
BB5B 11 01 05     	        LD DE,lower_disk
BB5E 21 00 40     	        LD HL,0x4000
BB61 06 1C        	        LD B,28
BB63 CD 35 BD     	        CALL stream_read_n
BB66 11 0D 06     	        LD DE,upper_disk
BB69 21 00 60     	        LD HL,0x6000
BB6C 06 20        	        LD B,32
BB6E CD 35 BD     	        CALL stream_read_n
BB71 CD A3 BA     	        CALL cache_detect       ; only after lookup sectors, so no state overlap
BB74 3A 73 5B     	        LD A,(cache_pages)
BB77 C6 06        	        ADD A,6
BB79 32 12 BE     	        LD (stream_bank_limit),A
BB7C 3A 72 5B     	        LD A,(cache_mode)
BB7F FE 01        	        CP 1
BB81 20 0A        	        JR NZ,stream_patch_pentagon
BB83 AF           	        XOR A
BB84 32 74 80     	        LD (stream_high_switch),A
BB87 32 75 80     	        LD (stream_high_switch+1),A
BB8A 32 76 80     	        LD (stream_high_switch+2),A
                 	stream_patch_pentagon:
BB8D CD 63 BD     	        CALL stream_patch_first
BB90 21 A8 00     	        LD HL,audio_sector
BB93 22 1A BE     	        LD (stream_disk_sector),HL
BB96 21 21 00     	        LD HL,audio_sectors
BB99 22 1C BE     	        LD (stream_remaining),HL
BB9C CD 05 BC     	        CALL stream_load_chunk
BB9F 01 FD FF     	        LD BC,0xFFFD
BBA2 3E 08        	        LD A,8
                 	stream_mute_ay:
BBA4 ED 79        	        OUT (C),A
BBA6 F5           	        PUSH AF
BBA7 01 FD BF     	        LD BC,0xBFFD
BBAA AF           	        XOR A
BBAB ED 79        	        OUT (C),A
BBAD 01 FD FF     	        LD BC,0xFFFD
BBB0 F1           	        POP AF
BBB1 3C           	        INC A
BBB2 FE 0B        	        CP 11
BBB4 38 EE        	        JR C,stream_mute_ay
                 	stream_loaded:
BBB6 FB           	        EI
BBB7 76           	        HALT
BBB8 F3           	        DI
BBB9 C3 03 80     	        JP ready
                 	
                 	; Preserve all live main/alternate registers and the lookup SP across a slow
                 	; insufficient-RAM refill. Incoming DE is replaced by the new first descriptor
                 	; on return, while prefetched predictor/code/row and PDM feedback remain exact.
                 	stream_exhausted:
BBBC 2A 1C BE     	        LD HL,(stream_remaining)
BBBF 7C           	        LD A,H
BBC0 B5           	        OR L
BBC1 CA 81 BD     	        JP Z,stream_finish
                 	stream_reload_begin:
BBC4 2A 26 BE     	        LD HL,(stream_tail_hl)
BBC7 ED 73 28 BE  	        LD (stream_lookup_sp),SP
BBCB 31 00 60     	        LD SP,0x6000
BBCE F5           	        PUSH AF
BBCF C5           	        PUSH BC
BBD0 D5           	        PUSH DE
BBD1 E5           	        PUSH HL
BBD2 DD E5        	        PUSH IX
BBD4 FD E5        	        PUSH IY
BBD6 D9           	        EXX
BBD7 C5           	        PUSH BC
BBD8 D5           	        PUSH DE
BBD9 E5           	        PUSH HL
BBDA 08           	        EX AF,AF'
BBDB F5           	        PUSH AF
BBDC 08           	        EX AF,AF'
BBDD D9           	        EXX
BBDE FD 21 3A 5C  	        LD IY,0x5C3A
BBE2 AF           	        XOR A
BBE3 D3 FE        	        OUT (0xFE),A
BBE5 CD 05 BC     	        CALL stream_load_chunk
BBE8 21 3D BE     	        LD HL,stream_records
BBEB 22 24 BE     	        LD (stream_next_record),HL
BBEE D9           	        EXX
BBEF 08           	        EX AF,AF'
BBF0 F1           	        POP AF
BBF1 08           	        EX AF,AF'
BBF2 E1           	        POP HL
BBF3 D1           	        POP DE
BBF4 C1           	        POP BC
BBF5 D9           	        EXX
BBF6 FD E1        	        POP IY
BBF8 DD E1        	        POP IX
BBFA E1           	        POP HL
BBFB D1           	        POP DE
BBFC C1           	        POP BC
BBFD F1           	        POP AF
BBFE ED 7B 28 BE  	        LD SP,(stream_lookup_sp)
                 	stream_reload_end:
BC02 C3 59 80     	        JP stream_bank_tail
                 	
                 	; Allocate a complete physical-page batch in source order. Bank7 preserves
                 	; its6912-byte shadow screen; bank2/5 remain code/table/workspace. Others offer
                 	;64 sectors. Each source slice ends atFFFF so the existing page-tail detector
                 	; needs no per-sample length comparison. Clear descriptors before refilling.
                 	stream_load_chunk:
BC05 F3           	        DI
BC06 3E 18        	        LD A,24
BC08 CD 30 BA     	        CALL cache_restore
BC0B 3A 73 5B     	        LD A,(cache_pages)
BC0E 47           	        LD B,A
BC0F 0E 00        	        LD C,0
BC11 CB 38        	        SRL B
BC13 CB 19        	        RR C
BC15 CB 38        	        SRL B
BC17 CB 19        	        RR C
BC19 21 65 01     	        LD HL,357
BC1C 09           	        ADD HL,BC
BC1D ED 5B 1C BE  	        LD DE,(stream_remaining)
BC21 B7           	        OR A
BC22 ED 52        	        SBC HL,DE
BC24 38 04        	        JR C,stream_chunk_capacity
BC26 42           	        LD B,D
BC27 4B           	        LD C,E
BC28 18 03        	        JR stream_chunk_total
                 	stream_chunk_capacity:
BC2A 19           	        ADD HL,DE
BC2B 44           	        LD B,H
BC2C 4D           	        LD C,L
                 	stream_chunk_total:
BC2D ED 43 7C 5B  	        LD (cache_total),BC
BC31 21 00 00     	        LD HL,0
BC34 22 7A 5B     	        LD (cache_fraction),HL
BC37 AF           	        XOR A
BC38 32 78 5B     	        LD (cache_bar),A
BC3B 32 13 BE     	        LD (stream_bank_index),A
BC3E 3C           	        INC A
BC3F 32 79 5B     	        LD (cache_progress_enabled),A
BC42 CD E8 BD     	        CALL cache_draw_bar
BC45 21 3D BE     	        LD HL,stream_records
BC48 22 1E BE     	        LD (stream_record_write),HL
                 	stream_allocate:
BC4B 3A 13 BE     	        LD A,(stream_bank_index)
BC4E FE 06        	        CP 6
BC50 30 0A        	        JR NC,stream_extended_bank
BC52 5F           	        LD E,A
BC53 16 00        	        LD D,0
BC55 21 2A BE     	        LD HL,stream_base_banks
BC58 19           	        ADD HL,DE
BC59 7E           	        LD A,(HL)
BC5A 18 02        	        JR stream_bank_selected
                 	stream_extended_bank:
BC5C C6 02        	        ADD A,2
                 	stream_bank_selected:
BC5E 32 14 BE     	        LD (stream_physical),A
BC61 11 40 00     	        LD DE,64
BC64 FE 07        	        CP 7
BC66 20 02        	        JR NZ,stream_capacity_known
BC68 1E 25        	        LD E,37
                 	stream_capacity_known:
BC6A 2A 1C BE     	        LD HL,(stream_remaining)
BC6D B7           	        OR A
BC6E ED 52        	        SBC HL,DE
BC70 30 05        	        JR NC,stream_full_page
BC72 19           	        ADD HL,DE
BC73 5D           	        LD E,L
BC74 21 00 00     	        LD HL,0
                 	stream_full_page:
BC77 22 1C BE     	        LD (stream_remaining),HL
BC7A 7B           	        LD A,E
BC7B 32 15 BE     	        LD (stream_sector_count),A
BC7E ED 44        	        NEG                     ; high address=256-sector_count
BC80 32 16 BE     	        LD (stream_address_high),A
BC83 67           	        LD H,A
BC84 2E 00        	        LD L,0
BC86 22 20 BE     	        LD (stream_destination),HL
                 	        ; Build paging metadata separately from the live tail. Scorpion uses
                 	        ; only low7FFD bits and1FFD bit4; Pentagon high bits are authorized by
                 	        ; the detector. No512K record can assert the7FFD lock bit.
BC89 2A 1E BE     	        LD HL,(stream_record_write)
BC8C 3A 14 BE     	        LD A,(stream_physical)
BC8F 5F           	        LD E,A
BC90 E6 07        	        AND 7
BC92 F6 18        	        OR 24
BC94 57           	        LD D,A
BC95 3A 72 5B     	        LD A,(cache_mode)
BC98 FE 01        	        CP 1
BC9A 28 0D        	        JR Z,stream_record_scorpion
BC9C 7B           	        LD A,E
BC9D E6 18        	        AND 24
BC9F 07           	        RLCA
BCA0 07           	        RLCA
BCA1 07           	        RLCA
BCA2 B2           	        OR D
BCA3 57           	        LD D,A
BCA4 7B           	        LD A,E
BCA5 E6 20        	        AND 32
BCA7 B2           	        OR D
BCA8 57           	        LD D,A
                 	stream_record_scorpion:
BCA9 72           	        LD (HL),D
BCAA 23           	        INC HL
BCAB 3A 16 BE     	        LD A,(stream_address_high)
BCAE 77           	        LD (HL),A
BCAF 23           	        INC HL
BCB0 7B           	        LD A,E
BCB1 E6 08        	        AND 8
BCB3 87           	        ADD A,A
BCB4 77           	        LD (HL),A
BCB5 23           	        INC HL
BCB6 22 1E BE     	        LD (stream_record_write),HL
                 	stream_sector_next:
BCB9 3E 18        	        LD A,24
BCBB CD 30 BA     	        CALL cache_restore
BCBE 2A 1A BE     	        LD HL,(stream_disk_sector)
BCC1 7D           	        LD A,L
BCC2 E6 0F        	        AND 15
BCC4 5F           	        LD E,A
BCC5 CB 3C        	        SRL H
BCC7 CB 1D        	        RR L
BCC9 CB 3C        	        SRL H
BCCB CB 1D        	        RR L
BCCD CB 3C        	        SRL H
BCCF CB 1D        	        RR L
BCD1 CB 3C        	        SRL H
BCD3 CB 1D        	        RR L
BCD5 55           	        LD D,L
BCD6 21 44 BE     	        LD HL,stream_bounce
BCD9 01 05 01     	        LD BC,0x0105
BCDC FB           	        EI
                 	stream_disk_call:
BCDD CD 13 3D     	        CALL 0x3D13
BCE0 F3           	        DI
BCE1 3A 14 BE     	        LD A,(stream_physical)
BCE4 CD 00 BA     	        CALL cache_map
BCE7 21 44 BE     	        LD HL,stream_bounce
BCEA ED 5B 20 BE  	        LD DE,(stream_destination)
BCEE 01 00 01     	        LD BC,256
BCF1 ED B0        	        LDIR
BCF3 ED 53 20 BE  	        LD (stream_destination),DE
BCF7 2A 1A BE     	        LD HL,(stream_disk_sector)
BCFA 23           	        INC HL
BCFB 22 1A BE     	        LD (stream_disk_sector),HL
BCFE CD B9 BD     	        CALL cache_progress
BD01 21 15 BE     	        LD HL,stream_sector_count
BD04 35           	        DEC (HL)
BD05 20 B2        	        JR NZ,stream_sector_next
BD07 21 13 BE     	        LD HL,stream_bank_index
BD0A 34           	        INC (HL)
BD0B 7E           	        LD A,(HL)
BD0C 21 12 BE     	        LD HL,stream_bank_limit
BD0F BE           	        CP (HL)
BD10 30 08        	        JR NC,stream_chunk_loaded
BD12 2A 1C BE     	        LD HL,(stream_remaining)
BD15 7C           	        LD A,H
BD16 B5           	        OR L
BD17 C2 4B BC     	        JP NZ,stream_allocate
                 	stream_chunk_loaded:
BD1A 2A 1E BE     	        LD HL,(stream_record_write)
BD1D 36 00        	        LD (HL),0
BD1F 3A 3E BE     	        LD A,(stream_records+1)
BD22 67           	        LD H,A
BD23 2E 00        	        LD L,0
BD25 22 22 BE     	        LD (stream_first_address),HL
BD28 21 40 BE     	        LD HL,stream_records+3
BD2B 22 24 BE     	        LD (stream_next_record),HL
BD2E 3E 18        	        LD A,24
BD30 CD 30 BA     	        CALL cache_restore
BD33 F3           	        DI
BD34 C9           	        RET
                 	
                 	; Ordinary bank2/5/shadow loads at cold boot; ROM owns register scratches.
                 	stream_read_n:
BD35 ED 53 18 BE  	        LD (stream_rom_position),DE
                 	stream_read_next:
BD39 C5           	        PUSH BC
BD3A E5           	        PUSH HL
BD3B ED 5B 18 BE  	        LD DE,(stream_rom_position)
BD3F 01 05 01     	        LD BC,0x0105
BD42 FB           	        EI
BD43 CD 13 3D     	        CALL 0x3D13
BD46 F3           	        DI
BD47 E1           	        POP HL
BD48 C1           	        POP BC
BD49 24           	        INC H
BD4A ED 5B 18 BE  	        LD DE,(stream_rom_position)
BD4E 1C           	        INC E
BD4F CB 63        	        BIT 4,E
BD51 28 03        	        JR Z,stream_rom_sector_ok
BD53 1E 00        	        LD E,0
BD55 14           	        INC D
                 	stream_rom_sector_ok:
BD56 ED 53 18 BE  	        LD (stream_rom_position),DE
BD5A 10 DD        	        DJNZ stream_read_next
BD5C C9           	        RET
                 	
                 	; Pentagon-only register-preserving pacing: JP10 +4 NOPs16 +old JP(IY)8,
                 	; ordinary delta26 T.128/Scorpion retain their original JP(IY), delta0.
                 	hardware_delay:
BD5D 00           	        NOP
BD5E 00           	        NOP
BD5F 00           	        NOP
BD60 00           	        NOP
BD61 FD E9        	        JP (IY)
                 	stream_patch_first:
BD63 3A 72 5B     	        LD A,(cache_mode)
BD66 FE 02        	        CP 2
BD68 D8           	        RET C
BD69 11 5D BD     	        LD DE,hardware_delay
BD6C 21 67 83     	        LD HL,first_base+first_size-3
BD6F 06 82        	        LD B,first_patterns
                 	stream_patch_loop:
BD71 36 C3        	        LD (HL),0xC3
BD73 23           	        INC HL
BD74 73           	        LD (HL),E
BD75 23           	        INC HL
BD76 72           	        LD (HL),D
BD77 7D           	        LD A,L
BD78 C6 28        	        ADD A,first_size-2
BD7A 6F           	        LD L,A
BD7B 30 01        	        JR NC,stream_patch_next
BD7D 24           	        INC H
                 	stream_patch_next:
BD7E 10 F1        	        DJNZ stream_patch_loop
BD80 C9           	        RET
                 	
                 	stream_finish:
BD81 F3           	        DI
BD82 31 00 60     	        LD SP,0x6000
BD85 FD 21 3A 5C  	        LD IY,0x5C3A
BD89 AF           	        XOR A
BD8A D3 FE        	        OUT (0xFE),A
BD8C 3E 1F        	        LD A,31
BD8E CD 30 BA     	        CALL cache_restore
BD91 21 30 BE     	        LD HL,stream_end_message
BD94 11 80 D0     	        LD DE,0xD080           ; footer bitmap at y160,keep the title visible
                 	stream_print:
BD97 7E           	        LD A,(HL)
BD98 B7           	        OR A
BD99 28 1A        	        JR Z,stream_finished
BD9B 23           	        INC HL
BD9C E5           	        PUSH HL
BD9D 6F           	        LD L,A
BD9E 26 00        	        LD H,0
BDA0 29           	        ADD HL,HL
BDA1 29           	        ADD HL,HL
BDA2 29           	        ADD HL,HL
BDA3 01 00 3C     	        LD BC,0x3C00
BDA6 09           	        ADD HL,BC
BDA7 D5           	        PUSH DE
BDA8 06 08        	        LD B,8
                 	stream_glyph:
BDAA 7E           	        LD A,(HL)
BDAB 12           	        LD (DE),A
BDAC 23           	        INC HL
BDAD 14           	        INC D
BDAE 10 FA        	        DJNZ stream_glyph
BDB0 D1           	        POP DE
BDB1 1C           	        INC E
BDB2 E1           	        POP HL
BDB3 18 E2        	        JR stream_print
                 	stream_finished:
BDB5 FB           	        EI
BDB6 76           	        HALT
BDB7 18 FC        	        JR stream_finished
                 	
                 	
                 	; Loading-only exact sector progress. A short batch can publish several
                 	; cells per sector, so subtract repeatedly instead of assuming total>=32.
                 	; HL/DE/BC/AF scratch. No code here runs during live audio.
                 	cache_progress:
BDB9 3A 79 5B     	        LD A,(cache_progress_enabled)
BDBC B7           	        OR A
BDBD C8           	        RET Z
BDBE 2A 7A 5B     	        LD HL,(cache_fraction)
BDC1 11 20 00     	        LD DE,32
BDC4 19           	        ADD HL,DE
                 	cache_progress_compare:
BDC5 ED 5B 7C 5B  	        LD DE,(cache_total)
BDC9 B7           	        OR A
BDCA ED 52        	        SBC HL,DE
BDCC 38 15        	        JR C,cache_progress_remainder
BDCE 22 7A 5B     	        LD (cache_fraction),HL
BDD1 3A 78 5B     	        LD A,(cache_bar)
BDD4 FE 20        	        CP 32
BDD6 D0           	        RET NC
BDD7 3C           	        INC A
BDD8 32 78 5B     	        LD (cache_bar),A
                 	cache_progress_event:
BDDB CD E8 BD     	        CALL cache_draw_bar
BDDE 2A 7A 5B     	        LD HL,(cache_fraction)
BDE1 18 E2        	        JR cache_progress_compare
                 	cache_progress_remainder:
BDE3 19           	        ADD HL,DE
BDE4 22 7A 5B     	        LD (cache_fraction),HL
BDE7 C9           	        RET
                 	
                 	; Shadow screen is always bank7. Restore normal bank0 before enabling IRQs;
                 	; loader explicitly maps the next destination before each physical copy.
                 	cache_draw_bar:
BDE8 F3           	        DI
BDE9 3E 1F        	        LD A,31
BDEB CD 30 BA     	        CALL cache_restore
BDEE 21 C0 DA     	        LD HL,0xDAC0
BDF1 3A 78 5B     	        LD A,(cache_bar)
BDF4 5F           	        LD E,A
BDF5 06 20        	        LD B,32
                 	cache_draw_cell:
BDF7 7B           	        LD A,E
BDF8 B7           	        OR A
BDF9 3E 04        	        LD A,4
BDFB 28 03        	        JR Z,cache_draw_empty
BDFD 1D           	        DEC E
BDFE 3E 24        	        LD A,0x24
                 	cache_draw_empty:
BE00 77           	        LD (HL),A
BE01 23           	        INC HL
BE02 10 F3        	        DJNZ cache_draw_cell
BE04 3E 18        	        LD A,24
BE06 CD 30 BA     	        CALL cache_restore
BE09 FB           	        EI
BE0A C9           	        RET
BE0B              	        INCLUDE "stream-progress.asm"
BE0B 00           	cache_ref: DEFB 0
BE0C 08           	cache_candidate: DEFB 8
BE0D 00           	cache_limit: DEFB 0
BE0E 00           	cache_ref_byte: DEFB 0
BE0F 00           	cache_candidate_byte: DEFB 0
BE10 00           	cache_distinct: DEFB 0
BE11 18           	cache_destination_page: DEFB 24
BE12 06           	stream_bank_limit: DEFB 6
BE13 00           	stream_bank_index: DEFB 0
BE14 00           	stream_physical: DEFB 0
BE15 00           	stream_sector_count: DEFB 0
BE16 00           	stream_address_high: DEFB 0
BE17 18           	stream_paging: DEFB 24
BE18 00 00        	stream_rom_position: DEFW 0
BE1A 00 00        	stream_disk_sector: DEFW 0
BE1C 00 00        	stream_remaining: DEFW 0
BE1E 00 00        	stream_record_write: DEFW 0
BE20 00 00        	stream_destination: DEFW 0
BE22 00 00        	stream_first_address: DEFW 0
BE24 00 00        	stream_next_record: DEFW 0
BE26 00 00        	stream_tail_hl: DEFW 0
BE28 00 00        	stream_lookup_sp: DEFW 0
BE2A 07           	stream_base_banks: DEFB 0,4,6,1,3,7
BE30 00           	stream_end_message: DEFM "END OF AUDIO",0
BE3D              	stream_records: DEFS record_slots*3+1
BE44              	stream_bounce: DEFS 256
                 	stream_worker_end:
BF44              	        INCLUDE "stream-worker.asm"
                 	player_end:
BF44              	        ASSERT $ <= 0xC000
BF44              	        DS 0xBFFF-$
BFFF 00           	        DEFB 0
