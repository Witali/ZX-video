B700 02 00 80 40 06 00 80 40 0A 00 80 40 0E 00 80 40 12 00 80 41 16 00 80 42 1A 00 80 43 1E 00 40 B7 FE FF 80 40 FA FF 80 40 F6 FF 80 40 F2 FF 80 40 EE FF 80 41 EA FF 80 42 E6 FF 80 43 E2 FF 40 B7 04 00 C0 43 0C 00 C0 43 15 00 C0 43 1D 00 C0 43 26 00 C0 44 2E 00 C0 45 37 00 C0 46 3F 00 80 B7 FC FF C0 43 F4 FF C0 43 EB FF C0 43 E3 FF C0 43 DA FF C0 44 D2 FF C0 45 C9 FF C0 46 C1 FF 80 B7 09 00 80 47 1B 00 80 47 2D 00 80 47 3F 00 80 47 52 00 80 48 64 00 80 49 76 00 80 4A 88 00 C0 B7 F7 FF 80 47 E5 FF 80 47 D3 FF 80 47 C1 FF 80 47 AE FF 80 48 9C FF 80 49 8A FF 80 4A 78 FF C0 B7 13 00 C0 4A 3A 00 C0 4A 61 00 C0 4A 88 00 C0 4A B0 00 C0 4B D7 00 C0 4C FE 00 C0 4D 25 01 00 B8 ED FF C0 4A C6 FF C0 4A 9F FF C0 4A 78 FF C0 4A 50 FF C0 4B 29 FF C0 4C 02 FF C0 4D DB FE 00 B8 2A 00 80 4E 7E 00 80 4E D2 00 80 4E 26 01 80 4E 7B 01 80 4F CF 01 80 50 23 02 80 51 77 02 40 B8 D6 FF 80 4E 82 FF 80 4E 2E FF 80 4E DA FE 80 4E 85 FE 80 4F 31 FE 80 50 DD FD 80 51 89 FD 40 B8 5A 00 C0 51 0F 01 C0 51 C4 01 C0 51 79 02 C0 51 2E 03 C0 52 E3 03 C0 53 98 04 C0 54 4D 05 80 B8 A6 FF C0 51 F1 FE C0 51 3C FE C0 51 87 FD C0 51 D2 FC C0 52 1D FC C0 53 68 FB C0 54 B3 FA 80 B8 C2 00 80 55 46 02 80 55 CA 03 80 55 4E 05 80 55 D2 06 80 56 56 08 80 57 DA 09 80 58 5E 0B C0 B8 3E FF 80 55 BA FD 80 55 36 FC 80 55 B2 FA 80 55 2E F9 80 56 AA F7 80 57 26 F6 80 58 A2 F4 C0 B8 9F 01 C0 58 DE 04 C0 58 1E 08 C0 58 5D 0B C0 58 9E 0E C0 59 DD 11 C0 5A 1D 15 C0 5B 5C 18 00 B9 61 FE C0 58 22 FB C0 58 E2 F7 C0 58 A3 F4 C0 58 62 F1 C0 59 23 EE C0 5A E3 EA C0 5B A4 E7 00 B9 7B 03 80 B9 72 0A 80 B9 69 11 80 B9 60 18 80 B9 57 1F C0 60 4E 26 C0 61 45 2D C0 B6 3C 34 80 B4 85 FC 80 B9 8E F5 80 B9 97 EE 80 B9 A0 E7 80 B9 A9 E0 C0 60 B2 D9 C0 61 BB D2 C0 B6 C4 CB 80 B4 9B 05 C0 61 D2 10 C0 61 0A 1C C0 61 41 27 C0 61 7A 32 80 B5 B1 3D 80 B3 E9 48 C0 B4 20 54 80 62 65 FA C0 61 2E EF C0 61 F6 E3 C0 61 BF D8 C0 61 86 CD 80 B5 4F C2 80 B3 17 B7 C0 B4 E0 AB 80 62 2A 03 C0 5B 7F 09 C0 5B D4 0F C0 5B 29 16 C0 5B 7E 1C 80 60 D3 22 80 61 28 29 40 B9 7D 2F 80 B5 D6 FC C0 5B 81 F6 C0 5B 2C F0 C0 5B D7 E9 C0 5B 82 E3 80 60 2D DD 80 61 D8 D6 40 B9 83 D0 80 B5 01 00 C0 B5 03 00 C0 B5 05 00 C0 B5 07 00 C0 B5 09 00 40 BA 0B 00 C0 BA 0D 00 80 40 0F 00 C0 40 FF FF C0 B5 FD FF C0 B5 FB FF C0 B5 F9 FF C0 B5 F7 FF 40 BA F5 FF C0 BA F3 FF 80 40 F1 FF C0 40 01 00 C0 B9 03 00 C0 B9 05 00 C0 B9 07 00 C0 B9 0A 00 80 BA 0C 00 00 BB 0E 00 00 B7 10 00 80 41 FF FF C0 B9 FD FF C0 B9 FB FF C0 B9 F9 FF C0 B9 F6 FF 80 BA F4 FF 00 BB F2 FF 00 B7 F0 FF 80 41 01 00 00 BA 03 00 00 BA 06 00 00 BA 08 00 00 BA 0B 00 C0 BA 0D 00 80 40 10 00 C0 40 12 00 C0 41 FF FF 00 BA FD FF 00 BA FA FF 00 BA F8 FF 00 BA F5 FF C0 BA F3 FF 80 40 F0 FF C0 40 EE FF C0 41 01 00 40 BA 03 00 40 BA 06 00 40 BA 08 00 40 BA 0C 00 00 BB 0E 00 00 B7 11 00 80 41 13 00 80 42 FF FF 40 BA FD FF 40 BA FA FF 40 BA F8 FF 40 BA F4 FF 00 BB F2 FF 00 B7 EF FF 80 41 ED FF 80 42 01 00 80 BA 04 00 80 BA 07 00 80 BA 0A 00 80 BA 0D 00 80 40 10 00 C0 40 13 00 C0 41 16 00 C0 42 FF FF 80 BA FC FF 80 BA F9 FF 80 BA F6 FF 80 BA F3 FF 80 40 F0 FF C0 40 ED FF C0 41 EA FF C0 42 01 00 C0 BA 04 00 C0 BA 07 00 C0 BA 0A 00 C0 BA 0E 00 00 B7 11 00 80 41 14 00 80 42 17 00 80 43 FF FF C0 BA FC FF C0 BA F9 FF C0 BA F6 FF C0 BA F2 FF 00 B7 EF FF 80 41 EC FF 80 42 E9 FF 80 43 	        MDAT "decoder-extra.bin"
                 	resident_end:
                 	        ; Loading-only worker follows the complete universal dictionary.
                 	        ; Its origin changes no live instruction, paging tail or SP lookup.
BB40              	        ASSERT $ <= worker_origin
BB40              	        IF compact_stream_loader
BB40              	        ASSERT $ == worker_origin
BB40              	        ENDIF
BB40              	        DS worker_origin-$
                 	
                 	; Loading/reload work stays in fixed bank2. TR-DOS always reads a fixed bounce
                 	; buffer with normal RAM selected, then a sector is copied into its final
                 	; physical page. There are no copies/ROM calls between live banks when RAM fits.
                 	; In compact mode the same persistent probe and bounce occupy startup padding;
                 	; the false branch below preserves every default opcode/address and TRD byte.
BB40              	        IF compact_stream_loader
BB40              	        ELSE
                 	stream_probe_start:
BB40              	        INCLUDE "stream-probe.asm"
                 	stream_probe_end:
BB40              	        ENDIF
                 	
                 	stream_cold_start:
BB40 F3           	        DI
BB41 31 00 60     	        LD SP,0x6000
BB44 FD 21 3A 5C  	        LD IY,0x5C3A
BB48 ED 56        	        IM 1
BB4A AF           	        XOR A
BB4B D3 FE        	        OUT (0xFE),A
BB4D 01 FD 1F     	        LD BC,0x1FFD
BB50 ED 79        	        OUT (C),A
BB52 01 FD 7F     	        LD BC,0x7FFD
BB55 3E 1F        	        LD A,31
BB57 ED 79        	        OUT (C),A
BB59 11 0D 08     	        LD DE,cover_disk
BB5C 21 00 C0     	        LD HL,0xC000
BB5F 06 1B        	        LD B,27
BB61 CD 3E BD     	        CALL stream_read_n
                 	cover_visible:
BB64 11 01 05     	        LD DE,lower_disk
BB67 21 00 40     	        LD HL,0x4000
BB6A 06 1C        	        LD B,28
BB6C CD 3E BD     	        CALL stream_read_n
BB6F 11 0D 06     	        LD DE,upper_disk
BB72 21 00 60     	        LD HL,0x6000
BB75 06 20        	        LD B,32
BB77 CD 3E BD     	        CALL stream_read_n
BB7A CD 2D 81     	        CALL cache_detect       ; only after lookup sectors, so no state overlap
BB7D 3A 73 5B     	        LD A,(cache_pages)
BB80 C6 06        	        ADD A,6
BB82 32 1B BE     	        LD (stream_bank_limit),A
BB85 3A 72 5B     	        LD A,(cache_mode)
BB88 FE 01        	        CP 1
BB8A 20 0A        	        JR NZ,stream_patch_pentagon
BB8C AF           	        XOR A
BB8D 32 74 80     	        LD (stream_high_switch),A
BB90 32 75 80     	        LD (stream_high_switch+1),A
BB93 32 76 80     	        LD (stream_high_switch+2),A
                 	stream_patch_pentagon:
BB96 CD 6C BD     	        CALL stream_patch_first
BB99 21 A8 00     	        LD HL,audio_sector
BB9C 22 23 BE     	        LD (stream_disk_sector),HL
BB9F 21 08 00     	        LD HL,audio_sectors
BBA2 22 25 BE     	        LD (stream_remaining),HL
BBA5 CD 0E BC     	        CALL stream_load_chunk
BBA8 01 FD FF     	        LD BC,0xFFFD
BBAB 3E 08        	        LD A,8
                 	stream_mute_ay:
BBAD ED 79        	        OUT (C),A
BBAF F5           	        PUSH AF
BBB0 01 FD BF     	        LD BC,0xBFFD
BBB3 AF           	        XOR A
BBB4 ED 79        	        OUT (C),A
BBB6 01 FD FF     	        LD BC,0xFFFD
BBB9 F1           	        POP AF
BBBA 3C           	        INC A
BBBB FE 0B        	        CP 11
BBBD 38 EE        	        JR C,stream_mute_ay
                 	stream_loaded:
BBBF FB           	        EI
BBC0 76           	        HALT
BBC1 F3           	        DI
BBC2 C3 03 80     	        JP ready
                 	
                 	; Preserve all live main/alternate registers and the lookup SP across a slow
                 	; insufficient-RAM refill. Incoming DE is replaced by the new first descriptor
                 	; on return, while prefetched predictor/code/row and PDM feedback remain exact.
                 	stream_exhausted:
BBC5 2A 25 BE     	        LD HL,(stream_remaining)
BBC8 7C           	        LD A,H
BBC9 B5           	        OR L
BBCA CA 8A BD     	        JP Z,stream_finish
                 	stream_reload_begin:
BBCD 2A 2F BE     	        LD HL,(stream_tail_hl)
BBD0 ED 73 31 BE  	        LD (stream_lookup_sp),SP
BBD4 31 00 60     	        LD SP,0x6000
BBD7 F5           	        PUSH AF
BBD8 C5           	        PUSH BC
BBD9 D5           	        PUSH DE
BBDA E5           	        PUSH HL
BBDB DD E5        	        PUSH IX
BBDD FD E5        	        PUSH IY
BBDF D9           	        EXX
BBE0 C5           	        PUSH BC
BBE1 D5           	        PUSH DE
BBE2 E5           	        PUSH HL
BBE3 08           	        EX AF,AF'
BBE4 F5           	        PUSH AF
BBE5 08           	        EX AF,AF'
BBE6 D9           	        EXX
BBE7 FD 21 3A 5C  	        LD IY,0x5C3A
BBEB AF           	        XOR A
BBEC D3 FE        	        OUT (0xFE),A
BBEE CD 0E BC     	        CALL stream_load_chunk
BBF1 21 46 BE     	        LD HL,stream_records
BBF4 22 2D BE     	        LD (stream_next_record),HL
BBF7 D9           	        EXX
BBF8 08           	        EX AF,AF'
BBF9 F1           	        POP AF
BBFA 08           	        EX AF,AF'
BBFB E1           	        POP HL
BBFC D1           	        POP DE
BBFD C1           	        POP BC
BBFE D9           	        EXX
BBFF FD E1        	        POP IY
BC01 DD E1        	        POP IX
BC03 E1           	        POP HL
BC04 D1           	        POP DE
BC05 C1           	        POP BC
BC06 F1           	        POP AF
BC07 ED 7B 31 BE  	        LD SP,(stream_lookup_sp)
                 	stream_reload_end:
BC0B C3 59 80     	        JP stream_bank_tail
                 	
                 	; Allocate a complete physical-page batch in source order. Bank7 preserves
                 	; its6912-byte shadow screen; bank2/5 remain code/table/workspace. Others offer
                 	;64 sectors. Each source slice ends atFFFF so the existing page-tail detector
                 	; needs no per-sample length comparison. Clear descriptors before refilling.
                 	stream_load_chunk:
BC0E F3           	        DI
BC0F 3E 18        	        LD A,24
BC11 CD BA 80     	        CALL cache_restore
BC14 3A 73 5B     	        LD A,(cache_pages)
BC17 47           	        LD B,A
BC18 0E 00        	        LD C,0
BC1A CB 38        	        SRL B
BC1C CB 19        	        RR C
BC1E CB 38        	        SRL B
BC20 CB 19        	        RR C
BC22 21 65 01     	        LD HL,357
BC25 09           	        ADD HL,BC
BC26 ED 5B 25 BE  	        LD DE,(stream_remaining)
BC2A B7           	        OR A
BC2B ED 52        	        SBC HL,DE
BC2D 38 04        	        JR C,stream_chunk_capacity
BC2F 42           	        LD B,D
BC30 4B           	        LD C,E
BC31 18 03        	        JR stream_chunk_total
                 	stream_chunk_capacity:
BC33 19           	        ADD HL,DE
BC34 44           	        LD B,H
BC35 4D           	        LD C,L
                 	stream_chunk_total:
BC36 ED 43 7C 5B  	        LD (cache_total),BC
BC3A 21 00 00     	        LD HL,0
BC3D 22 7A 5B     	        LD (cache_fraction),HL
BC40 AF           	        XOR A
BC41 32 78 5B     	        LD (cache_bar),A
BC44 32 1C BE     	        LD (stream_bank_index),A
BC47 3C           	        INC A
BC48 32 79 5B     	        LD (cache_progress_enabled),A
BC4B CD F1 BD     	        CALL cache_draw_bar
BC4E 21 46 BE     	        LD HL,stream_records
BC51 22 27 BE     	        LD (stream_record_write),HL
                 	stream_allocate:
BC54 3A 1C BE     	        LD A,(stream_bank_index)
BC57 FE 06        	        CP 6
BC59 30 0A        	        JR NC,stream_extended_bank
BC5B 5F           	        LD E,A
BC5C 16 00        	        LD D,0
BC5E 21 33 BE     	        LD HL,stream_base_banks
BC61 19           	        ADD HL,DE
BC62 7E           	        LD A,(HL)
BC63 18 02        	        JR stream_bank_selected
                 	stream_extended_bank:
BC65 C6 02        	        ADD A,2
                 	stream_bank_selected:
BC67 32 1D BE     	        LD (stream_physical),A
BC6A 11 40 00     	        LD DE,64
BC6D FE 07        	        CP 7
BC6F 20 02        	        JR NZ,stream_capacity_known
BC71 1E 25        	        LD E,37
                 	stream_capacity_known:
BC73 2A 25 BE     	        LD HL,(stream_remaining)
BC76 B7           	        OR A
BC77 ED 52        	        SBC HL,DE
BC79 30 05        	        JR NC,stream_full_page
BC7B 19           	        ADD HL,DE
BC7C 5D           	        LD E,L
BC7D 21 00 00     	        LD HL,0
                 	stream_full_page:
BC80 22 25 BE     	        LD (stream_remaining),HL
BC83 7B           	        LD A,E
BC84 32 1E BE     	        LD (stream_sector_count),A
BC87 ED 44        	        NEG                     ; high address=256-sector_count
BC89 32 1F BE     	        LD (stream_address_high),A
BC8C 67           	        LD H,A
BC8D 2E 00        	        LD L,0
BC8F 22 29 BE     	        LD (stream_destination),HL
                 	        ; Build paging metadata separately from the live tail. Scorpion uses
                 	        ; only low7FFD bits and1FFD bit4; Pentagon high bits are authorized by
                 	        ; the detector. No512K record can assert the7FFD lock bit.
BC92 2A 27 BE     	        LD HL,(stream_record_write)
BC95 3A 1D BE     	        LD A,(stream_physical)
BC98 5F           	        LD E,A
BC99 E6 07        	        AND 7
BC9B F6 18        	        OR 24
BC9D 57           	        LD D,A
BC9E 3A 72 5B     	        LD A,(cache_mode)
BCA1 FE 01        	        CP 1
BCA3 28 0D        	        JR Z,stream_record_scorpion
BCA5 7B           	        LD A,E
BCA6 E6 18        	        AND 24
BCA8 07           	        RLCA
BCA9 07           	        RLCA
BCAA 07           	        RLCA
BCAB B2           	        OR D
BCAC 57           	        LD D,A
BCAD 7B           	        LD A,E
BCAE E6 20        	        AND 32
BCB0 B2           	        OR D
BCB1 57           	        LD D,A
                 	stream_record_scorpion:
BCB2 72           	        LD (HL),D
BCB3 23           	        INC HL
BCB4 3A 1F BE     	        LD A,(stream_address_high)
BCB7 77           	        LD (HL),A
BCB8 23           	        INC HL
BCB9 7B           	        LD A,E
BCBA E6 08        	        AND 8
BCBC 87           	        ADD A,A
BCBD 77           	        LD (HL),A
BCBE 23           	        INC HL
BCBF 22 27 BE     	        LD (stream_record_write),HL
                 	stream_sector_next:
BCC2 3E 18        	        LD A,24
BCC4 CD BA 80     	        CALL cache_restore
BCC7 2A 23 BE     	        LD HL,(stream_disk_sector)
BCCA 7D           	        LD A,L
BCCB E6 0F        	        AND 15
BCCD 5F           	        LD E,A
BCCE CB 3C        	        SRL H
BCD0 CB 1D        	        RR L
BCD2 CB 3C        	        SRL H
BCD4 CB 1D        	        RR L
BCD6 CB 3C        	        SRL H
BCD8 CB 1D        	        RR L
BCDA CB 3C        	        SRL H
BCDC CB 1D        	        RR L
BCDE 55           	        LD D,L
BCDF 21 C1 81     	        LD HL,stream_bounce
BCE2 01 05 01     	        LD BC,0x0105
BCE5 FB           	        EI
                 	stream_disk_call:
BCE6 CD 13 3D     	        CALL 0x3D13
BCE9 F3           	        DI
BCEA 3A 1D BE     	        LD A,(stream_physical)
BCED CD 8A 80     	        CALL cache_map
BCF0 21 C1 81     	        LD HL,stream_bounce
BCF3 ED 5B 29 BE  	        LD DE,(stream_destination)
BCF7 01 00 01     	        LD BC,256
BCFA ED B0        	        LDIR
BCFC ED 53 29 BE  	        LD (stream_destination),DE
BD00 2A 23 BE     	        LD HL,(stream_disk_sector)
BD03 23           	        INC HL
BD04 22 23 BE     	        LD (stream_disk_sector),HL
BD07 CD C2 BD     	        CALL cache_progress
BD0A 21 1E BE     	        LD HL,stream_sector_count
BD0D 35           	        DEC (HL)
BD0E 20 B2        	        JR NZ,stream_sector_next
BD10 21 1C BE     	        LD HL,stream_bank_index
BD13 34           	        INC (HL)
BD14 7E           	        LD A,(HL)
BD15 21 1B BE     	        LD HL,stream_bank_limit
BD18 BE           	        CP (HL)
BD19 30 08        	        JR NC,stream_chunk_loaded
BD1B 2A 25 BE     	        LD HL,(stream_remaining)
BD1E 7C           	        LD A,H
BD1F B5           	        OR L
BD20 C2 54 BC     	        JP NZ,stream_allocate
                 	stream_chunk_loaded:
BD23 2A 27 BE     	        LD HL,(stream_record_write)
BD26 36 00        	        LD (HL),0
BD28 3A 47 BE     	        LD A,(stream_records+1)
BD2B 67           	        LD H,A
BD2C 2E 00        	        LD L,0
BD2E 22 2B BE     	        LD (stream_first_address),HL
BD31 21 49 BE     	        LD HL,stream_records+3
BD34 22 2D BE     	        LD (stream_next_record),HL
BD37 3E 18        	        LD A,24
BD39 CD BA 80     	        CALL cache_restore
BD3C F3           	        DI
BD3D C9           	        RET
                 	
                 	; Ordinary bank2/5/shadow loads at cold boot; ROM owns register scratches.
                 	stream_read_n:
BD3E ED 53 21 BE  	        LD (stream_rom_position),DE
                 	stream_read_next:
BD42 C5           	        PUSH BC
BD43 E5           	        PUSH HL
BD44 ED 5B 21 BE  	        LD DE,(stream_rom_position)
BD48 01 05 01     	        LD BC,0x0105
BD4B FB           	        EI
BD4C CD 13 3D     	        CALL 0x3D13
BD4F F3           	        DI
BD50 E1           	        POP HL
BD51 C1           	        POP BC
BD52 24           	        INC H
BD53 ED 5B 21 BE  	        LD DE,(stream_rom_position)
BD57 1C           	        INC E
BD58 CB 63        	        BIT 4,E
BD5A 28 03        	        JR Z,stream_rom_sector_ok
BD5C 1E 00        	        LD E,0
BD5E 14           	        INC D
                 	stream_rom_sector_ok:
BD5F ED 53 21 BE  	        LD (stream_rom_position),DE
BD63 10 DD        	        DJNZ stream_read_next
BD65 C9           	        RET
                 	
                 	; Pentagon-only register-preserving pacing: JP10 +4 NOPs16 +old JP(IY)8,
                 	; ordinary delta26 T.128/Scorpion retain their original JP(IY), delta0.
                 	hardware_delay:
BD66 00           	        NOP
BD67 00           	        NOP
BD68 00           	        NOP
BD69 00           	        NOP
BD6A FD E9        	        JP (IY)
                 	stream_patch_first:
BD6C 3A 72 5B     	        LD A,(cache_mode)
BD6F FE 02        	        CP 2
BD71 D8           	        RET C
BD72 11 66 BD     	        LD DE,hardware_delay
BD75 21 67 83     	        LD HL,first_base+first_size-3
BD78 06 8A        	        LD B,first_patterns
                 	stream_patch_loop:
BD7A 36 C3        	        LD (HL),0xC3
BD7C 23           	        INC HL
BD7D 73           	        LD (HL),E
BD7E 23           	        INC HL
BD7F 72           	        LD (HL),D
BD80 7D           	        LD A,L
BD81 C6 28        	        ADD A,first_size-2
BD83 6F           	        LD L,A
BD84 30 01        	        JR NC,stream_patch_next
BD86 24           	        INC H
                 	stream_patch_next:
BD87 10 F1        	        DJNZ stream_patch_loop
BD89 C9           	        RET
                 	
                 	stream_finish:
BD8A F3           	        DI
BD8B 31 00 60     	        LD SP,0x6000
BD8E FD 21 3A 5C  	        LD IY,0x5C3A
BD92 AF           	        XOR A
BD93 D3 FE        	        OUT (0xFE),A
BD95 3E 1F        	        LD A,31
BD97 CD BA 80     	        CALL cache_restore
BD9A 21 39 BE     	        LD HL,stream_end_message
BD9D 11 80 D0     	        LD DE,0xD080           ; footer bitmap at y160,keep the title visible
                 	stream_print:
BDA0 7E           	        LD A,(HL)
BDA1 B7           	        OR A
BDA2 28 1A        	        JR Z,stream_finished
BDA4 23           	        INC HL
BDA5 E5           	        PUSH HL
BDA6 6F           	        LD L,A
BDA7 26 00        	        LD H,0
BDA9 29           	        ADD HL,HL
BDAA 29           	        ADD HL,HL
BDAB 29           	        ADD HL,HL
BDAC 01 00 3C     	        LD BC,0x3C00
BDAF 09           	        ADD HL,BC
BDB0 D5           	        PUSH DE
BDB1 06 08        	        LD B,8
                 	stream_glyph:
BDB3 7E           	        LD A,(HL)
BDB4 12           	        LD (DE),A
BDB5 23           	        INC HL
BDB6 14           	        INC D
BDB7 10 FA        	        DJNZ stream_glyph
BDB9 D1           	        POP DE
BDBA 1C           	        INC E
BDBB E1           	        POP HL
BDBC 18 E2        	        JR stream_print
                 	stream_finished:
BDBE FB           	        EI
BDBF 76           	        HALT
BDC0 18 FC        	        JR stream_finished
                 	
                 	
                 	; Loading-only exact sector progress. A short batch can publish several
                 	; cells per sector, so subtract repeatedly instead of assuming total>=32.
                 	; HL/DE/BC/AF scratch. No code here runs during live audio.
                 	cache_progress:
BDC2 3A 79 5B     	        LD A,(cache_progress_enabled)
BDC5 B7           	        OR A
BDC6 C8           	        RET Z
BDC7 2A 7A 5B     	        LD HL,(cache_fraction)
BDCA 11 20 00     	        LD DE,32
BDCD 19           	        ADD HL,DE
                 	cache_progress_compare:
BDCE ED 5B 7C 5B  	        LD DE,(cache_total)
BDD2 B7           	        OR A
BDD3 ED 52        	        SBC HL,DE
BDD5 38 15        	        JR C,cache_progress_remainder
BDD7 22 7A 5B     	        LD (cache_fraction),HL
BDDA 3A 78 5B     	        LD A,(cache_bar)
BDDD FE 20        	        CP 32
BDDF D0           	        RET NC
BDE0 3C           	        INC A
BDE1 32 78 5B     	        LD (cache_bar),A
                 	cache_progress_event:
BDE4 CD F1 BD     	        CALL cache_draw_bar
BDE7 2A 7A 5B     	        LD HL,(cache_fraction)
BDEA 18 E2        	        JR cache_progress_compare
                 	cache_progress_remainder:
BDEC 19           	        ADD HL,DE
BDED 22 7A 5B     	        LD (cache_fraction),HL
BDF0 C9           	        RET
                 	
                 	; Shadow screen is always bank7. Restore normal bank0 before enabling IRQs;
                 	; loader explicitly maps the next destination before each physical copy.
                 	cache_draw_bar:
BDF1 F3           	        DI
BDF2 3E 1F        	        LD A,31
BDF4 CD BA 80     	        CALL cache_restore
BDF7 21 C0 DA     	        LD HL,0xDAC0
BDFA 3A 78 5B     	        LD A,(cache_bar)
BDFD 5F           	        LD E,A
BDFE 06 20        	        LD B,32
                 	cache_draw_cell:
BE00 7B           	        LD A,E
BE01 B7           	        OR A
BE02 3E 04        	        LD A,4
BE04 28 03        	        JR Z,cache_draw_empty
BE06 1D           	        DEC E
BE07 3E 24        	        LD A,0x24
                 	cache_draw_empty:
BE09 77           	        LD (HL),A
BE0A 23           	        INC HL
BE0B 10 F3        	        DJNZ cache_draw_cell
BE0D 3E 18        	        LD A,24
BE0F CD BA 80     	        CALL cache_restore
BE12 FB           	        EI
BE13 C9           	        RET
BE14              	        INCLUDE "stream-progress.asm"
BE14 00           	cache_ref: DEFB 0
BE15 08           	cache_candidate: DEFB 8
BE16 00           	cache_limit: DEFB 0
BE17 00           	cache_ref_byte: DEFB 0
BE18 00           	cache_candidate_byte: DEFB 0
BE19 00           	cache_distinct: DEFB 0
BE1A 18           	cache_destination_page: DEFB 24
BE1B 06           	stream_bank_limit: DEFB 6
BE1C 00           	stream_bank_index: DEFB 0
BE1D 00           	stream_physical: DEFB 0
BE1E 00           	stream_sector_count: DEFB 0
BE1F 00           	stream_address_high: DEFB 0
BE20 18           	stream_paging: DEFB 24
BE21 00 00        	stream_rom_position: DEFW 0
BE23 00 00        	stream_disk_sector: DEFW 0
BE25 00 00        	stream_remaining: DEFW 0
BE27 00 00        	stream_record_write: DEFW 0
BE29 00 00        	stream_destination: DEFW 0
BE2B 00 00        	stream_first_address: DEFW 0
BE2D 00 00        	stream_next_record: DEFW 0
BE2F 00 00        	stream_tail_hl: DEFW 0
BE31 00 00        	stream_lookup_sp: DEFW 0
BE33 07           	stream_base_banks: DEFB 0,4,6,1,3,7
BE39 00           	stream_end_message: DEFM "END OF AUDIO",0
BE46              	stream_records: DEFS record_slots*3+1
BE4D              	        IF compact_stream_loader
BE4D              	        ELSE
BE4D              	stream_bounce: DEFS 256
BE4D              	        ENDIF
                 	stream_worker_end:
BE4D              	        INCLUDE "stream-worker.asm"
                 	player_end:
BE4D              	        ASSERT $ < 0xBFFF
BE4D              	        DS 0xBFFF-$
BFFF 00           	        DEFB 0
