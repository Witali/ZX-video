# Disk images belong in Git LFS, including uppercase file extensions.
*.[tT][rR][dD] filter=lfs diff=lfs merge=lfs -text
*.[sS][cC][lL] filter=lfs diff=lfs merge=lfs -text
*.[fF][dD][iI] filter=lfs diff=lfs merge=lfs -text
*.[uU][dD][iI] filter=lfs diff=lfs merge=lfs -text
*.[dD][sS][kK] filter=lfs diff=lfs merge=lfs -text
*.[iI][mM][gG] filter=lfs diff=lfs merge=lfs -text
